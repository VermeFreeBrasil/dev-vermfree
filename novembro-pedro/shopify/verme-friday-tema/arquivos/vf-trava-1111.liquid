{%- comment -%}
  vf-trava-1111 · Verme Friday (tarefa "Fechar o site com o banner do grupo VIP", ficha v3 do Vitor).
  Site fechado de 26/11 23h59 a 27/11 07h, com a tela da Black e o link do grupo VIP, sem sair do site.
  Abre 27/11 00h para quem chega com ?acesso=vip (link enviado no grupo) e 27/11 07h para todos.
  Equipe: ?vf_trava=off libera na sessão · prévia da tela: ?vf_fechado=on (?vf_fechado=off desliga).
  Robôs de busca e o editor do tema não são bloqueados. O nome do arquivo continua o do 11/11 porque o vf-ds o carrega.
{%- endcomment -%}
{%- assign vip_link = 'LINK-DO-GRUPO-VIP-BLACK' -%}
{%- unless request.design_mode -%}
<script>
(function () {
  try {
    var q = new URLSearchParams(location.search), agora = Date.now();
    var fecha = Date.parse('2026-11-26T23:59:00-03:00'), abreVip = Date.parse('2026-11-27T00:00:00-03:00'), abreTodos = Date.parse('2026-11-27T07:00:00-03:00');
    var ss = function (k, v) { try { if (v === 0) sessionStorage.removeItem(k); else if (v) sessionStorage.setItem(k, v); return sessionStorage.getItem(k); } catch (e) { return null; } };
    if (q.get('vf_fechado') === 'on') ss('vf_fechado', '1');
    if (q.get('vf_fechado') === 'off') ss('vf_fechado', 0);
    var prev = ss('vf_fechado') === '1';
    if (prev) { if (q.get('vf_hora')) agora = Date.parse('2026-11-27T' + q.get('vf_hora') + ':00-03:00'); else if (agora < fecha || agora >= abreTodos) agora = abreVip - 60e3; }
    if (agora >= abreTodos || agora < fecha) return;
    if (/bot|crawl|spider|slurp|Google-InspectionTool|Lighthouse|facebookexternalhit/i.test(navigator.userAgent || '')) return;
    if (q.get('vf_trava') === 'off') ss('vf_trava_off', '1');
    if (ss('vf_trava_off') === '1' && !prev) return;
    if (q.get('acesso') === 'vip') { ss('vf_vip', '1'); document.cookie = 'vf_vip=1;path=/;max-age=86400'; }
    var vip = ss('vf_vip') === '1' || document.cookie.indexOf('vf_vip=1') > -1;
    if (agora >= abreVip && vip && !prev) return;
    var H = document.documentElement; H.classList.add('vf-fechado');
    var st = document.createElement('style');
    st.textContent = 'html.vf-fechado,html.vf-fechado body{background:#050505!important;overflow:hidden!important;height:100%}html.vf-fechado body{visibility:hidden}'
      + '#vf-fc{visibility:visible;position:fixed;inset:0;z-index:2147483647;overflow:auto;background:radial-gradient(ellipse 80% 55% at 50% 0,#3a0a0e 0,#050505 70%);color:#fff;font-family:Inter,Arial,sans-serif;display:flex;align-items:center;justify-content:center;padding:28px 16px;box-sizing:border-box;text-align:center}'
      + '#vf-fc *{box-sizing:border-box}#vf-fc .w{max-width:560px;width:100%}'
      + '#vf-fc .tg{display:inline-block;background:#e0262f;color:#fff;font-weight:900;font-size:12.5px;letter-spacing:.14em;text-transform:uppercase;padding:8px 16px;border-radius:40px}'
      + '#vf-fc h1{font-family:Caprasimo,Georgia,serif;font-weight:400;font-size:clamp(40px,10vw,68px);line-height:1;letter-spacing:-.03em;margin:22px 0 0;color:#fff}#vf-fc h1 em{font-style:normal;color:#ff3a43}'
      + '#vf-fc .st{margin:18px auto 0;font-size:17px;line-height:1.5;color:#e9e9e9;max-width:44ch}#vf-fc .st b{color:#fff}'
      + '#vf-fc .ct{margin:24px auto 0;display:flex;justify-content:center;gap:10px}#vf-fc .ct div{min-width:76px;padding:12px 8px;border-radius:14px;background:#ffffff0f;border:1px solid #ffffff1f}#vf-fc .ct b{display:block;font-size:30px;font-weight:900;font-variant-numeric:tabular-nums}#vf-fc .ct small{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#bdbdbd}'
      + '#vf-fc ul{list-style:none;margin:26px auto 0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:8px;max-width:460px}#vf-fc li{padding:11px 8px;border-radius:12px;background:#ffffff0a;border:1px solid #ffffff17;font-size:13.5px;font-weight:700;line-height:1.3}#vf-fc li b{display:block;color:#ff4a52;font-size:16px}'
      + '#vf-fc .bt{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;max-width:460px;margin:28px auto 0;min-height:62px;padding:16px 24px;border-radius:60px;background:linear-gradient(180deg,#ff3a43,#9e0f17);color:#fff;font-weight:900;font-size:18px;text-decoration:none;box-shadow:0 0 0 6px #e0262f22,0 18px 40px #e0262f55;animation:vfP 2.2s ease-in-out infinite}'
      + '@keyframes vfP{50%{transform:scale(1.03)}}@media(prefers-reduced-motion:reduce){#vf-fc .bt{animation:none}}'
      + '#vf-fc .ft{margin:16px 0 0;font-size:13px;color:#a8a8a8;line-height:1.5}';
    (document.head || H).appendChild(st);
    var fase = agora < abreVip ? 0 : 1, alvo = fase ? abreTodos : abreVip;
    var html = '<div class="w"><span class="tg">Verme Friday · 27 e 28/11</span>'
      + (fase ? '<h1>O grupo VIP <em>já está comprando.</em></h1><p class="st">O site abre para todos às <b>07h</b>. Quem está no grupo VIP compra desde a meia-noite e sai na frente para os <b>300 primeiros pedidos</b>, que concorrem a um kit VermeFree.</p>'
              : '<h1>O maior desconto do ano <em>abre à meia-noite.</em></h1><p class="st">Só para o <b>grupo VIP</b>. Para todos, o site abre às <b>07h</b>. Quem entra antes sai na frente para os <b>300 primeiros pedidos</b>, que concorrem a um kit VermeFree.</p>')
      + '<div class="ct" data-c><div><b>--</b><small>horas</small></div><div><b>--</b><small>min</small></div><div><b>--</b><small>seg</small></div></div>'
      + '<ul><li><b>18% OFF</b>em todo o site</li><li><b>Compre 4</b>leve 5</li><li><b>Frete grátis</b>sem mínimo</li><li><b>Guia + manual</b>digitais</li></ul>'
      + '<a class="bt" href="{{ vip_link }}" target="_blank" rel="noopener">Entrar no grupo VIP →</a>'
      + '<p class="ft">Já está no grupo? Use o link de acesso que chega lá ' + (fase ? 'para comprar agora.' : 'à meia-noite.') + '</p></div>';
    var poe = function () {
      if (document.getElementById('vf-fc') || !document.body) return;
      var d = document.createElement('div'); d.id = 'vf-fc'; d.setAttribute('role', 'dialog'); d.setAttribute('aria-label', 'Verme Friday'); d.innerHTML = html; document.body.appendChild(d);
      var bs = d.querySelectorAll('[data-c] b'), p = function (n) { return (n < 10 ? '0' : '') + n; }, t0 = Date.now(), base = agora;
      var tk = function () { var s = Math.max(0, Math.floor((alvo - (base + Date.now() - t0)) / 1000)); bs[0].textContent = p(Math.floor(s / 3600)); bs[1].textContent = p(Math.floor(s % 3600 / 60)); bs[2].textContent = p(s % 60); if (s === 0 && !prev) location.reload(); };
      tk(); setInterval(tk, 1000);
    };
    if (document.body) poe(); else document.addEventListener('DOMContentLoaded', poe);
  } catch (e) {}
})();
</script>
{%- endunless -%}
