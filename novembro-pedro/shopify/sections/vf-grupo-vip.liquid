{%- comment -%}
  vf-grupo-vip — LP de captura do Grupo VIP · 11/11 VermeFree (/pages/grupo-vip).
  Mesmo padrão da LP da Revita aprovada pelo Pedro: fundo claro, faixa vermelha,
  título com destaque vermelho, contagem em blocos, botão vermelho, foto em arco,
  oferta secreta + dentro x fora, carrossel de clientes e chamada final.
  Carrossel: 4 vídeos de clientes (metaobjeto vf_depoimento) intercalados com 4 prints de stories.
  Sem médico como aval e sem cupom (regras de novembro). Foto: produtos da home (vf-hero-pedestal).
{%- endcomment -%}
{%- assign link = section.settings.link_grupo | default: '#' -%}
{%- capture wa -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 11.5a9 9 0 0 1-13.5 7.8L3 21l1.7-4.5A9 9 0 1 1 21 11.5Z"/><path d="m8 7 2 3-1 1c1 2 2 3 4 4l1-1 3 1c0 2-2 3-4 2-4-1-7-5-7-7 0-2 1-3 2-3Z"/></svg>{%- endcapture -%}
{%- assign depos = '04,05,06,07' | split: ',' -%}
{%- assign vids = 'daniela-3-perguntas,jessika-abre-kit-adulto,juliana-kids-embalagem,ester-kids-2-4' | split: ',' -%}

<div class="vv">
  <p class="vv-top"><span></span>Acesso antecipado · abre 11/11 à 00h</p>

  <header class="vv-head">
    {%- if section.settings.logo != blank -%}
      {{ section.settings.logo | image_url: width: 300 | image_tag: class: 'vv-logo', alt: 'VermeFree' }}
    {%- endif -%}
  </header>

  <section class="vv-wrap vv-hero">
    <div class="vv-copy">
      <p class="vv-badge">🔥 11.11 · só 24 horas</p>
      <h1>O maior desconto da história da VermeFree <em>vai abrir primeiro no grupo.</em></h1>
      <p class="vv-sub">A oferta fica em segredo até a meia-noite. Quem está no Grupo VIP recebe o link à 00h e sai na frente dos <strong>100 primeiros pedidos</strong>, que ganham cashback, e dos <strong>300 primeiros</strong>, que concorrem a um kit.</p>

      <div class="vv-timer" data-vv-timer aria-label="Contagem regressiva para o 11/11">
        <div><b data-d>--</b><small>dias</small></div>
        <div><b data-h>--</b><small>horas</small></div>
        <div><b data-m>--</b><small>min</small></div>
        <div class="is-s"><b data-s>--</b><small>seg</small></div>
      </div>
      <p class="vv-timer__l">para a oferta ser revelada no grupo</p>

      <a class="vv-btn" href="{{ link }}" data-vv-cta target="_blank" rel="noopener">{{ wa }}Quero entrar no Grupo VIP</a>
      <p class="vv-checks"><span>Gratuito</span><span>Só avisos</span><span>Sai quando quiser</span></p>
    </div>

    <figure class="vv-photo">
      {%- if section.settings.foto != blank -%}
        {{ section.settings.foto | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', alt: 'Protocolos VermeFree Adulto e Kids' }}
      {%- endif -%}
      <figcaption>Protocolos Adulto, Kids e Kit Família com a <strong>maior condição do ano</strong>, só no dia 11.</figcaption>
    </figure>
  </section>

  <section class="vv-wrap vv-mid">
    <div class="vv-secret">
      <p class="vv-secret__k">Oferta secreta</p>
      <p class="vv-secret__t">Nem a gente pode contar ainda.</p>
      <span class="vv-blur vv-blur--1"></span>
      <span class="vv-blur vv-blur--2"></span>
      <span class="vv-blur vv-blur--3"></span>
      <p class="vv-secret__f"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>Revelada só no grupo, à 00h de 11/11</p>
    </div>
    <div class="vv-sides">
      <div class="vv-side vv-side--out">
        <p class="vv-side__h">Quem fica de fora</p>
        <ul>
          <li>Descobre a oferta só às 7h, quando o grupo já comprou</li>
          <li>Disputa o que sobrar dos 100 cashbacks</li>
          <li>Perde a maior condição do ano, que dura só 24 horas</li>
        </ul>
      </div>
      <div class="vv-side vv-side--in">
        <p class="vv-side__h">Quem está no Grupo VIP</p>
        <ul>
          <li>Recebe o link à 00h, antes de todo mundo</li>
          <li>Sai na frente para estar entre os 100 e os 300 primeiros</li>
          <li>É avisado da última chance das 20h</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="vv-ugc">
    <p class="vv-ugc__k">Quem já usa</p>
    <h2>Famílias que já fizeram o protocolo. No 11/11 é a sua vez.</h2>
    <div class="vv-rail" data-vv-rail>
      {%- for i in (0..3) -%}
        {%- assign dep = shop.metaobjects.vf_depoimento[vids[i]] -%}
        {%- assign v = dep.video.value -%}
        {%- if v -%}
          {%- assign src = '' -%}
          {%- for s in v.sources -%}{%- if src == '' and s.mime_type == 'video/mp4' -%}{%- assign src = s.url -%}{%- endif -%}{%- endfor -%}
          <figure class="is-v" data-vv-video>
            <video src="{{ src }}" poster="{{ v.preview_image | image_url: width: 400 }}" muted loop playsinline preload="none"></video>
            <span class="vv-snd" aria-hidden="true">🔇</span>
            <figcaption>{{ dep.nome.value }}</figcaption>
          </figure>
        {%- endif -%}
        {%- assign f = 'vf-depoimento-' | append: depos[i] | append: '.jpg' -%}
        <figure><img src="{{ f | asset_img_url: '500x' }}" alt="Cliente VermeFree mostrando o protocolo" width="500" height="889" loading="lazy"></figure>
      {%- endfor -%}
    </div>
    <p class="vv-final">Não deixe para depois. <em>O 11/11 não se repete.</em></p>
    <a class="vv-btn vv-btn--c" href="{{ link }}" data-vv-cta target="_blank" rel="noopener">{{ wa }}Quero entrar no Grupo VIP</a>
    <p class="vv-aviso" data-vv-aviso hidden>A loja está fechada para o 11/11 e reabre para todos dia 11 às 7h.</p>
    <p class="vv-foot">VermeFree · O cuidado começa por dentro</p>
  </section>
</div>

<style>
  html,body{background:#fff}
  .vv{--ink:#173e2d;--red:#d7262f;--red2:#b5121b;--muted:#5f6b64;--beige:#f5f2ea;--sans:Inter,Arial,sans-serif;
    background:#fff;color:var(--ink);font-family:var(--sans);-webkit-text-size-adjust:100%}
  .vv *{box-sizing:border-box}
  .vv [hidden]{display:none!important}
  .vv h1,.vv h2,.vv p,.vv ul{margin:0;padding:0}
  .vv ul{list-style:none}
  .vv a{text-decoration:none}
  .vv svg{width:20px;height:20px;flex-shrink:0;stroke-linecap:round;stroke-linejoin:round}
  .vv-wrap{width:min(1020px,calc(100% - 40px));margin:0 auto}

  .vv-top{display:flex;align-items:center;justify-content:center;gap:10px;background:var(--red);color:#fff;font-size:12px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;padding:10px 14px;text-align:center}
  .vv-top span{width:7px;height:7px;border-radius:50%;background:#fff;animation:vvp 1.2s infinite}
  @keyframes vvp{50%{opacity:.25}}
  .vv-head{display:flex;justify-content:center;padding:18px 0 6px}
  .vv-logo{width:120px;height:auto}

  .vv-hero{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center;padding:18px 0 36px}
  .vv-badge{display:inline-block;border:1px solid #f6c9cb;background:#fdeceb;color:var(--red);font-size:12px;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;padding:6px 12px;border-radius:40px;margin-bottom:16px}
  .vv h1{font-size:clamp(34px,4.3vw,52px);line-height:1.08;font-weight:800;letter-spacing:-.035em}
  .vv h1 em{font-style:normal;color:var(--red)}
  .vv-sub{font-size:16px;line-height:1.6;color:var(--muted);margin:18px 0 22px;max-width:470px}
  .vv-sub strong{color:var(--ink)}
  .vv-timer{display:flex;gap:10px}
  .vv-timer div{width:96px;background:var(--ink);color:#fff;border-radius:12px;text-align:center;padding:10px 0 8px;box-shadow:0 8px 18px #173e2d33}
  .vv-timer div.is-s{background:var(--red);box-shadow:0 8px 18px #d7262f40}
  .vv-timer b{display:block;font-size:30px;font-weight:700;line-height:1.1;font-variant-numeric:tabular-nums}
  .vv-timer small{font-size:10px;letter-spacing:1.4px;text-transform:uppercase;opacity:.75}
  .vv-timer__l{font-size:12px;color:var(--muted);margin:6px 0 18px}
  .vv-btn{display:flex;align-items:center;justify-content:center;gap:10px;max-width:420px;min-height:58px;border-radius:40px;background:linear-gradient(180deg,#e2333b,var(--red2));color:#fff;font-size:16px;font-weight:800;box-shadow:0 12px 26px #d7262f4d;transition:transform .2s}
  .vv-btn:hover{transform:translateY(-2px)}
  .vv-btn--c{margin:18px auto 0;width:calc(100% - 40px)}
  .vv-checks{display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:12px;font-size:12px;color:var(--muted)}
  .vv-checks span::before{content:'✓ ';color:#2f9e44;font-weight:800}

  .vv-photo{position:relative;margin:0;border-radius:220px 220px 22px 22px;overflow:hidden;aspect-ratio:4/4.4;background:radial-gradient(ellipse 80% 60% at 50% 55%,#f3f8ee 0,#dcebd2 60%,#c7dfba 100%)}
  .vv-photo img{position:absolute;left:4%;right:4%;top:12%;width:92%;height:70%;object-fit:contain;filter:drop-shadow(0 18px 22px #173e2d40)}
  .vv-photo figcaption{position:absolute;left:12px;right:12px;bottom:12px;background:#fffffff2;border-radius:10px;padding:10px 12px;font-size:12px;line-height:1.45;color:var(--ink)}
  .vv-photo figcaption strong{color:var(--red)}

  .vv-mid{display:grid;grid-template-columns:1fr 1fr;gap:20px;padding-bottom:36px}
  .vv-secret{background:radial-gradient(ellipse at 50% 0,#245a40 0,transparent 70%),var(--ink);color:#fff;border-radius:18px;padding:36px 28px;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px}
  .vv-secret__k{font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#ff8a80}
  .vv-secret__t{font-size:20px;font-weight:600}
  .vv-blur{display:block;height:20px;border-radius:20px;background:linear-gradient(90deg,#8fbf7a,#e0b86a,#8fbf7a);filter:blur(7px);opacity:.75}
  .vv-blur--1{width:66%;height:26px}.vv-blur--2{width:84%}.vv-blur--3{width:52%}
  .vv-secret__f{display:flex;align-items:center;gap:8px;font-size:13px;opacity:.9;margin-top:6px}
  .vv-secret__f svg{width:15px;height:15px}
  .vv-sides{display:grid;gap:12px}
  .vv-side{border-radius:16px;padding:16px 18px}
  .vv-side__h{font-size:14px;font-weight:800;margin-bottom:8px}
  .vv-side li{position:relative;padding:4px 0 4px 20px;font-size:14px;line-height:1.45}
  .vv-side--out{background:#fdeeee;border:1px solid #f6c9cb}
  .vv-side--out .vv-side__h,.vv-side--out li::before{color:var(--red)}
  .vv-side--out li::before{content:'✕';position:absolute;left:0;font-weight:900}
  .vv-side--in{background:#eef7ec;border:1px solid #cde6c6}
  .vv-side--in .vv-side__h,.vv-side--in li::before{color:#2f7d32}
  .vv-side--in li::before{content:'✓';position:absolute;left:0;font-weight:900}

  .vv-ugc{background:var(--beige);padding:44px 0 40px;text-align:center}
  .vv-ugc__k{font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#8a6d2b}
  .vv-ugc h2{font-size:clamp(20px,2.2vw,26px);font-weight:600;letter-spacing:-.02em;margin:8px auto 20px;max-width:640px;padding:0 20px}
  .vv-rail{display:flex;gap:10px;overflow-x:auto;scroll-snap-type:x mandatory;padding:0 max(20px,calc((100% - 1080px)/2)) 6px;scrollbar-width:none;justify-content:safe center}
  .vv-rail::-webkit-scrollbar{display:none}
  .vv-rail figure{flex:0 0 172px;margin:0;border-radius:14px;overflow:hidden;scroll-snap-align:center;aspect-ratio:9/16;background:#e6e1d6}
  .vv-rail img,.vv-rail video{width:100%;height:100%;object-fit:cover;display:block}
  .vv-rail figure{position:relative}
  .vv-rail .is-v{cursor:pointer;box-shadow:0 0 0 3px var(--red)}
  .vv-rail .is-v figcaption{position:absolute;left:8px;bottom:8px;background:#000a;color:#fff;font-size:11px;font-weight:700;padding:3px 8px;border-radius:20px}
  .vv-snd{position:absolute;top:8px;right:8px;width:26px;height:26px;border-radius:50%;background:#000a;display:grid;place-items:center;font-size:12px}
  .vv-final{font-size:clamp(20px,2.2vw,24px);font-weight:600;margin-top:28px;padding:0 20px}
  .vv-final em{font-style:normal;color:var(--red)}
  .vv-aviso{font-size:12px;color:var(--muted);margin-top:10px}
  .vv-foot{font-size:12px;color:var(--muted);margin-top:18px}

  @media(max-width:860px){
    .vv-head{padding:14px 0 0}
    .vv-logo{width:104px}
    .vv-hero{display:flex;flex-direction:column;gap:22px;padding:14px 0 24px}
    .vv-copy{text-align:center}
    .vv-badge{margin-bottom:12px}
    .vv h1{font-size:31px}
    .vv-sub{font-size:15px;margin:12px auto 16px}
    .vv-timer{justify-content:center;gap:8px}
    .vv-timer div{flex:1;max-width:80px}
    .vv-timer b{font-size:26px}
    .vv-btn{margin:0 auto}
    .vv-checks{justify-content:center}
    .vv-photo{width:100%;max-width:420px;margin:0 auto;aspect-ratio:1/1;border-radius:180px 180px 20px 20px}
    .vv-photo img{top:10%;height:66%}
    .vv-mid{grid-template-columns:1fr}
    .vv-secret{padding:28px 20px}
    .vv-rail figure{flex-basis:150px}
  }
  @media(prefers-reduced-motion:reduce){.vv *{animation:none!important;transition:none!important}}
</style>

<script>
  (function () {
    var alvo = new Date('{{ section.settings.data_alvo | default: "2026-11-11T00:00:00-03:00" }}').getTime();
    var t = document.querySelector('[data-vv-timer]');
    var pad = function (n) { return (n < 10 ? '0' : '') + n; };
    var tick = function () {
      var s = Math.floor(Math.max(0, alvo - Date.now()) / 1000);
      t.querySelector('[data-d]').textContent = pad(Math.floor(s / 86400));
      t.querySelector('[data-h]').textContent = pad(Math.floor(s % 86400 / 3600));
      t.querySelector('[data-m]').textContent = pad(Math.floor(s % 3600 / 60));
      t.querySelector('[data-s]').textContent = pad(s % 60);
    };
    if (t) { tick(); setInterval(tick, 1000); }
    if (window.vfTravaAtiva) {
      var a = document.querySelector('[data-vv-aviso]');
      if (a) a.hidden = false;
    }
    var vs = document.querySelectorAll('[data-vv-video]');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) { var v = e.target.querySelector('video'); if (e.isIntersecting) { v.play().catch(function () {}); } else { v.pause(); } });
      }, { threshold: 0.6 });
      vs.forEach(function (f) { io.observe(f); });
    }
    vs.forEach(function (f) {
      f.addEventListener('click', function () {
        var v = f.querySelector('video'), on = v.muted;
        vs.forEach(function (o) { o.querySelector('video').muted = true; o.querySelector('.vv-snd').textContent = '🔇'; });
        v.muted = !on; f.querySelector('.vv-snd').textContent = on ? '🔊' : '🔇';
        if (on) { v.play().catch(function () {}); }
      });
    });
    var rail = document.querySelector('[data-vv-rail]');
    if (rail && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var parado = false;
      ['pointerdown', 'touchstart', 'wheel', 'click'].forEach(function (ev) { rail.addEventListener(ev, function () { parado = true; }, { passive: true }); });
      setInterval(function () {
        if (parado || rail.scrollWidth <= rail.clientWidth) return;
        var fim = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 4;
        rail.scrollTo({ left: fim ? 0 : rail.scrollLeft + 182, behavior: 'smooth' });
      }, 2600);
    }
    document.querySelectorAll('[data-vv-cta]').forEach(function (el) {
      el.addEventListener('click', function () {
        try { if (window.fbq) window.fbq('track', 'Lead', { content_name: 'Grupo VIP 11/11' }); } catch (e) {}
        try { if (window.gtag) window.gtag('event', 'generate_lead', { event_label: 'grupo_vip_1111', transport_type: 'beacon' }); } catch (e) {}
        try { if (window.Shopify && Shopify.analytics && Shopify.analytics.publish) Shopify.analytics.publish('vf_grupo_vip_click', { campanha: '11/11' }); } catch (e) {}
      });
    });
  })();
</script>

{% schema %}
{
  "name": "VF Grupo VIP 11/11",
  "settings": [
    { "type": "url", "id": "link_grupo", "label": "Link do grupo VIP (rastreado, da Sarah)" },
    { "type": "text", "id": "data_alvo", "label": "Contagem até (ISO)", "default": "2026-11-11T00:00:00-03:00" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "image_picker", "id": "foto", "label": "Foto em arco" }
  ],
  "presets": [{ "name": "VF Grupo VIP 11/11" }]
}
{% endschema %}
