{%- comment -%}
  vf-grupo-vip — LP de captura (squeeze) do Grupo VIP do 11/11 (/pages/grupo-vip).
  Uma tela só: foto real do site, título, botão e contagem. Fundo claro, verde da marca.
  Não abre a oferta. Clique: Lead (Meta, se houver fbq), generate_lead (Google)
  e vf_grupo_vip_click (pixels personalizados).
{%- endcomment -%}
{%- assign link = section.settings.link_grupo | default: '#' -%}
<main class="sq">
  <figure class="sq-photo">
    {%- if section.settings.foto != blank -%}
      {{ section.settings.foto | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', alt: 'Família VermeFree' }}
    {%- else -%}
      <img src="{{ 'lp-familia-sofa.jpg' | asset_img_url: '1400x' }}" alt="Família VermeFree" width="1400" height="1400" fetchpriority="high">
    {%- endif -%}
  </figure>

  <section class="sq-box">
    {%- if section.settings.logo != blank -%}
      {{ section.settings.logo | image_url: width: 300 | image_tag: class: 'sq-logo', alt: 'VermeFree' }}
    {%- endif -%}
    <p class="sq-eyebrow">Grupo VIP · 11/11</p>
    <h1>O maior dia do ano chega <em>primeiro no Grupo VIP</em></h1>
    <p class="sq-sub">No dia 11/11, quem está no grupo recebe o acesso à oferta <strong>à 00h</strong>, 7 horas antes de todo mundo.</p>

    <a class="sq-btn" href="{{ link }}" data-sq-cta target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 11.5a9 9 0 0 1-13.5 7.8L3 21l1.7-4.5A9 9 0 1 1 21 11.5Z"/><path d="m8 7 2 3-1 1c1 2 2 3 4 4l1-1 3 1c0 2-2 3-4 2-4-1-7-5-7-7 0-2 1-3 2-3Z"/></svg>
      Quero entrar no Grupo VIP
    </a>
    <p class="sq-micro">Grátis · Sem spam · Sai quando quiser</p>

    <div class="sq-timer" data-sq-timer aria-label="Contagem regressiva para o 11/11">
      <span>Abre no grupo em</span>
      <b data-d>--</b><small>d</small><b data-h>--</b><small>h</small><b data-m>--</b><small>min</small><b data-s>--</b><small>s</small>
    </div>
    <p class="sq-aviso" data-sq-aviso hidden>A loja reabre para todos dia 11/11 às 7h.</p>
  </section>
</main>

<style>
  html,body{background:#fff}
  .sq{--green:#5ebc43;--green-d:#3f9a2b;--dark:#1b5e20;--ink:#1a1a1a;--muted:#5b6560;--cream:#f7f8f3;
    min-height:100svh;display:grid;grid-template-columns:1fr 1fr;background:#fff;color:var(--ink);font-family:Inter,Arial,sans-serif}
  .sq *{box-sizing:border-box}
  .sq [hidden]{display:none!important}
  .sq h1,.sq p{margin:0}
  .sq-photo{margin:0;position:relative;min-height:100svh}
  .sq-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .sq-box{display:flex;flex-direction:column;justify-content:center;padding:48px clamp(32px,6vw,96px);max-width:640px}
  .sq-logo{width:150px;height:auto;margin-bottom:40px}
  .sq-eyebrow{display:inline-block;align-self:flex-start;background:#eaf6e4;color:var(--dark);font-size:12px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;padding:6px 12px;border-radius:40px;margin-bottom:16px}
  .sq h1{font-family:Caprasimo,Georgia,serif;font-weight:400;font-size:clamp(34px,3.6vw,52px);line-height:1.08;letter-spacing:-.02em}
  .sq h1 em{font-style:normal;color:var(--green-d)}
  .sq-sub{font-size:17px;line-height:1.55;color:var(--muted);margin:16px 0 26px}
  .sq-sub strong{color:var(--ink)}
  .sq-btn{display:flex;align-items:center;justify-content:center;gap:10px;min-height:58px;border-radius:14px;background:var(--green);color:#fff;font-size:17px;font-weight:700;text-decoration:none;box-shadow:0 8px 22px #5ebc4359;transition:background .2s,transform .2s}
  .sq-btn:hover{background:var(--green-d);transform:translateY(-1px)}
  .sq-btn svg{width:22px;height:22px}
  .sq-micro{text-align:center;font-size:13px;color:var(--muted);margin-top:10px}
  .sq-timer{display:flex;align-items:baseline;justify-content:center;gap:3px;margin-top:22px;padding:12px;border-radius:12px;background:var(--cream);font-size:13px;color:var(--muted)}
  .sq-timer span{margin-right:8px}
  .sq-timer b{font-size:20px;color:var(--dark);font-variant-numeric:tabular-nums}
  .sq-timer small{margin-right:8px}
  .sq-aviso{text-align:center;font-size:12px;color:var(--muted);margin-top:10px}
  @media(max-width:820px){
    .sq{display:flex;flex-direction:column;min-height:100svh}
    .sq-photo{min-height:0;height:40svh;max-height:none;flex-shrink:0}
    .sq-photo img{object-position:50% 62%}
    .sq-box{padding:16px 20px 18px;max-width:none;justify-content:flex-start;flex:1}
    .sq-logo{width:112px;margin:0 auto 14px}
    .sq-eyebrow{align-self:center;font-size:11px;margin-bottom:10px}
    .sq h1{font-size:29px;text-align:center}
    .sq-sub{font-size:15px;text-align:center;margin:10px 0 16px}
    .sq-timer{margin-top:14px;padding:10px}
    .sq-timer b{font-size:18px}
  }
  @media(max-width:820px) and (max-height:700px){
    .sq-photo{height:32svh}
    .sq h1{font-size:26px}
    .sq-logo{margin-bottom:10px}
  }
</style>

<script>
  (function () {
    var t = document.querySelector('[data-sq-timer]');
    if (t) {
      var alvo = new Date('{{ section.settings.data_alvo | default: "2026-11-11T00:00:00-03:00" }}').getTime();
      var pad = function (n) { return (n < 10 ? '0' : '') + n; };
      var tick = function () {
        var s = Math.floor(Math.max(0, alvo - Date.now()) / 1000);
        t.querySelector('[data-d]').textContent = pad(Math.floor(s / 86400));
        t.querySelector('[data-h]').textContent = pad(Math.floor(s % 86400 / 3600));
        t.querySelector('[data-m]').textContent = pad(Math.floor(s % 3600 / 60));
        t.querySelector('[data-s]').textContent = pad(s % 60);
      };
      tick(); setInterval(tick, 1000);
    }
    if (window.vfTravaAtiva) {
      var a = document.querySelector('[data-sq-aviso]');
      if (a) a.hidden = false;
    }
    document.querySelectorAll('[data-sq-cta]').forEach(function (el) {
      el.addEventListener('click', function () {
        try { if (window.fbq) window.fbq('track', 'Lead', { content_name: 'Grupo VIP 11/11' }); } catch (e) {}
        try { if (window.gtag) window.gtag('event', 'generate_lead', { event_label: 'grupo_vip_1111', transport_type: 'beacon' }); } catch (e) {}
        try { if (window.Shopify && Shopify.analytics && Shopify.analytics.publish) Shopify.analytics.publish('vf_grupo_vip_click', { campanha: '11/11' }); } catch (e) {}
      });
    });
  })();
</script>

{% schema %}
{
  "name": "VF Grupo VIP 11/11",
  "settings": [
    { "type": "url", "id": "link_grupo", "label": "Link do grupo VIP (rastreado, da Sarah)" },
    { "type": "text", "id": "data_alvo", "label": "Contagem até (ISO)", "default": "2026-11-11T00:00:00-03:00" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "image_picker", "id": "foto", "label": "Foto" }
  ],
  "presets": [{ "name": "VF Grupo VIP 11/11" }]
}
{% endschema %}
