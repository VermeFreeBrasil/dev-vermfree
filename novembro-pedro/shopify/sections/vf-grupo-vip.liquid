{%- comment -%}
  vf-grupo-vip — LP de captura do Grupo VIP do 11/11 (/pages/grupo-vip).
  Paleta e fontes da LP social (floresta, lima, creme · Caprasimo + Inter),
  estrutura própria de captura: hero com CTA, como funciona, dentro x fora,
  bloco família, dúvidas, CTA final e barra fixa no celular. Não abre a oferta.
  Clique: Lead (Meta, se houver fbq), generate_lead (Google) e vf_grupo_vip_click.
{%- endcomment -%}
{%- assign link = section.settings.link_grupo | default: '#' -%}
{%- capture wa -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M21 11.5a9 9 0 0 1-13.5 7.8L3 21l1.7-4.5A9 9 0 1 1 21 11.5Z"/><path d="m8 7 2 3-1 1c1 2 2 3 4 4l1-1 3 1c0 2-2 3-4 2-4-1-7-5-7-7 0-2 1-3 2-3Z"/></svg>{%- endcapture -%}
{%- capture ok -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 5 5 9-10"/></svg>{%- endcapture -%}
{%- capture no -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 12h10"/></svg>{%- endcapture -%}

<div class="cp">
  <div class="cp-bar">Grupo VIP do 11/11 · entrada grátis até 10/11</div>

  {%- comment -%} HERO {%- endcomment -%}
  <header class="cp-hero">
    <div class="cp-hero__bg">
      {%- if section.settings.foto_hero != blank -%}
        {{ section.settings.foto_hero | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', alt: '' }}
      {%- else -%}
        <img src="{{ 'gv-opcao-2.png' | asset_img_url: '2000x' }}" alt="" width="2000" height="1125" fetchpriority="high">
      {%- endif -%}
    </div>
    <div class="cp-wrap cp-hero__in">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 360 | image_tag: class: 'cp-logo', alt: 'VermeFree' }}
      {%- endif -%}
      <p class="cp-eyebrow">Grupo VIP VermeFree · 11/11</p>
      <h1>11/11 VermeFree: o maior dia do ano chega <span>primeiro no Grupo VIP.</span></h1>
      <p class="cp-lede">Quem está no grupo recebe o acesso à oferta <strong>à 00h do dia 11/11</strong>, 7 horas antes de abrir para todo mundo.</p>
      <a class="cp-btn" href="{{ link }}" data-cp-cta target="_blank" rel="noopener">{{ wa }}<span>Quero entrar no Grupo VIP</span></a>
      <ul class="cp-micro"><li>{{ ok }}Grátis</li><li>{{ ok }}Sem spam</li><li>{{ ok }}Sai quando quiser</li></ul>
      <div class="cp-timer" data-cp-timer aria-label="Contagem regressiva para o 11/11">
        <span class="cp-timer__l">Abre no grupo em</span>
        <div><b data-d>--</b><small>dias</small></div><i>:</i>
        <div><b data-h>--</b><small>horas</small></div><i>:</i>
        <div><b data-m>--</b><small>min</small></div><i>:</i>
        <div><b data-s>--</b><small>seg</small></div>
      </div>
    </div>
  </header>

  {%- comment -%} COMO FUNCIONA {%- endcomment -%}
  <section class="cp-sec cp-cream">
    <div class="cp-wrap">
      <p class="cp-eyebrow cp-eyebrow--leaf">Como funciona</p>
      <h2>Três passos para comprar <span>antes de todo mundo</span></h2>
      <ol class="cp-steps">
        <li><b>1</b><h3>Entre no grupo agora</h3><p>Um clique no botão e você está dentro. Se um grupo lotar, o link leva sozinho para outro com vaga.</p></li>
        <li><b>2</b><h3>Receba o link à 00h do 11/11</h3><p>À meia-noite o grupo recebe o acesso antecipado à oferta, direto no WhatsApp.</p></li>
        <li><b>3</b><h3>Compre com 7 horas de vantagem</h3><p>A loja só abre para todo mundo às 7h. Até lá, quem compra é quem está no grupo.</p></li>
      </ol>
    </div>
  </section>

  {%- comment -%} DENTRO X FORA {%- endcomment -%}
  <section class="cp-sec cp-dark">
    <div class="cp-wrap">
      <p class="cp-eyebrow">Dentro ou fora</p>
      <h2>No 11/11, estar no grupo <span>faz diferença</span></h2>
      <div class="cp-vs" role="table" aria-label="Dentro e fora do grupo">
        <div class="cp-vs__head" role="row"><span role="columnheader"></span><span role="columnheader" class="cp-vs__in">No Grupo VIP</span><span role="columnheader">Fora do grupo</span></div>
        <div class="cp-vs__row" role="row"><span role="cell">Acesso à oferta</span><span role="cell" class="cp-vs__in">{{ ok }}00h do dia 11</span><span role="cell">{{ no }}07h do dia 11</span></div>
        <div class="cp-vs__row" role="row"><span role="cell">Cashback dos 100 primeiros pedidos</span><span role="cell" class="cp-vs__in">{{ ok }}Disputa com 7h de vantagem</span><span role="cell">{{ no }}Disputa depois das 7h</span></div>
        <div class="cp-vs__row" role="row"><span role="cell">Sorteio entre os 300 primeiros pedidos</span><span role="cell" class="cp-vs__in">{{ ok }}Mais chance de estar entre eles</span><span role="cell">{{ no }}Concorre com quem chegou antes</span></div>
        <div class="cp-vs__row" role="row"><span role="cell">Aviso da oferta</span><span role="cell" class="cp-vs__in">{{ ok }}Em primeira mão, no WhatsApp</span><span role="cell">{{ no }}Quando a loja abrir</span></div>
      </div>
      <a class="cp-btn cp-btn--center" href="{{ link }}" data-cp-cta target="_blank" rel="noopener">{{ wa }}<span>Quero estar no grupo</span></a>
    </div>
  </section>

  {%- comment -%} FAMÍLIA {%- endcomment -%}
  <section class="cp-sec cp-cream">
    <div class="cp-wrap cp-split">
      <figure class="cp-split__img">
        {%- if section.settings.foto_familia != blank -%}
          {{ section.settings.foto_familia | image_url: width: 1400 | image_tag: loading: 'lazy', alt: 'Mãe e filha olhando o celular com os protocolos VermeFree' }}
        {%- else -%}
          <img src="{{ 'gv-opcao-3.png' | asset_img_url: '1400x' }}" alt="Mãe e filha olhando o celular com os protocolos VermeFree" width="1400" height="788" loading="lazy">
        {%- endif -%}
      </figure>
      <div class="cp-split__txt">
        <p class="cp-eyebrow cp-eyebrow--leaf">Adulto · Kids · Família</p>
        <h2>Para quem cuida <span>da casa inteira</span></h2>
        <p class="cp-text">Protocolos para adultos, para crianças por faixa de idade e o Kit Família, para todo mundo fazer junto. No 11/11, quem está no grupo escolhe primeiro.</p>
        <a class="cp-btn" href="{{ link }}" data-cp-cta target="_blank" rel="noopener">{{ wa }}<span>Entrar no Grupo VIP</span></a>
      </div>
    </div>
  </section>

  {%- comment -%} DÚVIDAS {%- endcomment -%}
  <section class="cp-sec cp-sage">
    <div class="cp-wrap cp-faq">
      <p class="cp-eyebrow cp-eyebrow--leaf">Dúvidas rápidas</p>
      <h2>Antes de entrar</h2>
      <details open><summary>Quando é a oferta?</summary><p>Dia 11/11. No grupo, o acesso abre à 00h; para todo mundo, às 7h. Os detalhes saem primeiro no grupo.</p></details>
      <details><summary>Preciso pagar para entrar?</summary><p>Não. Entrar no grupo é grátis.</p></details>
      <details><summary>Vou receber muitas mensagens?</summary><p>Não. Só os administradores mandam mensagens, e você sai quando quiser.</p></details>
      <details><summary>E se o grupo lotar?</summary><p>O link leva sozinho para um grupo com vaga. É só clicar.</p></details>
    </div>
  </section>

  {%- comment -%} CTA FINAL {%- endcomment -%}
  <section class="cp-sec cp-dark cp-final">
    <div class="cp-wrap">
      <p class="cp-aviso" data-cp-aviso hidden>A loja está fechada se preparando para o 11/11 e reabre dia 11 às 7h para todos.</p>
      <h2>Garanta seu lugar <span>antes da meia-noite do dia 11</span></h2>
      <a class="cp-btn cp-btn--center" href="{{ link }}" data-cp-cta target="_blank" rel="noopener">{{ wa }}<span>Quero entrar no Grupo VIP</span></a>
      <p class="cp-legal">Grupo oficial da VermeFree no WhatsApp.</p>
    </div>
  </section>

  <div class="cp-sticky" data-cp-sticky>
    <a class="cp-btn" href="{{ link }}" data-cp-cta target="_blank" rel="noopener">{{ wa }}<span>Entrar no Grupo VIP</span></a>
  </div>
</div>

<style>
  .cp{--forest:#173e2d;--deep:#102e21;--leaf:#5e8c43;--lime:#c0de96;--cream:#f6f5ec;--sage:#e8efda;--ink:#173e2d;--muted:#55675a;--mutedd:#c8d7c6;--serif:Caprasimo,Georgia,serif;--sans:Inter,Arial,sans-serif;
    font-family:var(--sans);color:var(--ink);background:var(--cream);-webkit-text-size-adjust:100%}
  .cp *{box-sizing:border-box}
  .cp [hidden]{display:none!important}
  .cp h1,.cp h2,.cp h3,.cp p,.cp ol,.cp ul{margin:0;padding:0}
  .cp a{text-decoration:none;-webkit-tap-highlight-color:transparent}
  .cp svg{width:22px;height:22px;flex-shrink:0;stroke-linecap:round;stroke-linejoin:round}
  .cp-wrap{width:min(1120px,calc(100% - 48px));margin:0 auto}
  .cp-bar{background:var(--lime);color:var(--deep);text-align:center;font-size:12px;font-weight:600;letter-spacing:.4px;padding:9px 16px}
  .cp-eyebrow{font-size:11px;font-weight:600;letter-spacing:2.2px;text-transform:uppercase;color:var(--lime);margin-bottom:14px}
  .cp-eyebrow--leaf{color:var(--leaf)}
  .cp h1,.cp h2{font-family:var(--serif);font-weight:400;letter-spacing:-.03em;line-height:1.08}
  .cp h2{font-size:clamp(30px,3.6vw,46px);max-width:760px;margin-bottom:8px}
  .cp h1 span,.cp h2 span{color:var(--leaf)}
  .cp-dark h2 span,.cp-hero h1 span{color:var(--lime)}
  .cp-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:58px;padding:16px 30px;border-radius:100px;background:var(--lime);color:var(--deep);font-weight:700;font-size:16px;box-shadow:0 10px 30px #0e2a1d40;transition:transform .2s,background .2s}
  .cp-btn:hover{transform:translateY(-2px);background:#d1e8b2}
  .cp-btn--center{display:flex;width:max-content;margin:40px auto 0}
  .cp-cream .cp-btn{background:var(--forest);color:#fff}
  .cp-cream .cp-btn:hover{background:var(--deep)}

  .cp-hero{position:relative;color:var(--cream);background:var(--deep);overflow:hidden;min-height:min(88vh,820px);display:flex;align-items:center}
  .cp-hero__bg{position:absolute;inset:0}
  .cp-hero__bg img{width:100%;height:100%;object-fit:cover;object-position:70% 50%}
  .cp-hero__bg::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#102e21 0%,#102e21f0 34%,#102e2199 58%,#102e2100 85%)}
  .cp-hero__in{position:relative;padding:56px 0 64px}
  .cp-logo{width:140px;height:auto;filter:brightness(0) invert(1);margin-bottom:40px}
  .cp-hero h1{font-size:clamp(40px,5vw,66px);max-width:640px}
  .cp-lede{font-size:18px;line-height:1.65;color:var(--mutedd);max-width:520px;margin:22px 0 30px}
  .cp-lede strong{color:#fff}
  .cp-micro{list-style:none;display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:18px;font-size:13px;color:var(--mutedd)}
  .cp-micro li{display:flex;align-items:center;gap:6px}
  .cp-micro svg{width:16px;height:16px;color:var(--lime)}
  .cp-timer{display:inline-flex;align-items:center;gap:10px;margin-top:34px;padding:14px 20px;border:1px solid #c0de9640;border-radius:18px;background:#0b231799;backdrop-filter:blur(6px)}
  .cp-timer__l{font-size:11px;letter-spacing:1.6px;text-transform:uppercase;color:var(--mutedd);margin-right:6px;max-width:80px;line-height:1.3}
  .cp-timer div{text-align:center;min-width:44px}
  .cp-timer b{display:block;font:400 30px/1 var(--serif);color:var(--lime)}
  .cp-timer small{font-size:9px;letter-spacing:1.4px;text-transform:uppercase;color:var(--mutedd)}
  .cp-timer i{font-style:normal;color:#c0de9680;font-size:22px;margin-top:-14px}

  .cp-sec{padding:96px 0}
  .cp-cream{background:var(--cream)}
  .cp-sage{background:var(--sage)}
  .cp-dark{background:radial-gradient(ellipse at 5% 0%,#35633e 0,transparent 55%),var(--deep);color:var(--cream)}

  .cp-steps{list-style:none;display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:44px;counter-reset:s}
  .cp-steps li{position:relative;background:#fff;border:1px solid #dbe0d1;border-radius:22px;padding:30px 26px}
  .cp-steps b{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:var(--forest);color:var(--lime);font:400 22px var(--serif);margin-bottom:18px}
  .cp-steps h3{font-size:18px;font-weight:700;letter-spacing:-.2px;margin-bottom:8px}
  .cp-steps p{color:var(--muted);font-size:15px;line-height:1.6}

  .cp-vs{margin-top:40px;border:1px solid #ffffff26;border-radius:24px;overflow:hidden}
  .cp-vs__head,.cp-vs__row{display:grid;grid-template-columns:1.2fr 1fr 1fr}
  .cp-vs__head span{padding:16px 22px;font-size:11px;font-weight:600;letter-spacing:1.8px;text-transform:uppercase;color:var(--mutedd)}
  .cp-vs__head .cp-vs__in{color:var(--deep);background:var(--lime)}
  .cp-vs__row span{display:flex;align-items:center;gap:10px;padding:18px 22px;border-top:1px solid #ffffff1a;font-size:15px;line-height:1.4}
  .cp-vs__row span:first-child{font-weight:600}
  .cp-vs__row span:last-child{color:#c8d7c6b3}
  .cp-vs__row .cp-vs__in{background:#c0de9614;color:#fff;font-weight:600}
  .cp-vs__row .cp-vs__in svg{color:var(--lime)}

  .cp-split{display:grid;grid-template-columns:1.1fr 1fr;gap:64px;align-items:center}
  .cp-split__img{margin:0;border-radius:28px;overflow:hidden;aspect-ratio:16/10}
  .cp-split__img img{width:100%;height:100%;object-fit:cover;display:block}
  .cp-text{font-size:17px;line-height:1.7;color:var(--muted);margin:18px 0 30px}

  .cp-faq{max-width:760px}
  .cp-faq h2{margin-bottom:26px}
  .cp-faq details{background:#fff;border-radius:16px;padding:18px 22px;margin-top:10px}
  .cp-faq summary{font-weight:650;cursor:pointer}
  .cp-faq details p{color:var(--muted);margin-top:10px;line-height:1.6}

  .cp-final{text-align:center}
  .cp-final h2{margin:0 auto}
  .cp-aviso{display:inline-block;background:#c0de961f;border-radius:40px;padding:9px 18px;font-size:13px;margin-bottom:22px}
  .cp-legal{font-size:12px;color:var(--mutedd);margin-top:18px}

  .cp-sticky{display:none}
  @media(max-width:900px){
    .cp-wrap{width:calc(100% - 40px)}
    .cp-sec{padding:64px 0}
    .cp-hero{min-height:0;align-items:flex-end}
    .cp-hero__bg{position:relative;height:300px}
    .cp-hero{flex-direction:column;align-items:stretch}
    .cp-hero__bg img{object-position:50% 50%}
    .cp-hero__bg::after{background:linear-gradient(180deg,#102e21e6 0%,#102e2100 28%,#102e2100 55%,#102e21 100%)}
    .cp-hero__in{position:static;padding:0 0 44px;margin-top:-40px}
    .cp-hero__in > *{position:relative}
    .cp-hero__in > .cp-logo{position:absolute;top:18px;left:50%;transform:translateX(-50%);width:112px;margin:0;z-index:2}
    .cp-hero h1{font-size:34px;line-height:1.1}
    .cp-lede{font-size:16px;margin:16px 0 24px}
    .cp-btn{width:100%}
    .cp-btn--center{width:100%}
    .cp-timer{display:flex;justify-content:space-between;width:100%;margin-top:26px;padding:12px 14px}
    .cp-timer__l{display:none}
    .cp-timer b{font-size:26px}
    .cp-steps{grid-template-columns:1fr;gap:14px;margin-top:30px}
    .cp-vs__head,.cp-vs__row{grid-template-columns:1fr 1fr}
    .cp-vs__head span:first-child{display:none}
    .cp-vs__row span:first-child{grid-column:1/-1;padding-bottom:4px;font-size:13px;color:var(--lime);border-top:1px solid #ffffff1a}
    .cp-vs__row span:not(:first-child){border-top:0;font-size:14px;padding-top:8px;align-items:flex-start}
    .cp-split{grid-template-columns:1fr;gap:28px}
    .cp-sticky{display:block;position:fixed;left:0;right:0;bottom:0;z-index:50;padding:10px 16px calc(10px + env(safe-area-inset-bottom));background:#102e21f2;backdrop-filter:blur(8px);transform:translateY(110%);transition:transform .25s}
    .cp-sticky.is-on{transform:none}
    .cp-sticky .cp-btn{min-height:52px}
    .cp{padding-bottom:0}
  }
  @media(prefers-reduced-motion:reduce){.cp *{transition:none!important}}
</style>

<script>
  (function () {
    var t = document.querySelector('[data-cp-timer]');
    if (t) {
      var alvo = new Date('{{ section.settings.data_alvo | default: "2026-11-11T00:00:00-03:00" }}').getTime();
      var pad = function (n) { return (n < 10 ? '0' : '') + n; };
      var tick = function () {
        var s = Math.floor(Math.max(0, alvo - Date.now()) / 1000);
        t.querySelector('[data-d]').textContent = pad(Math.floor(s / 86400));
        t.querySelector('[data-h]').textContent = pad(Math.floor(s % 86400 / 3600));
        t.querySelector('[data-m]').textContent = pad(Math.floor(s % 3600 / 60));
        t.querySelector('[data-s]').textContent = pad(s % 60);
      };
      tick(); setInterval(tick, 1000);
    }
    if (window.vfTravaAtiva) {
      var a = document.querySelector('[data-cp-aviso]');
      if (a) a.hidden = false;
    }
    var st = document.querySelector('[data-cp-sticky]'), hero = document.querySelector('.cp-hero .cp-btn');
    if (st && hero && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (e) { st.classList.toggle('is-on', !e[0].isIntersecting && e[0].boundingClientRect.top < 0); }).observe(hero);
    }
    document.querySelectorAll('[data-cp-cta]').forEach(function (el) {
      el.addEventListener('click', function () {
        try { if (window.fbq) window.fbq('track', 'Lead', { content_name: 'Grupo VIP 11/11' }); } catch (e) {}
        try { if (window.gtag) window.gtag('event', 'generate_lead', { event_label: 'grupo_vip_1111', transport_type: 'beacon' }); } catch (e) {}
        try { if (window.Shopify && Shopify.analytics && Shopify.analytics.publish) Shopify.analytics.publish('vf_grupo_vip_click', { campanha: '11/11' }); } catch (e) {}
      });
    });
  })();
</script>

{% schema %}
{
  "name": "VF Grupo VIP 11/11",
  "settings": [
    { "type": "url", "id": "link_grupo", "label": "Link do grupo VIP (rastreado, da Sarah)" },
    { "type": "text", "id": "data_alvo", "label": "Contagem até (ISO)", "default": "2026-11-11T00:00:00-03:00" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "image_picker", "id": "foto_hero", "label": "Foto do topo" },
    { "type": "image_picker", "id": "foto_familia", "label": "Foto do bloco família" }
  ],
  "presets": [{ "name": "VF Grupo VIP 11/11" }]
}
{% endschema %}
