{%- comment -%}
  vf-grupo-vip — LP de captação do Grupo VIP do 11/11 (/pages/grupo-vip).
  Visual da LP social da VermeFree (link da bio): fundo floresta, logo no topo,
  foto arredondada e cards. Não abre a oferta.
  O link do grupo vem do campo "Link do grupo VIP" (enviado pela Sarah).
  Clique: Lead (Meta, se o pixel estiver na página), generate_lead (Google) e
  vf_grupo_vip_click (pixels personalizados).
{%- endcomment -%}
{%- assign link = section.settings.link_grupo | default: '#' -%}
<div class="gv">
  <div class="gv-shell">
    <header class="gv-mast">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: class: 'gv-logo', alt: 'VermeFree' }}
      {%- else -%}
        <span class="gv-logo-txt">VermeFree</span>
      {%- endif -%}
      <span class="gv-note">Grupo VIP · 11/11</span>
    </header>

    <main class="gv-layout">
      <section class="gv-brand" aria-labelledby="gv-h1">
        <p class="gv-eyebrow">Acesso antecipado · Grupo VIP</p>
        <h1 id="gv-h1">O 11/11 chega primeiro<span>no Grupo VIP.</span></h1>
        <p class="gv-intro">Quem está no grupo recebe o acesso à oferta <strong>à 00h do dia 11/11</strong>, 7 horas antes de abrir para todo mundo.</p>
        <figure class="gv-photo">
          {%- if section.settings.imagem != blank -%}
            {{ section.settings.imagem | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', alt: 'Protocolos VermeFree e o celular com o Grupo VIP' }}
          {%- else -%}
            <img src="{{ 'gv-opcao-2.png' | asset_img_url: '1600x' }}" alt="Protocolos VermeFree e o celular com o Grupo VIP" width="1600" height="900" fetchpriority="high">
          {%- endif -%}
          <figcaption><span>Adulto · Kids · Família</span><span>11/11 · 00h</span></figcaption>
        </figure>
        <p class="gv-foot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m12 3 7 3v5c0 5-7 10-7 10S5 16 5 11V6l7-3Z"/><path d="m8 11 3 3 5-6"/></svg>Grupo oficial da VermeFree. É grátis e você sai quando quiser.</p>
      </section>

      <section class="gv-nav" aria-labelledby="gv-nav-h">
        <h2 class="gv-nav-h" id="gv-nav-h">Garanta seu lugar</h2>

        <a class="gv-cta" href="{{ link }}" data-gv-cta target="_blank" rel="noopener">
          <div class="gv-cta-top"><span>Grupo VIP VermeFree</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M21 11.5a9 9 0 0 1-13.5 7.8L3 21l1.7-4.5A9 9 0 1 1 21 11.5Z"/><path d="m8 7 2 3-1 1c1 2 2 3 4 4l1-1 3 1c0 2-2 3-4 2-4-1-7-5-7-7 0-2 1-3 2-3Z"/></svg></div>
          <div class="gv-timer" data-gv-timer data-alvo="{{ section.settings.data_alvo | default: '2026-11-11T00:00:00-03:00' }}" aria-label="Contagem regressiva para o 11/11">
            <div><b data-d>--</b><small>dias</small></div>
            <div><b data-h>--</b><small>horas</small></div>
            <div><b data-m>--</b><small>min</small></div>
            <div><b data-s>--</b><small>seg</small></div>
          </div>
          <div class="gv-cta-bottom"><span>Quero entrar no Grupo VIP</span><span class="gv-round"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></span></div>
        </a>

        <div class="gv-cards">
          <div class="gv-card">
            <span class="gv-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
            <span class="gv-copy"><strong>Você compra antes de todo mundo</strong><small>O grupo recebe o acesso à meia-noite. A loja só abre para todos às 7h.</small></span>
          </div>
          <div class="gv-card">
            <span class="gv-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3 14.6 8.3l5.9.9-4.3 4.1 1 5.8L12 16.4 6.8 19.1l1-5.8L3.5 9.2l5.9-.9L12 3Z"/></svg></span>
            <span class="gv-copy"><strong>Mais chance nos primeiros pedidos</strong><small>Os 100 primeiros ganham cashback e os 300 primeiros concorrem a um kit VermeFree.</small></span>
          </div>
          <div class="gv-card">
            <span class="gv-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 11.5a9 9 0 0 1-13.5 7.8L3 21l1.7-4.5A9 9 0 1 1 21 11.5Z"/><path d="M8 10h8m-8 4h5"/></svg></span>
            <span class="gv-copy"><strong>Sem spam</strong><small>Só os administradores mandam mensagens. Se o grupo lotar, o link leva para um com vaga.</small></span>
          </div>
        </div>
      </section>
    </main>

    <footer class="gv-footer">
      <p data-gv-aviso hidden>A loja está fechada se preparando para o 11/11 e reabre dia 11 às 7h para todos.</p>
      <p>VermeFree. O cuidado começa por dentro.</p>
    </footer>
  </div>
</div>

<style>
  .gv{--forest:#173e2d;--forest-dark:#102e21;--leaf:#5e8c43;--lime:#c0de96;--cream:#f6f5ec;--muted:#c8d7c6;--line:#ffffff26;--serif:Caprasimo,Georgia,serif;--sans:Inter,Arial,sans-serif;
    min-height:100svh;color:var(--cream);font-family:var(--sans);-webkit-text-size-adjust:100%;
    background:radial-gradient(ellipse at 5% 5%,#35633e 0,transparent 55%),radial-gradient(ellipse at 95% 95%,#244c36 0,transparent 50%),#102e21}
  .gv *{box-sizing:border-box}
  .gv a{color:inherit;text-decoration:none;-webkit-tap-highlight-color:transparent}
  .gv a:focus-visible{outline:3px solid var(--lime);outline-offset:5px}
  .gv svg{display:block;width:24px;height:24px;flex-shrink:0;stroke-linecap:round;stroke-linejoin:round}
  .gv h1,.gv h2,.gv p{margin:0}
  .gv-shell{max-width:1152px;margin:auto;padding:34px 40px 24px}
  .gv-mast{display:flex;align-items:center;justify-content:space-between;padding-bottom:22px;border-bottom:1px solid var(--line)}
  .gv-logo{width:150px;height:auto;filter:brightness(0) invert(1)}
  .gv-logo-txt{font:400 26px var(--serif)}
  .gv-note{display:flex;align-items:center;gap:10px;font-size:10px;font-weight:600;letter-spacing:2.3px;text-transform:uppercase;color:var(--muted)}
  .gv-note::before{content:'';height:6px;width:6px;border-radius:50%;background:var(--lime)}
  .gv-layout{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:72px;align-items:center;padding:38px 0 30px}
  .gv-eyebrow{font-size:10px;font-weight:600;letter-spacing:2.2px;text-transform:uppercase;margin:0 0 16px;color:var(--lime)}
  .gv h1{font:400 clamp(38px,4.2vw,56px)/1.08 var(--serif);letter-spacing:-1.6px;max-width:540px;text-wrap:balance}
  .gv h1 span{display:block;color:var(--lime)}
  .gv-intro{font-size:15px;line-height:1.75;color:var(--muted);margin:18px 0 26px;max-width:420px}
  .gv-intro strong{color:var(--cream)}
  .gv-photo{margin:0;position:relative;overflow:hidden;border-radius:28px;aspect-ratio:16/9;background:#1e4a35;isolation:isolate}
  .gv-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .gv-photo::after{content:'';position:absolute;inset:45% 0 0;background:linear-gradient(transparent,rgba(10,26,18,.6));pointer-events:none}
  .gv-photo figcaption{position:absolute;bottom:18px;left:22px;right:22px;z-index:1;display:flex;justify-content:space-between;color:#fff;font-size:10px;letter-spacing:1.6px;text-transform:uppercase}
  .gv-foot{display:flex;align-items:center;gap:9px;margin-top:14px;color:var(--muted);font-size:11px}
  .gv-foot svg{width:16px;height:16px;color:var(--lime)}
  .gv-nav-h{display:flex;align-items:center;gap:16px;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin:0 0 14px;font-weight:400}
  .gv-nav-h::after{content:'';height:1px;background:var(--line);flex:1}
  .gv-cta{position:relative;overflow:hidden;isolation:isolate;display:block;background:var(--forest);color:#fff;border:1px solid #ffffff26;border-radius:23px;padding:24px 26px 22px;box-shadow:0 10px 30px #0003;transition:background .2s,transform .2s}
  .gv-cta::before,.gv-cta::after{content:'';position:absolute;z-index:-1;border:1px solid #c0de9623;border-radius:50%;width:235px;height:235px;right:-120px;top:-65px}
  .gv-cta::after{width:290px;height:290px;right:-144px;top:-92px}
  .gv-cta-top{display:flex;align-items:center;justify-content:space-between;color:var(--lime);font-size:10px;letter-spacing:2px;text-transform:uppercase}
  .gv-timer{display:flex;gap:10px;margin:22px 0}
  .gv-timer div{flex:1;text-align:center;border:1px solid #c0de9640;border-radius:14px;padding:10px 0 8px;background:#ffffff0a}
  .gv-timer b{display:block;font:400 32px/1 var(--serif);color:var(--lime)}
  .gv-timer small{font-size:9px;letter-spacing:1.6px;text-transform:uppercase;color:var(--muted)}
  .gv-cta-bottom{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:15px;font-weight:600}
  .gv-round{display:grid;place-items:center;background:var(--lime);color:var(--forest);width:44px;height:44px;border-radius:50%;transition:transform .2s}
  .gv-cards{display:grid;gap:10px;margin-top:10px}
  .gv-card{display:flex;align-items:center;gap:14px;min-height:76px;padding:14px 18px;background:#fafbf7;color:var(--forest);border:1px solid #dbe0d1;border-radius:17px}
  .gv-ic{width:34px;display:grid;place-items:center;color:var(--leaf)}
  .gv-copy{flex:1;min-width:0}
  .gv-copy strong{display:block;font-size:14px;font-weight:600;letter-spacing:-.2px}
  .gv-copy small{display:block;font-size:12px;line-height:1.5;color:#55675a;margin-top:3px}
  .gv-footer{display:flex;flex-direction:column;align-items:center;gap:8px;padding-top:16px;border-top:1px solid var(--line);font-size:10px;color:var(--muted);text-align:center}
  .gv-footer [data-gv-aviso]{background:#c0de961f;color:var(--cream);border-radius:40px;padding:8px 16px;font-size:11px}
  @media(hover:hover){.gv-cta:hover{background:var(--forest-dark);transform:translateY(-3px)}.gv-cta:hover .gv-round{transform:rotate(8deg)}}
  @media(max-width:850px){.gv-shell{padding:26px 24px 20px}.gv-layout{gap:34px}.gv h1{font-size:40px}}
  @media(max-width:650px){
    .gv-shell{max-width:480px;padding:18px 20px 20px}
    .gv-mast{justify-content:center;border:0;padding-bottom:12px}.gv-logo{width:128px}.gv-note{display:none}
    .gv-layout{display:block;padding:0 0 22px}
    .gv-eyebrow{text-align:center;margin-bottom:8px;font-size:9px}
    .gv h1{text-align:center;font-size:31px;line-height:1.12;letter-spacing:-1px;margin:0 auto}
    .gv-intro{text-align:center;font-size:13px;line-height:1.6;margin:10px auto 14px}
    .gv-photo{border-radius:22px}.gv-photo figcaption{bottom:12px;left:16px;right:16px;font-size:8px}
    .gv-foot{justify-content:center;font-size:10px;margin-top:8px}
    .gv-nav{margin-top:18px}.gv-nav-h{font-size:9px;margin-bottom:10px}
    .gv-cta{padding:18px 20px;border-radius:21px}.gv-timer{margin:16px 0}.gv-timer b{font-size:28px}.gv-cta-bottom{font-size:14px}
    .gv-card{padding:13px 15px;min-height:72px;border-radius:16px}.gv-copy strong{font-size:13px}.gv-copy small{font-size:11px}
  }
  @media(prefers-reduced-motion:reduce){.gv *{transition:none!important}}
</style>

<script>
  (function () {
    var t = document.querySelector('[data-gv-timer]');
    if (t) {
      var alvo = new Date(t.getAttribute('data-alvo')).getTime();
      var pad = function (n) { return (n < 10 ? '0' : '') + n; };
      var tick = function () {
        var s = Math.floor(Math.max(0, alvo - Date.now()) / 1000);
        t.querySelector('[data-d]').textContent = pad(Math.floor(s / 86400));
        t.querySelector('[data-h]').textContent = pad(Math.floor(s % 86400 / 3600));
        t.querySelector('[data-m]').textContent = pad(Math.floor(s % 3600 / 60));
        t.querySelector('[data-s]').textContent = pad(s % 60);
      };
      tick(); setInterval(tick, 1000);
    }
    if (window.vfTravaAtiva) {
      var a = document.querySelector('[data-gv-aviso]');
      if (a) a.hidden = false;
    }
    document.querySelectorAll('[data-gv-cta]').forEach(function (el) {
      el.addEventListener('click', function () {
        try { if (window.fbq) window.fbq('track', 'Lead', { content_name: 'Grupo VIP 11/11' }); } catch (e) {}
        try { if (window.gtag) window.gtag('event', 'generate_lead', { event_label: 'grupo_vip_1111', transport_type: 'beacon' }); } catch (e) {}
        try { if (window.Shopify && Shopify.analytics && Shopify.analytics.publish) Shopify.analytics.publish('vf_grupo_vip_click', { campanha: '11/11' }); } catch (e) {}
      });
    });
  })();
</script>

{% schema %}
{
  "name": "VF Grupo VIP 11/11",
  "settings": [
    { "type": "url", "id": "link_grupo", "label": "Link do grupo VIP (rastreado, da Sarah)" },
    { "type": "text", "id": "data_alvo", "label": "Contagem até (ISO)", "default": "2026-11-11T00:00:00-03:00" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "image_picker", "id": "imagem", "label": "Foto (16:9)" }
  ],
  "presets": [{ "name": "VF Grupo VIP 11/11" }]
}
{% endschema %}
