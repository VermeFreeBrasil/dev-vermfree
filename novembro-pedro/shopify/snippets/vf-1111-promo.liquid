<script>
  (function () {
    var mt = document.querySelector('[data-ve-mt]');
    if (mt) {
      var rows = [].slice.call(mt.querySelectorAll('[data-ve-row]')), go = mt.querySelector('[data-ve-go]');
      var $m = function (q) { return mt.querySelector(q); };
      var brl = function (c) { return 'R$ ' + (c / 100).toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.'); };
      var qty = function (r) { return +r.querySelector('[data-ve-qty]').textContent || 0; };
      var setQ = function (r, n) { n = Math.max(0, Math.min(10, n)); r.querySelector('[data-ve-qty]').textContent = n; r.classList.toggle('on', n > 0); };
      var conta = function () {
        var precos = [], cheio = 0;
        rows.forEach(function (r) { for (var i = 0; i < qty(r); i++) { precos.push(+r.dataset.preco); cheio += +r.dataset.preco; } });
        precos.sort(function (a, b) { return a - b; });
        var gratis = 0; for (var i = 0; i < Math.floor(precos.length / 5); i++) gratis += precos[i];
        return { n: precos.length, cheio: cheio, paga: Math.round((cheio - gratis) * 0.8) };
      };
      var desenha = function () {
        var c = conta(), n = c.n;
        $m('[data-ve-count]').textContent = n === 0 ? 'Nenhum protocolo escolhido' : n + (n === 1 ? ' protocolo' : ' protocolos');
        $m('[data-ve-was]').textContent = n ? brl(c.cheio) : '';
        $m('[data-ve-3x]').textContent = brl(Math.floor(c.paga / 3));
        $m('[data-ve-pix]').innerHTML = n === 0 ? 'Escolha acima quantos de cada' : 'ou <b>' + brl(c.paga) + '</b> à vista · <em>você economiza ' + brl(c.cheio - c.paga) + '</em>';
        mt.querySelector('[data-ve-lad="1"]').classList.toggle('on', n >= 1);
        mt.querySelector('[data-ve-lad="4"]').classList.toggle('on', n >= 4);
        mt.querySelector('[data-ve-lad="5"]').classList.toggle('on', n >= 5);
        $m('[data-ve-next]').innerHTML = n === 0 ? 'Todo pedido no 11/11 tem <b>frete grátis</b>.' : n < 4 ? 'Mais <b>' + (4 - n) + (4 - n === 1 ? ' protocolo' : ' protocolos') + '</b> e ganhe o <b>Kit Kids</b> de presente' : n === 4 ? '<b>Kit Kids garantido.</b> Mais 1 e o <b>5º sai grátis</b>' : '🎉 <b>Frete, Kit Kids e o 5º grátis</b> liberados';
        go.disabled = n === 0;
        go.textContent = n <= 1 ? 'Garantir meu protocolo →' : 'Garantir meus ' + n + ' protocolos →';
      };
      mt.addEventListener('click', function (e) {
        var st = e.target.closest('[data-ve-step]');
        if (st) { var r = st.closest('[data-ve-row]'); setQ(r, qty(r) + +st.dataset.veStep); desenha(); return; }
        var row = e.target.closest('[data-ve-row]');
        if (row && !e.target.closest('a, button') && qty(row) === 0) { setQ(row, 1); desenha(); }
      });
      go.addEventListener('click', function () {
        var items = rows.filter(function (r) { return qty(r) > 0; }).map(function (r) { return { id: +r.dataset.id, quantity: qty(r) }; });
        if (!items.length) return;
        go.disabled = true; go.textContent = 'Colocando...';
        fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: items }) })
          .then(function (res) { if (!res.ok) throw 0; location.href = '/cart'; }).catch(function () { desenha(); });
      });
      desenha();
    }
    var vs = document.querySelectorAll('[data-ve-video]');
    if ('IntersectionObserver' in window) { var io = new IntersectionObserver(function (es) { es.forEach(function (e) { var v = e.target.querySelector('video'); if (e.isIntersecting) v.play().catch(function () {}); else v.pause(); }); }, { threshold: .6 }); vs.forEach(function (f) { io.observe(f); }); }
    vs.forEach(function (f) { f.addEventListener('click', function () { var v = f.querySelector('video'), on = v.muted; vs.forEach(function (o) { o.querySelector('video').muted = true; o.querySelector('.snd').textContent = '🔇'; }); v.muted = !on; f.querySelector('.snd').textContent = on ? '🔊' : '🔇'; if (on) v.play().catch(function () {}); }); });
  })();
</script>
