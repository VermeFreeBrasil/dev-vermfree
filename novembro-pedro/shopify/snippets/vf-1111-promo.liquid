  .ve-card h3{font-size:15px;font-weight:700;color:#fff;line-height:1.3;min-height:40px}
  .ve-card .de{margin-top:10px;font-size:13px;color:#7f8e86;text-decoration:line-through}
  .ve-card .por{font-size:28px;font-weight:900;color:#ff4a52;letter-spacing:-.5px}
  .ve-card .por small{font-size:13px;color:#cfd8d2;font-weight:600}
  .ve-card form{margin-top:auto;padding-top:12px}
  .ve-card button{width:100%;background:#fff;color:#070a08;font:800 14px Inter,Arial,sans-serif;padding:12px;border-radius:40px;border:0;cursor:pointer}
