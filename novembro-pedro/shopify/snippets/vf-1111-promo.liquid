<style>
  .ve-home{--ink:#070a08;--forest:#102e21;--lime:#c0de96;--red:#e0262f;--red2:#9e0f17;--cream:#f6f5ec;background:var(--ink);color:var(--cream);font-family:Inter,Arial,sans-serif}
