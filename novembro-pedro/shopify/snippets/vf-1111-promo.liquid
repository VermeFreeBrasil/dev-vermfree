  html.ve-on body[class*="template-product"] #main .vf-dep,html.ve-on body[class*="template-product"] #main .vf-pdp-como-tomar,html.ve-on body[class*="template-product"] #main .vfx,html.ve-on body[class*="template-product"] #main .vf-ing,html.ve-on body[class*="template-product"] #main .vf-jdgm,html.ve-on body[class*="template-product"] #main .vf-faq,html.ve-on body[class*="template-product"] #main .vf-fam{background:#070a08!important;color:#b9c6bf}
  html.ve-on body[class*="template-product"] #main>.shopify-section:nth-of-type(even)>*{background:#0b0f0d!important}
  html.ve-on body[class*="template-product"] #main .vf-dep__card,html.ve-on body[class*="template-product"] #main .vf-pdp-como-tomar__phase,html.ve-on body[class*="template-product"] #main .vf-pdp-como-tomar__visual,html.ve-on body[class*="template-product"] #main .vf-cal__card,html.ve-on body[class*="template-product"] #main .vf-ing__card,html.ve-on body[class*="template-product"] #main .vf-jdgm__summary,html.ve-on body[class*="template-product"] #main .vf-jdgm__rev,html.ve-on body[class*="template-product"] #main .vf-faq__item,html.ve-on body[class*="template-product"] #main .vf-faq__support,html.ve-on body[class*="template-product"] #main .vf-fam__card{background:#111614!important;border-color:#ffffff14!important;box-shadow:none!important}
  html.ve-on body[class*="template-product"] #main h2,html.ve-on body[class*="template-product"] #main h3,html.ve-on body[class*="template-product"] #main h4,html.ve-on body[class*="template-product"] #main summary,html.ve-on body[class*="template-product"] #main strong,html.ve-on body[class*="template-product"] #main .vf-faq__item button{color:#f6f5ec!important}
  html.ve-on body[class*="template-product"] #main p,html.ve-on body[class*="template-product"] #main li,html.ve-on body[class*="template-product"] #main dd{color:#b9c6bf}
  html.ve-on body[class*="template-product"] #main .vf-pdp-como-tomar__warning,html.ve-on body[class*="template-product"] #main .vf-pdp-como-tomar__warning p{color:#7a4a00!important}
  html.ve-on body[class*="template-product"] #main .vf-cal__phone p,html.ve-on body[class*="template-product"] #main .vf-cal__phone strong,html.ve-on body[class*="template-product"] #main .vf-cal__phone h3{color:#153c2c!important}
  html.ve-on body[class*="template-product"] #main h2::before{content:"";display:inline-block;width:.62em;height:.62em;margin-right:.32em;vertical-align:.02em;border-radius:50%;background:radial-gradient(circle at calc(150% - 100% * var(--f)) 50%,#3a0a0e 0 49%,transparent 50%),#e8dfc8;box-shadow:0 0 calc(4px + 14px * var(--f)) rgba(224,38,47,calc(.2 + .6 * var(--f)))}
  @media(max-width:860px){
    .ve-pdp .ve-wrap{grid-template-columns:minmax(0,1fr);padding:16px 16px 34px;gap:22px}
    .ve-gal{position:static}
    .ve-pr strong{font-size:34px}
    .ve-q .ve-slots{justify-content:center;gap:5px}.ve-q .ve-slot{width:54px;height:98px;font-size:8.5px}.ve-q .ve-slot svg{width:28px}.ve-q .ve-slot .n{display:none}
    .ve-q .ve-gift{width:auto;margin-top:8px}
    .ve-q h3,.ve-q .msg{text-align:center}
    .ve-pay .ve-btn{width:100%}
    .ve-ul{grid-template-columns:1fr 1fr}
    html.ve-on .ve-stick{display:flex}
    html.ve-on body{padding-bottom:70px}
  }
</style>
<div class="ve ve-x" data-ve hidden>
  <section class="ve-pdp"><div class="ve-wrap">
    <div class="ve-gal">
      <div class="main"><span class="off">−20% hoje</span>{{ product.featured_image | image_url: width: 1100 | image_tag: loading: 'eager', alt: product.title, class: 've-main-img' }}</div>
      <div class="th">
        {%- for m in product.images limit: 6 -%}<button type="button" class="{% if forloop.first %}on{% endif %}" data-ve-th-img="{{ m | image_url: width: 1100 }}">{{ m | image_url: width: 160 | image_tag: loading: 'eager', alt: '' }}</button>{%- endfor -%}
      </div>
    </div>
    <div class="ve-info">
      <p class="ve-kick"><span>11.11</span> só hoje · a lua fecha em <b data-ve-t>--</b></p>
      <h1 class="cap">{{ titulo }}</h1>
      <p class="desc">{{ desc }}</p>
      <div class="ve-pr">
        <div class="ve-moon mini"><div class="ve-sombra" data-ve-sombra></div></div>
        <div><s>{{ v.price | money }}</s><strong>{{ v.price | times: 0.8 | money }}</strong><small>no 11/11 · <b data-ve-f>0%</b> do dia já passou</small></div>
      </div>
      <div class="ve-q" data-ve-q-box data-id="{{ v.id }}" data-preco="{{ v.price }}">
        <h3>Quantos você leva?</h3>
        <div class="ve-slots">
          {%- for i in (1..4) -%}<button type="button" class="ve-slot{% if i == 1 %} on{% endif %}" data-ve-n="{{ i }}"><span class="n">{{ i }}</span>{{ frasco }}<span class="l">{{ i }} un.</span></button>{%- endfor -%}
          <span class="ve-plus">+</span>
          <button type="button" class="ve-slot free" data-ve-n="5"><span class="tag">GRÁTIS</span>{{ frasco }}<span class="l">o 5º</span></button>
          <div class="ve-gift" data-ve-gift>+ Kit Kids 2 a 4 anos<small>de presente na compra de 4</small></div>
        </div>
        <p class="msg" data-ve-qmsg>Com 4, ganha o Kit Kids. Com 5, o 5º sai grátis.</p>
        <div class="ve-pay">
          <div class="t"><small>Você paga</small><b data-ve-pay>{{ v.price | times: 0.8 | money }}</b></div>
          <button class="ve-btn" type="button" data-ve-buy>Colocar 1 no carrinho</button>
        </div>
      </div>
      <ul class="ve-ul">
        <li><b>Frete grátis</b>sem valor mínimo</li>
        <li><b>15% de cashback</b>nos 100 primeiros pedidos</li>
        <li><b>Sorteio de um kit</b>entre os 300 primeiros</li>
        <li><b>Guia e manual</b>digitais no seu e-mail</li>
      </ul>
      <a class="ve-mix" href="/#ve-monte">Quer misturar protocolos? Monte seus 5 →</a>
    </div>
  </div></section>
</div>
<div class="ve ve-x" data-ve data-ve-fim hidden>
  <section class="ve-fim">
    <div class="ve-moon"><div class="ve-sombra" data-ve-sombra></div></div>
    <h2 class="cap">A lua fecha em <em class="r" data-ve-th>--</em>.</h2>
    <p>Depois disso o {{ titulo }} volta para {{ v.price | money }}. Hoje sai por <b style="color:#ff6b72">{{ v.price | times: 0.8 | money }}</b>, e o 5º é por nossa conta.</p>
    <a href="#" class="ve-btn" data-ve-stick-go>Quero o meu agora</a>
  </section>
</div>
<div class="ve ve-stick" data-ve hidden>
  <div class="ve-moon m"><div class="ve-sombra" data-ve-sombra></div></div>
  <div class="tx"><b>{{ v.price | times: 0.8 | money }}</b> <s style="color:#7f8e86;font-size:12px">{{ v.price | money }}</s><small>a lua fecha em <b data-ve-t>--</b></small></div>
  <a href="#" data-ve-stick-go>Comprar</a>
</div>
<script>
  (function () {
    var box = document.querySelector('[data-ve-q-box]'); if (!box) return;
    var preco = +box.dataset.preco, id = +box.dataset.id, n = 1;
    var slots = box.querySelectorAll('[data-ve-n]'), gift = box.querySelector('[data-ve-gift]'), msg = box.querySelector('[data-ve-qmsg]');
    var pay = box.querySelector('[data-ve-pay]'), buy = box.querySelector('[data-ve-buy]');
    var brl = function (c) { return 'R$ ' + (c / 100).toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.'); };
    var desenha = function () {
      slots.forEach(function (s) { s.classList.toggle('on', +s.dataset.veN <= n); });
      gift.classList.toggle('on', n >= 4);
      pay.textContent = brl(Math.round(preco * 0.8 * (n >= 5 ? n - 1 : n)));
      buy.textContent = 'Colocar ' + n + ' no carrinho';
      msg.innerHTML = n < 4 ? 'Leve <b>' + (4 - n) + ' a mais</b> e ganhe o Kit Kids de 2 a 4 anos.' : n === 4 ? '<b>Kit Kids garantido.</b> Mais 1 e o 5º sai grátis.' : '<b>5 frascos, pagando 4</b>, mais o Kit Kids de presente.';
    };
    slots.forEach(function (s) { s.addEventListener('click', function () { n = +s.dataset.veN; desenha(); }); });
    buy.addEventListener('click', function () {
      buy.disabled = true; buy.textContent = 'Colocando...';
      fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: [{ id: id, quantity: n }] }) })
        .then(function () { location.href = '/cart'; }).catch(function () { buy.disabled = false; desenha(); });
    });
    document.querySelectorAll('[data-ve-stick-go]').forEach(function (sg) { sg.addEventListener('click', function (e) { e.preventDefault(); box.scrollIntoView({ behavior: 'smooth', block: 'center' }); }); });
    var lum = function (c) { var m = c.match(/[\d.]+/g); if (!m || (m[3] !== undefined && +m[3] < .5)) return -1; return (0.299 * m[0] + 0.587 * m[1] + 0.114 * m[2]) / 255; };
    var contraste = function () {
      if (!document.documentElement.classList.contains('ve-on')) return;
      document.querySelectorAll('#main *').forEach(function (el) {
        if (el.closest('.ve-x') || !Array.prototype.some.call(el.childNodes, function (t) { return t.nodeType === 3 && t.textContent.trim(); })) return;
        if (lum(getComputedStyle(el).color) > .45) return;
        var a = el, bg = -1; while (a && bg < 0) { bg = lum(getComputedStyle(a).backgroundColor); a = a.parentElement; }
        if (bg >= 0 && bg < .2) el.style.setProperty('color', '#d6dfd9', 'important');
      });
    };
    var monta = function () {
      var fim = document.querySelector('[data-ve-fim]'), mn = document.getElementById('main');
      if (fim && mn) mn.appendChild(fim);
      if (mn) mn.querySelectorAll('a[href^="#"], a[href*="/products/"], a[href="/cart"]').forEach(function (a) {
        if (a.closest('.ve-x') || !/btn|cta|button/i.test(a.className)) return;
        a.setAttribute('data-ve-cta', ''); a.addEventListener('click', function (e) { e.preventDefault(); box.scrollIntoView({ behavior: 'smooth', block: 'center' }); });
      });
      contraste(); setTimeout(contraste, 1500); setTimeout(contraste, 4000);
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', monta); else monta();
    var main = document.querySelector('.ve-main-img');
    document.querySelectorAll('[data-ve-th-img]').forEach(function (b) { b.addEventListener('click', function () { main.src = b.dataset.veThImg; main.removeAttribute('srcset'); document.querySelectorAll('[data-ve-th-img]').forEach(function (x) { x.classList.remove('on'); }); b.classList.add('on'); }); });
    desenha();
  })();
</script>
{%- endif -%}
