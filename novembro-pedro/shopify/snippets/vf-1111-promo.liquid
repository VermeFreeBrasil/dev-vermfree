<style>
  .ve{font-family:Inter,Arial,sans-serif}
  .ve[hidden]{display:none!important}
  html.ve-on #shopify-section-vf-announcement-bar{display:none!important}
  .ve-live{display:flex;align-items:center;justify-content:center;gap:14px;padding:10px 16px;background:#000;color:#f6f5ec;border-bottom:1px solid #ffffff14;font-size:13px;letter-spacing:.3px;flex-wrap:wrap;text-align:center}
  .ve-live .dot{display:inline-flex;align-items:center;gap:7px;color:#ff4a52;font-weight:800;text-transform:uppercase;font-size:12px;letter-spacing:1.5px}
  .ve-live .dot:before{content:'';width:8px;height:8px;border-radius:50%;background:#ff3b44;box-shadow:0 0 0 4px #ff3b4433;animation:vePulse 1.4s infinite}
  @keyframes vePulse{50%{box-shadow:0 0 0 8px #ff3b4400}}
  .ve-live b{color:#fff}
  .ve-live .t{font-variant-numeric:tabular-nums;color:#ff6b72;font-weight:800}
  .ve-live a{background:#e0262f;color:#fff;font-weight:800;padding:6px 14px;border-radius:30px;text-decoration:none;font-size:12.5px}
  @media(max-width:700px){.ve-live{font-size:11.5px;gap:4px 10px;padding:8px 12px}.ve-live .o{flex-basis:100%}}
</style>
<div class="ve ve-live" data-ve hidden>
  <span class="dot">Ao vivo</span>
  <span class="o"><b>11.11</b> · o maior desconto da história da VermeFree</span>
  <span>a lua fecha em <span class="t" data-ve-t>--</span></span>
  <a href="/#ve-monte">Comprar</a>
</div>
<script>
  (function () {
    var INI = Date.parse('2026-11-11T00:00:00-03:00'), FIM = Date.parse('2026-11-11T23:59:59-03:00');
    var q = new URLSearchParams(location.search), sim = false;
    try {
      if (q.get('vf_diad') === 'on') sessionStorage.setItem('vf_diad', '1');
      if (q.get('vf_diad') === 'off') sessionStorage.removeItem('vf_diad');
      sim = sessionStorage.getItem('vf_diad') === '1';
    } catch (e) {}
    var agora = Date.now();
    window.vfDiaD = sim || (agora >= INI && agora <= FIM);
    if (!window.vfDiaD) return;
    document.documentElement.classList.add('ve-on');
    // na simulação, o "dia" é o dia de hoje em Brasília
    var ini = INI, fim = FIM;
    if (sim && (agora < INI || agora > FIM)) { var d = new Date(agora - 3 * 3600e3); d.setUTCHours(0, 0, 0, 0); ini = d.getTime() + 3 * 3600e3; fim = ini + 86399e3; }
    var pad = function (n) { return (n < 10 ? '0' : '') + n; };
    var tick = function () {
      var now = Date.now(), s = Math.max(0, Math.floor((fim - now) / 1000));
      var f = Math.min(1, Math.max(0, (now - ini) / (fim - ini)));
      var txt = pad(Math.floor(s / 3600)) + 'h ' + pad(Math.floor(s % 3600 / 60)) + 'm ' + pad(s % 60) + 's';
      document.querySelectorAll('[data-ve-t]').forEach(function (el) { el.textContent = txt; });
      document.querySelectorAll('[data-ve-th]').forEach(function (el) { el.textContent = pad(Math.floor(s / 3600)) + 'h ' + pad(Math.floor(s % 3600 / 60)) + 'm'; });
      document.querySelectorAll('[data-ve-f]').forEach(function (el) { el.textContent = Math.round(f * 100) + '%'; });
      document.querySelectorAll('[data-ve-bar]').forEach(function (el) { el.style.width = (f * 100) + '%'; });
      document.querySelectorAll('[data-ve-sombra]').forEach(function (el) { el.style.left = (-108 + 104 * f) + '%'; });
    };
    var mostra = function () { document.querySelectorAll('[data-ve]').forEach(function (el) { el.hidden = false; }); tick(); };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', mostra); else mostra();
    setInterval(tick, 1000);
  })();
</script>
