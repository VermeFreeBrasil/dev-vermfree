        </div>
      {%- endif -%}
    {%- endfor -%}
  </div></section>

  <div class="ve-trilho"><span>Frete grátis sem mínimo</span><span>15% de cashback nos 100 primeiros</span><span>Sorteio de um kit entre os 300 primeiros</span><span>Guia e manual digitais</span></div>
  <p class="ve-fine">Só no dia 11/11, até 23h59 (horário de Brasília). Descontos aplicados automaticamente no carrinho. No compre 4 leve 5, sai grátis o item de menor valor.</p>
</div>
<script>
  (function () {
    var esc = [], slots = document.querySelectorAll('[data-ve-slot]'), go = document.querySelector('[data-ve-go]');
    var msg = document.querySelector('[data-ve-msg]'), gift = document.querySelector('[data-ve-gift]');
    if (!go) return;
    var desenha = function () {
      slots.forEach(function (s, i) {
        var it = esc[i], lbl = s.querySelector('[data-ve-lbl]');
        s.classList.toggle('on', !!it);
        lbl.textContent = it ? it.nome : (i === 4 ? 'o 5º' : 'escolha');
      });
      gift.classList.toggle('on', esc.length >= 4);
      go.disabled = esc.length === 0;
      msg.textContent = esc.length >= 5 ? 'Pronto: 5 protocolos, o de menor valor sai grátis.' : (esc.length === 4 ? 'Falta 1: o 5º sai grátis.' : 'Escolhidos: ' + esc.length + ' de 5.');
    };
    document.querySelectorAll('[data-ve-add]').forEach(function (b) {
      b.addEventListener('click', function () { if (esc.length < 5) { esc.push({ id: +b.getAttribute('data-ve-add'), nome: b.getAttribute('data-ve-nome') }); desenha(); } });
    });
    slots.forEach(function (s, i) { s.addEventListener('click', function () { if (esc[i]) { esc.splice(i, 1); desenha(); } }); });
    go.addEventListener('click', function () {
      var q = {}; esc.forEach(function (it) { q[it.id] = (q[it.id] || 0) + 1; });
      var items = Object.keys(q).map(function (id) { return { id: +id, quantity: q[id] }; });
      go.disabled = true; go.textContent = 'Colocando...';
      fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: items }) })
        .then(function () { location.href = '/cart'; })
        .catch(function () { go.disabled = false; go.textContent = 'Colocar no carrinho'; });
    });
  })();
</script>
{%- endif -%}
