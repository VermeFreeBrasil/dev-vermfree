.vn-live{display:flex;align-items:center;justify-content:center;gap:14px;padding:10px 16px;background:#06110c;color:#e9f3e4;border-bottom:1px solid #c0de9626;font-size:13px;letter-spacing:.3px;flex-wrap:wrap;text-align:center}
.vn-live .tg{display:inline-flex;align-items:center;gap:8px;color:#c0de96;font-weight:900;text-transform:uppercase;font-size:12px;letter-spacing:1.6px}
.vn-live .tg:before{content:'';width:9px;height:9px;border-radius:50%;background:#c0de96;box-shadow:0 0 0 4px #c0de9633;animation:vnPulse 1.6s infinite}
@keyframes vnPulse{50%{box-shadow:0 0 0 8px #c0de9600}}
.vn-live b{color:#fff}
.vn-live .t{font-variant-numeric:tabular-nums;color:#c0de96;font-weight:800}
.vn-live a{background:#5ebc43;color:#fff;font-weight:800;padding:6px 14px;border-radius:30px;text-decoration:none;font-size:12.5px}
@media(max-width:700px){.vn-live{font-size:11.5px;gap:4px 10px;padding:8px 12px}.vn-live .o{flex-basis:100%}}
</style>
<div class="vn vn-live" data-vn hidden>
  <span class="tg">Verme November</span>
  <span class="o">dia <b data-vn-dia>1</b> de 8 · <b>até 15% OFF</b> + frete grátis acima de R$ 299</span>
  <span>termina em <span class="t" data-vn-t>--</span></span>
  <a href="/#vn-monte">Comprar</a>
</div>
<script>
  (function () {
  var INI = Date.parse('2026-11-12T00:00:00-03:00'), FIM = Date.parse('2026-11-19T23:59:59-03:00');
  var q = new URLSearchParams(location.search), sim = false;
  try {
      if (q.get('vf_vn') === 'on') sessionStorage.setItem('vf_vn', '1');
      if (q.get('vf_vn') === 'off') sessionStorage.removeItem('vf_vn');
      sim = sessionStorage.getItem('vf_vn') === '1';
  } catch (e) {}
  var agora = Date.now();
  window.vfVN = sim || (agora >= INI && agora <= FIM);
  if (!window.vfVN) return;
  document.documentElement.classList.add('vn-on');
  var pad = function (n) { return (n < 10 ? '0' : '') + n; };
  var tick = function () {
      var now = Date.now(), s = Math.max(0, Math.floor((FIM - now) / 1000));
      var d = Math.floor(s / 86400), h = Math.floor(s % 86400 / 3600), m = Math.floor(s % 3600 / 60);
      var dia = Math.min(8, Math.max(1, Math.floor((now - INI) / 864e5) + 1));
      var longo = (d ? d + 'd ' : '') + pad(h) + 'h ' + pad(m) + 'm ' + pad(s % 60) + 's';
      var curto = d ? d + (d === 1 ? ' dia' : ' dias') + ' e ' + h + 'h' : pad(h) + 'h ' + pad(m) + 'm';
      document.querySelectorAll('[data-vn-t]').forEach(function (el) { el.textContent = longo; });
      document.querySelectorAll('[data-vn-th]').forEach(function (el) { el.textContent = curto; });
      document.querySelectorAll('[data-vn-dia]').forEach(function (el) { el.textContent = dia; });
      document.querySelectorAll('[data-vn-dias] i').forEach(function (el, i) { el.className = i + 1 < dia ? 'p' : i + 1 === dia ? 'h' : ''; });
  };
  var eta = function () {
      var M = 'jan fev mar abr mai jun jul ago set out nov dez'.split(' '), fd = function (d) { return d.getDate() + ' ' + M[d.getMonth()]; };
      var add = function (d, k) { var x = new Date(d.getTime()); while (k > 0) { x.setDate(x.getDate() + 1); if (x.getDay() % 6) k--; } return x; };
      var hoje = new Date(Date.now()); hoje.setHours(12, 0, 0, 0); var env = add(hoje, 2);
      var t = ['Hoje, ' + fd(hoje), 'Até ' + fd(env), fd(add(env, 3)) + ' – ' + fd(add(env, 8))];
      document.querySelectorAll('[data-eta]').forEach(function (el) { el.textContent = t[+el.dataset.eta]; });
  };
  var mostra = function () { document.querySelectorAll('[data-vn]').forEach(function (el) { el.hidden = false; }); tick(); eta(); };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', mostra); else mostra();
  setInterval(tick, 1000);
  })();
</script>
