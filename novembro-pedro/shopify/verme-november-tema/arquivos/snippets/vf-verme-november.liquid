  <section class="vn-sec" style="background:var(--ink2)"><div class="vn-wrap">
  <div class="vn-head"><h2 class="cap">Perguntas <em>do Verme November.</em></h2><p>Tudo o que vale de 12 a 19/11, sem letra miúda.</p></div>
  <div class="vn-faq">
      <details open><summary>Como funciona a escada de desconto?</summary><p>Qualquer pedido tem 10% OFF. Com 3 ou mais itens no carrinho, o desconto vira 12% em tudo. Com 5 ou mais, 15% em tudo. Vale sempre a maior faixa.</p></details>
      <details><summary>Posso misturar protocolos?</summary><p>Pode. Conta o total de itens do carrinho: Adulto, Kids e Kit Família entram na mesma conta.</p></details>
      <details><summary>Preciso de cupom?</summary><p>Não. O desconto entra sozinho no carrinho, de acordo com a quantidade.</p></details>
      <details><summary>O frete é grátis?</summary><p>Sim, para pedidos a partir de R$ 299.</p></details>
      <details><summary>Dá para parcelar?</summary><p>Sim, em até 3x sem juros no cartão.</p></details>
      <details><summary>Até quando vale?</summary><p>Até 19/11 às 23h59, horário de Brasília. Depois disso, os preços voltam ao normal.</p></details>
  </div>
  </div></section>

  <section class="vn-fim">
  <div class="vn-dias" data-vn-dias aria-hidden="true">{%- for d in (12..19) -%}<i>{{ d }}</i>{%- endfor -%}</div>
  <h2 class="cap">O Verme November termina em <em class="l" data-vn-th>--</em>.</h2>
  <p>Depois disso, o desconto de 15% para a casa toda só no ano que vem.</p>
  <a class="vn-btn" href="#vn-monte">Montar meu pedido →</a>
  </section>
  <p class="vn-fine">De 12/11 00h a 19/11 23h59 (horário de Brasília). Descontos aplicados automaticamente no carrinho; as faixas não somam entre si, vale a maior. Frete grátis para pedidos a partir de R$ 299.</p>
</div>
<script>
  (function () {
  var brl = function (c) { return 'R$ ' + (c / 100).toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.'); };
  var pct = function (n) { return n >= 5 ? 15 : n >= 3 ? 12 : n >= 1 ? 10 : 0; };
  var mt = document.querySelector('[data-vn-mt]');
  if (mt) {
      var rows = [].slice.call(mt.querySelectorAll('[data-vn-row]')), go = mt.querySelector('[data-vn-go]');
      var $m = function (q) { return mt.querySelector(q); };
      var qty = function (r) { return +r.querySelector('[data-vn-qty]').textContent || 0; };
      var setQ = function (r, n) { n = Math.max(0, Math.min(10, n)); r.querySelector('[data-vn-qty]').textContent = n; r.classList.toggle('on', n > 0); };
      var desenha = function () {
        var n = 0, cheio = 0;
        rows.forEach(function (r) { n += qty(r); cheio += qty(r) * +r.dataset.preco; });
        var d = pct(n), paga = Math.round(cheio * (100 - d) / 100);
        $m('[data-vn-count]').textContent = n === 0 ? 'Nenhum protocolo escolhido' : n + (n === 1 ? ' protocolo' : ' protocolos') + ' · ' + d + '% OFF';
        $m('[data-vn-was]').textContent = n ? brl(cheio) : '';
        $m('[data-vn-3x]').textContent = brl(Math.floor(paga / 3));
        $m('[data-vn-pix]').innerHTML = n === 0 ? 'Escolha acima quantos de cada' : 'ou <b>' + brl(paga) + '</b> à vista · <em>você economiza ' + brl(cheio - paga) + '</em>';
        mt.querySelector('[data-vn-lad="1"]').classList.toggle('on', d === 10);
        mt.querySelector('[data-vn-lad="3"]').classList.toggle('on', d === 12);
        mt.querySelector('[data-vn-lad="5"]').classList.toggle('on', d === 15);
        var fr = $m('[data-vn-fr]'), ok = paga >= 29900;
        fr.classList.toggle('on', ok);
        fr.innerHTML = ok ? '🚚 <b>Frete grátis</b> garantido' : n ? '🚚 Faltam <b>' + brl(29900 - paga) + '</b> para o frete grátis' : '🚚 Frete grátis a partir de R$ 299';
        $m('[data-vn-next]').innerHTML = n === 0 ? 'Todo pedido do Verme November tem <b>10% OFF</b>.' : n < 3 ? 'Mais <b>' + (3 - n) + (3 - n === 1 ? ' protocolo' : ' protocolos') + '</b> e o desconto sobe para <b>12%</b>' : n < 5 ? 'Mais <b>' + (5 - n) + '</b> e você chega ao topo: <b>15% em tudo</b>' : '🎉 Você chegou ao topo: <b>15% OFF</b> em tudo';
        go.disabled = n === 0;
        go.textContent = n <= 1 ? 'Garantir meu protocolo →' : 'Garantir meus ' + n + ' protocolos →';
      };
      mt.addEventListener('click', function (e) {
        var st = e.target.closest('[data-vn-step]');
        if (st) { var r = st.closest('[data-vn-row]'); setQ(r, qty(r) + +st.dataset.vnStep); desenha(); return; }
        var row = e.target.closest('[data-vn-row]');
        if (row && !e.target.closest('a, button') && qty(row) === 0) { setQ(row, 1); desenha(); }
      });
      go.addEventListener('click', function () {
        var items = rows.filter(function (r) { return qty(r) > 0; }).map(function (r) { return { id: +r.dataset.id, quantity: qty(r) }; });
        if (!items.length) return;
        go.disabled = true; go.textContent = 'Colocando...';
        fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: items }) })
          .then(function (res) { if (!res.ok) throw 0; location.href = '/cart'; }).catch(function () { desenha(); });
      });
      desenha();
  }
  var poeCur = function () { if (!document.documentElement.classList.contains('vn-on')) return; var cur = document.querySelector('[id$="__vf_curadoria"]'), slot = document.querySelector('[data-vn-cur-slot]'); if (cur && slot) slot.appendChild(cur); };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', poeCur); else poeCur();
  var vs = document.querySelectorAll('[data-vn-video]');
  if ('IntersectionObserver' in window) { var io = new IntersectionObserver(function (es) { es.forEach(function (e) { var v = e.target.querySelector('video'); if (e.isIntersecting) v.play().catch(function () {}); else v.pause(); }); }, { threshold: .6 }); vs.forEach(function (f) { io.observe(f); }); }
  vs.forEach(function (f) { f.addEventListener('click', function () { var v = f.querySelector('video'), on = v.muted; vs.forEach(function (o) { o.querySelector('video').muted = true; o.querySelector('.snd').textContent = '🔇'; }); v.muted = !on; f.querySelector('.snd').textContent = on ? '🔊' : '🔇'; if (on) v.play().catch(function () {}); }); });
  })();
</script>
