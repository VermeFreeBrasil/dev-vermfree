          <figure class="is-v" data-vn-video><video src="{{ src }}" poster="{{ vv.preview_image | image_url: width: 400 }}" muted loop playsinline preload="none"></video><span class="snd">🔇</span><figcaption>{{ dep.nome.value }}</figcaption></figure>
        {%- endif -%}
