{%- comment -%}
  vf-verme-november · Campanha Verme November (12/11 00h → 19/11 23h59, Brasília).
  parte: 'barra' (faixa no topo de todas as páginas) · parte: 'home' (banner da campanha na home).
  Regra (descontos automáticos da Shopify): 10% em qualquer pedido · 12% com 3+ itens · 15% com 5+ itens · frete grátis acima de R$ 299.
  Aparece só no período. Prévia: ?vf_vn=on.
{%- endcomment -%}
{%- if parte == 'barra' -%}
<div class="vn-bar" data-vn hidden>
  <span class="vn-bar__dot" aria-hidden="true"></span>
  <b>VERME NOVEMBER</b><span class="vn-bar__sep">·</span><span>até <b>15% OFF</b> + frete grátis acima de R$ 299</span><span class="vn-bar__sep vn-bar__hide">·</span><span class="vn-bar__hide">termina em <b data-vn-cd>--</b></span>
</div>
{%- elsif parte == 'home' -%}
<section class="vn-hero" data-vn hidden aria-label="Verme November">
  <div class="vn-hero__in">
    <div class="vn-hero__moon" aria-hidden="true"><span></span></div>
    <div class="vn-hero__copy">
      <p class="vn-hero__k">Verme November · 12 a 19/11</p>
      <h2 class="vn-hero__h">O mês da desparasitação.<br><em>Até 15% OFF em todos os protocolos.</em></h2>
      <ul class="vn-hero__steps">
        <li><b>10%</b><small>1 protocolo</small></li>
        <li><b>12%</b><small>3 ou mais</small></li>
        <li class="is-top"><b>15%</b><small>5 ou mais</small></li>
      </ul>
      <p class="vn-hero__f">🚚 Frete grátis acima de R$ 299 · desconto aplicado automaticamente no carrinho</p>
      <div class="vn-hero__cta">
        <a href="/#vf-protocolos" class="vn-hero__btn">Montar meu pedido</a>
        <span class="vn-hero__cd">acaba em <b data-vn-cd>--</b></span>
      </div>
    </div>
  </div>
</section>
{%- endif -%}
{%- unless vn_js_ok -%}
<style>
  .vn-bar{display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap;background:#0f2a1f;color:#e9f3e4;font:500 13px/1.3 Inter,Arial,sans-serif;padding:9px 14px;text-align:center;letter-spacing:.2px}
  .vn-bar b{color:#c0de96;font-weight:800}
  .vn-bar__dot{width:9px;height:9px;border-radius:50%;background:#c0de96;box-shadow:-3px 0 0 0 #0f2a1f inset}
  .vn-bar__sep{opacity:.5}
  @media(max-width:640px){.vn-bar{font-size:12px;gap:6px}.vn-bar__hide{display:none}}
  .vn-hero{background:radial-gradient(ellipse 70% 90% at 82% 30%,#245a40 0,#173e2d 45%,#0f2a1f 100%);color:#f6f5ec;font-family:Inter,Arial,sans-serif}
  .vn-hero__in{max-width:1180px;margin:0 auto;padding:44px 20px;display:grid;grid-template-columns:1fr 1.6fr;gap:40px;align-items:center}
  .vn-hero__moon{position:relative;overflow:hidden;width:min(320px,70vw);aspect-ratio:1;margin:0 auto;border-radius:50%;background:radial-gradient(circle at 38% 35%,#f3ead2 0,#d9cfa9 55%,#a99d73 100%);box-shadow:0 0 80px #c0de9640}
  .vn-hero__moon span{position:absolute;inset:0;border-radius:50%;background:#0f2a1f;transform:translateX(38%);opacity:.94}
  .vn-hero .vn-hero__k{margin:0 0 10px;font-size:13px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#c0de96}
  .vn-hero .vn-hero__h{margin:0;color:#f6f5ec!important;font-family:Caprasimo,Georgia,serif;font-weight:400;font-size:clamp(30px,4vw,48px);line-height:1.08}
  .vn-hero .vn-hero__h em{font-style:normal;color:#c0de96!important}
  .vn-hero__steps{list-style:none;margin:22px 0 14px;padding:0;display:flex;gap:10px;flex-wrap:wrap}
  .vn-hero__steps li{min-width:104px;padding:12px 16px;border-radius:14px;border:1.5px solid #c0de9655;background:#ffffff0d;text-align:center}
  .vn-hero__steps li b{display:block;font-size:28px;font-weight:800;line-height:1}
  .vn-hero__steps li small{font-size:12px;opacity:.8}
  .vn-hero__steps li.is-top{background:#c0de96;color:#173e2d;border-color:#c0de96}
  .vn-hero__f{margin:0 0 20px;font-size:14px;opacity:.9}
  .vn-hero__cta{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
  .vn-hero__btn{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 30px;border-radius:40px;background:#5ebc43;color:#fff;font-weight:800;font-size:16px;text-decoration:none;box-shadow:0 12px 26px #0006}
  .vn-hero__btn:hover{background:#4fa437}
  .vn-hero__cd{font-size:14px;opacity:.85}
  .vn-hero__cd b{color:#c0de96}
  @media(max-width:860px){.vn-hero__in{grid-template-columns:1fr;gap:22px;padding:30px 18px;text-align:center}.vn-hero__moon{width:150px}.vn-hero__steps,.vn-hero__cta{justify-content:center}}
</style>
<script>
  (function () {
    var INI = Date.parse('2026-11-12T00:00:00-03:00'), FIM = Date.parse('2026-11-19T23:59:59-03:00');
    var prev = false; try { if (/[?&]vf_vn=on/.test(location.search)) sessionStorage.setItem('vf_vn', '1'); prev = sessionStorage.getItem('vf_vn') === '1'; } catch (e) {}
    function liga() {
      var agora = Date.now(); if (!prev && (agora < INI || agora > FIM)) return;
      document.querySelectorAll('[data-vn]').forEach(function (el) { el.hidden = false; });
      var tick = function () {
        var s = Math.max(0, Math.floor((FIM - Date.now()) / 1000)), d = Math.floor(s / 86400), h = Math.floor(s % 86400 / 3600), m = Math.floor(s % 3600 / 60);
        var t = d > 0 ? d + 'd ' + h + 'h' : h + 'h ' + (m < 10 ? '0' : '') + m + 'min';
        document.querySelectorAll('[data-vn-cd]').forEach(function (el) { el.textContent = t; });
      };
      tick(); setInterval(tick, 30000);
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', liga); else liga();
  })();
</script>
{%- endunless -%}
