.vn-faq details[open] summary:after{content:'–'}
.vn-faq p{margin-top:10px!important;color:#cfdcd3;font-size:14.5px;line-height:1.55}
.vn-fine{padding:14px 16px 26px;text-align:center;color:#6f8a7c;font-size:12px;background:var(--ink)}
@media(max-width:860px){
  .vn-hero .vn-wrap{grid-template-columns:1fr;padding:28px 18px 40px;gap:22px;text-align:center}
  .vn-hero .vn-vis{order:-1}
  .vn-hero .vn-esc{height:200px;max-width:340px}
  .vn-esc li b{font-size:32px}
  .vn-sub{margin:14px auto 20px!important;font-size:16px}
  .vn-cta{justify-content:center}.vn-cta .vn-btn{width:100%}
  .vn-sec{padding:40px 18px}
  .vn-head{text-align:center;justify-content:center}
  .vn-mt-grid{grid-template-columns:1fr;border-radius:22px}
  .vn-mt-list{border-right:0}
  .vn-mt-row{grid-template-columns:112px minmax(0,1fr);grid-template-areas:"im info" "im q" "im more";column-gap:14px;row-gap:10px;padding:18px 14px 18px 12px}
  .vn-mt-im{width:112px;height:112px;border-radius:18px}
  .vn-mt-tag{font-size:9px;padding:3px 7px}
  .vn-mt-t{display:none}.vn-mt-n{font-size:17px}.vn-mt-3x{font-size:21px}.vn-mt-pix{font-size:12.5px}
  .vn-mt-q{justify-self:start;height:44px}.vn-mt-q button{width:40px;font-size:20px}
  .vn-mt-more{margin-top:0;padding:7px 13px;font-size:12.5px}
  .vn-mt-sum{padding:20px 16px}
  .vn-mt-big b{font-size:32px}
  .vn-rail figure{flex-basis:150px}
  .vn-faq{grid-template-columns:1fr}
  .vn-trilho{font-size:12px;gap:8px 18px}
  .vn-dias i{width:26px;height:26px;font-size:10px}
}
</style>
<div class="vn vn-x" data-vn hidden>
  <section class="vn-hero">
  <div class="vn-wrap">
      <div>
        <p class="vn-kick"><span>Verme November</span> 12 a 19/11 · dia <b data-vn-dia>1</b> de 8</p>
        <h1 class="cap">Em novembro, a família <em class="l">desparasita junta.</em></h1>
        <p class="vn-sub">Quanto mais protocolos, maior o desconto: <b>10%</b> em qualquer um, <b>12%</b> levando 3 e <b>15%</b> levando 5. Frete grátis acima de R$ 299 e 3x sem juros. São só 8 dias.</p>
        <div class="vn-cta"><a class="vn-btn" href="#vn-monte">Montar meu pedido →</a><span class="vn-left">termina em <b data-vn-th>--</b></span></div>
      </div>
      <div class="vn-vis">
        <ol class="vn-esc" aria-label="Escada de desconto">
          <li><b>10%</b><small>1 protocolo</small></li>
          <li><b>12%</b><small>3 ou mais</small></li>
          <li class="on"><b>15%</b><small>5 ou mais</small></li>
        </ol>
        <div class="vn-dias" data-vn-dias aria-hidden="true">{%- for d in (12..19) -%}<i>{{ d }}</i>{%- endfor -%}</div>
        <p>os 8 dias do Verme November</p>
      </div>
  </div>
  </section>

  <section class="vn-sec vn-monte" id="vn-monte"><div class="vn-wrap">
  <div class="vn-head">
      <h2 class="cap">Monte o pedido da casa. <em>Cada degrau, mais desconto.</em></h2>
      <p>Escolha quantos de cada. Pode misturar: conta o total do carrinho. Com 3, o desconto vira 12%; com 5, 15% em tudo.</p>
  </div>
  {%- assign ages = 'A partir de 10 anos|Crianças pequenas|Idade escolar|Para a casa toda' | split: '|' -%}
  {%- assign descs = 'Tintura de 5 ervas, Óleo de Orégano, Ornitina e Silimarina.|Duas tinturas com a dose da idade, diluídas em água ou suco.|Duas tinturas com a dose para a criança em idade escolar.|2 Adultos + Kids 2 a 4 + Kids 5 a 9, todo mundo no mesmo ciclo.' | split: '|' -%}
  {%- assign pngs = 'vf-pv2-adulto.png,vf-pv2-kids-2a4.png,vf-pv2-kids-5a9.png,vf-pv2-kit-familia-v3.png' | split: ',' -%}
  <div class="vn-mt-grid" data-vn-mt>
      <ul class="vn-mt-list">
        {%- for h in handles -%}
          {%- assign p = all_products[h] -%}
          {%- if p.id -%}
            {%- assign v = p.selected_or_first_available_variant -%}
            {%- assign pk = pngs[forloop.index0] -%}{%- assign png = images[pk] -%}
            {%- assign por = v.price | times: 0.9 -%}
            <li class="vn-mt-row{% if forloop.first %} on{% endif %}" data-vn-row data-id="{{ v.id }}" data-preco="{{ v.price }}">
              <a class="vn-mt-im" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
                {%- if forloop.first -%}<span class="vn-mt-tag">Mais escolhido</span>{%- endif -%}
                {%- if png -%}{{ png | image_url: width: 400 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{{ p.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
              </a>
              <div class="vn-mt-info">
                <p class="vn-mt-age">{{ ages[forloop.index0] }}</p>
                <h3 class="vn-mt-n"><a href="{{ p.url }}">{{ nomes[forloop.index0] }} ›</a></h3>
                <p class="vn-mt-t">{{ descs[forloop.index0] }}</p>
                <p class="vn-mt-was"><s>{{ v.price | money }}</s> <i>-10%</i></p>
                <p class="vn-mt-3x"><small>3x</small> {{ por | divided_by: 3 | money }}</p>
                <p class="vn-mt-pix">sem juros · ou <b>{{ por | money }}</b> à vista · até <b>15% OFF</b> levando 5</p>
              </div>
              <a class="vn-mt-more" href="{{ p.url }}">Conhecer o protocolo →</a>
              <div class="vn-mt-q" role="group" aria-label="Quantidade de {{ nomes[forloop.index0] }}">
                <button type="button" data-vn-step="-1" aria-label="Menos">−</button>
                <output data-vn-qty>{% if forloop.first %}1{% else %}0{% endif %}</output>
                <button type="button" data-vn-step="1" aria-label="Mais">+</button>
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      <div class="vn-mt-sum">
        <div class="vn-pg">
          <p data-vn-next></p>
          <div class="vn-tr"><span class="bg"></span><span class="fl" data-vn-fill></span>
            <ol class="vn-ms"><li data-vn-ms="0"><i>🌿</i><b>10% OFF</b><small>1 protocolo</small></li><li data-vn-ms="1"><i>🚚</i><b>Frete grátis</b><small>acima de R$ 299</small></li><li data-vn-ms="2"><i>💚</i><b>12% OFF</b><small>3 protocolos</small></li><li data-vn-ms="3"><i>🏆</i><b>15% OFF</b><small>5 protocolos</small></li><li data-vn-ms="4"><i>🎁</i><b>Kit adulto</b><small>acima de R$ 1.000</small></li></ol>
          </div>
        </div>
        <div class="vn-mt-tot">
          <p class="vn-mt-tl"><span data-vn-count>—</span><s data-vn-was></s></p>
          <p class="vn-mt-big"><small>3x</small> <b data-vn-3x>—</b> <span>sem juros</span></p>
          <p class="vn-mt-pixt" data-vn-pix></p>
        </div>
        <button type="button" class="vn-btn vn-mt-btn" data-vn-go>Garantir meu protocolo →</button>
        <div class="vn-eta" data-vn-eta>
          <div><span><svg viewBox="0 0 24 24"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2 3h3l2.6 12.4a1.5 1.5 0 0 0 1.5 1.1h8.8a1.5 1.5 0 0 0 1.5-1.1L21 7H6"/></svg></span><b data-eta="0"></b><small>Pedido feito</small></div>
          <div><span><svg viewBox="0 0 24 24"><path d="M2 6h12v10H2zM14 9h4l4 4v3h-8"/><circle cx="6.5" cy="18" r="2"/><circle cx="17.5" cy="18" r="2"/></svg></span><b data-eta="1"></b><small>Despachado</small></div>
          <div><span><svg viewBox="0 0 24 24"><path d="M21 8l-9-5-9 5v8l9 5 9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/></svg></span><b data-eta="2"></b><small>Chega na sua casa</small></div>
        </div>
        <p class="vn-mt-note">🔒 Compra segura · Desconto automático no carrinho · Até 19/11</p>
      </div>
  </div>
  </div></section>

  <div class="vn-trilho"><span>Até 15% OFF em tudo</span><span>Frete grátis acima de R$ 299</span><span>🎁 Kit adulto de presente acima de R$ 1.000</span><span>3x sem juros</span><span>Desconto automático, sem cupom</span></div>

  <section class="vn-sec"><div class="vn-wrap">
  <div class="vn-head"><h2 class="cap">Quem fez, <em>conta.</em></h2><p>Famílias que já passaram pelo protocolo. Toque no vídeo para ouvir.</p></div>
  <div class="vn-rail">
      {%- assign vids = 'daniela-3-perguntas,jessika-abre-kit-adulto,juliana-kids-embalagem,ester-kids-2-4' | split: ',' -%}
      {%- assign depos = '04,05,06,07' | split: ',' -%}
      {%- for i in (0..3) -%}
        {%- assign dep = shop.metaobjects.vf_depoimento[vids[i]] -%}
        {%- assign vv = dep.video.value -%}
        {%- if vv -%}
          {%- assign src = '' -%}
          {%- for s in vv.sources -%}{%- if src == '' and s.mime_type == 'video/mp4' -%}{%- assign src = s.url -%}{%- endif -%}{%- endfor -%}
          <figure class="is-v" data-vn-video><video src="{{ src }}" poster="{{ vv.preview_image | image_url: width: 400 }}" muted loop playsinline preload="none"></video><span class="snd">🔇</span><figcaption>{{ dep.nome.value }}</figcaption></figure>
        {%- endif -%}
        {%- assign stk = 'vf-depoimento-' | append: depos[i] | append: '.jpg' -%}{%- assign st = images[stk] -%}
        {%- if st -%}<figure>{{ st | image_url: width: 500 | image_tag: loading: 'lazy', alt: 'Cliente VermeFree com o protocolo' }}</figure>{%- endif -%}
      {%- endfor -%}
  </div>
  </div></section>
</div>
<div data-vn-cur-slot></div>
<div class="vn vn-x" data-vn hidden>
  <section class="vn-sec" style="background:var(--ink2)"><div class="vn-wrap">
  <div class="vn-head"><h2 class="cap">Perguntas <em>do Verme November.</em></h2><p>Tudo o que vale de 12 a 19/11, sem letra miúda.</p></div>
  <div class="vn-faq">
      <details open><summary>Como funciona a escada de desconto?</summary><p>Qualquer pedido tem 10% OFF. Com 3 ou mais itens no carrinho, o desconto vira 12% em tudo. Com 5 ou mais, 15% em tudo. Vale sempre a maior faixa.</p></details>
      <details><summary>Posso misturar protocolos?</summary><p>Pode. Conta o total de itens do carrinho: Adulto, Kids e Kit Família entram na mesma conta.</p></details>
      <details><summary>Preciso de cupom?</summary><p>Não. O desconto entra sozinho no carrinho, de acordo com a quantidade.</p></details>
      <details><summary>Tem brinde?</summary><p>Sim. Nos pedidos acima de R$ 1.000 (valor dos produtos já com desconto, de 12 a 19/11), você ganha 1 kit adulto de presente, enviado junto com o pedido.</p></details>
      <details><summary>O frete é grátis?</summary><p>Sim, para pedidos a partir de R$ 299.</p></details>
      <details><summary>Dá para parcelar?</summary><p>Sim, em até 3x sem juros no cartão.</p></details>
      <details><summary>Até quando vale?</summary><p>Até 19/11 às 23h59, horário de Brasília. Depois disso, os preços voltam ao normal.</p></details>
  </div>
  </div></section>

  <section class="vn-fim">
  <div class="vn-dias" data-vn-dias aria-hidden="true">{%- for d in (12..19) -%}<i>{{ d }}</i>{%- endfor -%}</div>
  <h2 class="cap">O Verme November termina em <em class="l" data-vn-th>--</em>.</h2>
  <p>Depois disso, o desconto de 15% para a casa toda só no ano que vem.</p>
  <a class="vn-btn" href="#vn-monte">Montar meu pedido →</a>
  </section>
  <p class="vn-fine">De 12/11 00h a 19/11 23h59 (horário de Brasília). Descontos aplicados automaticamente no carrinho; as faixas não somam entre si, vale a maior. Frete grátis para pedidos a partir de R$ 299.</p>
</div>
<script>
  (function () {
  var brl = function (c) { return 'R$ ' + (c / 100).toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.'); };
  var pct = function (n) { return n >= 5 ? 15 : n >= 3 ? 12 : n >= 1 ? 10 : 0; };
  var mt = document.querySelector('[data-vn-mt]');
  if (mt) {
      var rows = [].slice.call(mt.querySelectorAll('[data-vn-row]')), go = mt.querySelector('[data-vn-go]');
      var $m = function (q) { return mt.querySelector(q); };
      var qty = function (r) { return +r.querySelector('[data-vn-qty]').textContent || 0; };
      var setQ = function (r, n) { n = Math.max(0, Math.min(10, n)); r.querySelector('[data-vn-qty]').textContent = n; r.classList.toggle('on', n > 0); };
      var desenha = function () {
        var n = 0, cheio = 0;
        rows.forEach(function (r) { n += qty(r); cheio += qty(r) * +r.dataset.preco; });
        var d = pct(n), paga = Math.round(cheio * (100 - d) / 100);
        $m('[data-vn-count]').textContent = n === 0 ? 'Nenhum protocolo escolhido' : n + (n === 1 ? ' protocolo' : ' protocolos') + ' · ' + d + '% OFF';
        $m('[data-vn-was]').textContent = n ? brl(cheio) : '';
        $m('[data-vn-3x]').textContent = brl(Math.floor(paga / 3));
        $m('[data-vn-pix]').innerHTML = n === 0 ? 'Escolha acima quantos de cada' : 'ou <b>' + brl(paga) + '</b> à vista · <em>você economiza ' + brl(cheio - paga) + '</em>';
        var kit = paga > 100000, pr = [Math.min(1, n), Math.min(1, paga / 29900), Math.min(1, n / 3), Math.min(1, n / 5), kit ? 1 : Math.min(.99, paga / 100000)], lab = ['10% OFF', 'frete grátis', '12% OFF', '15% OFF', 'o kit adulto de presente'];
        mt.querySelectorAll('[data-vn-ms]').forEach(function (li, i) { li.classList.toggle('on', pr[i] >= 1); });
        var nx = pr.findIndex(function (x) { return x < 1; });
        $m('[data-vn-fill]').style.width = (nx < 0 ? 100 : nx === 0 ? 0 : (nx - 1 + pr[nx]) / 4 * 100) + '%';
        var q = nx === 2 ? 3 - n : 5 - n, pl = function (k) { return k + (k === 1 ? ' protocolo' : ' protocolos'); };
        $m('[data-vn-next]').innerHTML = nx === 0 ? 'Escolha um protocolo e libere <b>10% OFF</b>' : nx === 1 ? 'Faltam <b>' + brl(29900 - paga) + '</b> para o <b>frete grátis</b>' : nx === 4 ? 'Faltam <b>' + brl(100001 - paga) + '</b> para ganhar <b>o kit adulto de presente</b>' : nx > 1 ? 'Mais <b>' + pl(q) + '</b> e você libera <b>' + lab[nx] + '</b>' + (kit ? ' · 🎁 <b>kit adulto garantido</b>' : '') : '🎉 <b>Tudo liberado:</b> 15% OFF, frete grátis e kit adulto de presente';
        go.disabled = n === 0;
        go.textContent = n <= 1 ? 'Garantir meu protocolo →' : 'Garantir meus ' + n + ' protocolos →';
      };
      mt.addEventListener('click', function (e) {
        var st = e.target.closest('[data-vn-step]');
        if (st) { var r = st.closest('[data-vn-row]'); setQ(r, qty(r) + +st.dataset.vnStep); desenha(); return; }
        var row = e.target.closest('[data-vn-row]');
        if (row && !e.target.closest('a, button') && qty(row) === 0) { setQ(row, 1); desenha(); }
      });
      go.addEventListener('click', function () {
        var items = rows.filter(function (r) { return qty(r) > 0; }).map(function (r) { return { id: +r.dataset.id, quantity: qty(r) }; });
        if (!items.length) return;
        go.disabled = true; go.textContent = 'Colocando...';
        fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: items }) })
          .then(function (res) { if (!res.ok) throw 0; location.href = '/cart'; }).catch(function () { desenha(); });
      });
      desenha();
  }
  var poeCur = function () { if (!document.documentElement.classList.contains('vn-on')) return; var cur = document.querySelector('[id$="__vf_curadoria"]'), slot = document.querySelector('[data-vn-cur-slot]'); if (cur && slot) slot.appendChild(cur); };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', poeCur); else poeCur();
  var vs = document.querySelectorAll('[data-vn-video]');
  if ('IntersectionObserver' in window) { var io = new IntersectionObserver(function (es) { es.forEach(function (e) { var v = e.target.querySelector('video'); if (e.isIntersecting) v.play().catch(function () {}); else v.pause(); }); }, { threshold: .6 }); vs.forEach(function (f) { io.observe(f); }); }
  vs.forEach(function (f) { f.addEventListener('click', function () { var v = f.querySelector('video'), on = v.muted; vs.forEach(function (o) { o.querySelector('video').muted = true; o.querySelector('.snd').textContent = '🔇'; }); v.muted = !on; f.querySelector('.snd').textContent = on ? '🔊' : '🔇'; if (on) v.play().catch(function () {}); }); });
  })();
</script>
{%- endif -%}
