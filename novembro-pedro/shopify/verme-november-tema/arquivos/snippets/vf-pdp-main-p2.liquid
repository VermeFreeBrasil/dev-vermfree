          {%- if section.settings.kits_enabled -%}
            <div class="vf-pdp__kits" role="radiogroup" aria-label="Escolha a quantidade de kits">
              {%- if section.settings.kits_socialproof_enabled -%}
                <div class="vf-pdp__kits-social">
                  <span class="vf-pdp__kits-stars" aria-hidden="true">★★★★★</span>
                  {%- if section.settings.kits_socialproof_text != blank -%}
                    <span class="vf-pdp__kits-social-text">{{ section.settings.kits_socialproof_text }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if section.settings.kits_legend != blank -%}
                <p class="vf-pdp__kits-legend">{{ section.settings.kits_legend }} <strong id="vf-pdp-kits-legend-value">{{ section.settings.tier1_title }}</strong></p>
              {%- endif -%}

              {%- comment -%} Escada crescente (1/2/3) nos protocolos, com 1 Kit pré-selecionado {%- endcomment -%}
              {%- assign kit_is_protocol = false -%}
              {%- assign kit_proto_handles = 'protocolo-desparasitacao-adulto-vermefree,antiparasitario-infantil-natural-vermefree-kids-2-a-4-anos,antiparasitario-infantil-natural-vermefree-kids-5-a-9-anos' | split: ',' -%}
              {%- if kit_proto_handles contains product.handle -%}{%- assign kit_is_protocol = true -%}{%- endif -%}

              {%- if kit_is_protocol -%}
                <div class="vf-pdp__kitbar" id="vf-pdp-kitbar">
                  <div class="vf-pdp__kitbar-track"><div class="vf-pdp__kitbar-fill" id="vf-pdp-kitbar-fill"></div></div>
                  <p class="vf-pdp__kitbar-msg" id="vf-pdp-kitbar-msg"></p>
                </div>
              {%- endif -%}

              <div class="vf-pdp__kits-grid" id="vf-pdp-kits-grid">
                {%- if kit_is_protocol -%}
                  {%- assign kit_proto_qtys = '1,3,5' | split: ',' -%}
                  {%- comment -%} 25/10: descontos automáticos da loja valem para Adulto e Kids, misturando: 2 kits 5% ("5% OFF · 2 Kits VermeFree"), 3+ kits 10% ("10% OFF · 3+ Kits VermeFree"). {%- endcomment -%}
                  {%- assign kit_proto_discs = '10,12,15' | split: ',' -%}
                  {%- assign kit_proto_titles = '1 Kit,3 Kits,5 Kits' | split: ',' -%}
                  {%- for idx in (0..2) -%}
                    {%- assign t_qty = kit_proto_qtys[idx] | plus: 0 -%}
                    {%- assign t_disc = kit_proto_discs[idx] | plus: 0 -%}
                    {%- assign t_title = kit_proto_titles[idx] -%}
                    {%- assign t_total = unit_price_cents | times: t_qty -%}
                    {%- assign t_disc_amt = unit_price_cents | times: t_disc | divided_by: 100 | times: t_qty -%}
                    {%- assign t_price = t_total | minus: t_disc_amt -%}
                    {%- assign t_installment = t_price | plus: 1 | divided_by: 3 -%}
                    {%- assign t_badge1 = '' -%}
                    {%- assign t_badge2 = '' -%}
                    {%- assign t_msg = '' -%}
                    {%- if t_qty == 5 -%}
                      {%- assign t_badge1 = 'Mais vantajoso' -%}
                      {%- assign t_badge2 = 'Frete grátis' -%}
                      {%- assign t_msg = 'Seu ano de cuidado natural, planejado 🌙' -%}
                    {%- elsif t_qty == 3 -%}
                      {%- assign t_badge2 = 'Frete grátis' -%}
                    {%- endif -%}
                    <div class="vf-pdp__kit-card{% if forloop.first %} is-active{% endif %}" data-qty="{{ t_qty }}" data-discount="{{ t_disc }}" role="radio" aria-checked="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="0">
                      {%- if t_badge1 != blank or t_badge2 != blank -%}
                        <div class="vf-pdp__kit-badges">
                          {%- if t_badge1 != blank -%}<span class="vf-pdp__kit-badge vf-pdp__kit-badge--1">{{ t_badge1 }}</span>{%- endif -%}
                          {%- if t_badge2 != blank -%}<span class="vf-pdp__kit-badge vf-pdp__kit-badge--2">{{ t_badge2 }}</span>{%- endif -%}
                        </div>
                      {%- endif -%}
                      <div class="vf-pdp__kit-row">
                        <span class="vf-pdp__kit-radio" aria-hidden="true"></span>
                        <div class="vf-pdp__kit-image">
                          {%- assign pdp_thumb = pdp_main | default: product.featured_image -%}
                          {%- if pdp_thumb != blank -%}<img src="{{ pdp_thumb | image_url: width: 200 }}" alt="{{ t_title | escape }}" loading="lazy">{%- else -%}<div class="vf-pdp__kit-image-ph"></div>{%- endif -%}
                        </div>
                        <div class="vf-pdp__kit-info">
                          <span class="vf-pdp__kit-title">{{ t_title }}</span>
                          <div class="vf-pdp__kit-pricing">
                            <span class="vf-pdp__kit-installments-label">3x de</span>
                            <span class="vf-pdp__kit-installment-value" data-installment>{{ t_installment | money }}</span>
                          </div>
                          <div class="vf-pdp__kit-cash">
                            <span class="vf-pdp__kit-cash-or">ou</span>
                            <span class="vf-pdp__kit-cash-value" data-total>{{ t_price | money }}</span>
                            <span class="vf-pdp__kit-cash-label">à vista</span>
                            {%- if t_disc > 0 -%}<s class="vf-pdp__kit-compare" data-compare>{{ t_total | money }}</s>{%- endif -%}
                          </div>
                          {%- if t_disc > 0 -%}<span class="vf-pdp__kit-discount">{{ t_disc }}% OFF · você economiza <span data-save>{{ t_disc_amt | money }}</span></span>{%- endif -%}
                        </div>
                      </div>
                      {%- if t_msg != blank -%}<div class="vf-pdp__kit-message">{{ t_msg }}</div>{%- endif -%}
                    </div>
                  {%- endfor -%}
                {%- else -%}
                {%- for i in (1..4) -%}
                  {%- assign tier_key = i | prepend: 'tier' -%}
                  {%- assign enabled_key = tier_key | append: '_enabled' -%}
                  {%- if section.settings[enabled_key] -%}
                    {%- assign qty_key = tier_key | append: '_quantity' -%}
                    {%- assign disc_key = tier_key | append: '_discount' -%}
                    {%- assign title_key = tier_key | append: '_title' -%}
                    {%- assign image_key = tier_key | append: '_image' -%}
                    {%- assign badge1_key = tier_key | append: '_badge1' -%}
                    {%- assign badge2_key = tier_key | append: '_badge2' -%}
                    {%- assign msg_key = tier_key | append: '_message' -%}

                    {%- assign t_qty = section.settings[qty_key] -%}
                    {%- assign t_disc = section.settings[disc_key] -%}
                    {%- assign t_image = section.settings[image_key] -%}
                    {%- assign t_total = unit_price_cents | times: t_qty -%}
                    {%- assign t_disc_amt = unit_price_cents | times: t_disc | divided_by: 100 | times: t_qty -%}
                    {%- assign t_price = t_total | minus: t_disc_amt -%}
                    {%- assign t_installment = t_price | plus: 1 | divided_by: 3 -%}
                    {%- assign t_badge2 = section.settings[badge2_key] -%}
                    {%- assign has_badges = false -%}
                    {%- if section.settings[badge1_key] != blank or t_badge2 != blank -%}
                      {%- assign has_badges = true -%}
                    {%- endif -%}

                    <div
                      class="vf-pdp__kit-card{% if forloop.first %} is-active{% endif %}"
                      data-qty="{{ t_qty }}"
                      data-discount="{{ t_disc }}"
                      role="radio"
                      aria-checked="{% if forloop.first %}true{% else %}false{% endif %}"
                      tabindex="0"
                    >
                      {%- if has_badges -%}
                        <div class="vf-pdp__kit-badges">
                          {%- if section.settings[badge1_key] != blank -%}
                            <span class="vf-pdp__kit-badge vf-pdp__kit-badge--1">{{ section.settings[badge1_key] }}</span>
                          {%- endif -%}
                          {%- if t_badge2 != blank -%}
                            <span class="vf-pdp__kit-badge vf-pdp__kit-badge--2">{{ t_badge2 }}</span>
                          {%- endif -%}
                        </div>
                      {%- endif -%}

                      <div class="vf-pdp__kit-row">
                        <span class="vf-pdp__kit-radio" aria-hidden="true"></span>

                        <div class="vf-pdp__kit-image">
                          {%- if t_image != blank -%}
                            <img src="{{ t_image | image_url: width: 200 }}" alt="{{ section.settings[title_key] | escape }}" loading="lazy">
                          {%- elsif pdp_main != blank or product.featured_image != blank -%}
                            <img src="{{ pdp_main | default: product.featured_image | image_url: width: 200 }}" alt="{{ section.settings[title_key] | escape }}" loading="lazy">
                          {%- else -%}
                            <div class="vf-pdp__kit-image-ph"></div>
                          {%- endif -%}
                        </div>

                        <div class="vf-pdp__kit-info">
                          <span class="vf-pdp__kit-title">{{ section.settings[title_key] }}</span>

                          <div class="vf-pdp__kit-pricing">
                            <span class="vf-pdp__kit-installments-label">3x de</span>
                            <span class="vf-pdp__kit-installment-value" data-installment>{{ t_installment | money }}</span>
                          </div>
                          <div class="vf-pdp__kit-cash">
                            <span class="vf-pdp__kit-cash-or">ou</span>
                            <span class="vf-pdp__kit-cash-value" data-total>{{ t_price | money }}</span>
                            <span class="vf-pdp__kit-cash-label">à vista</span>
                            {%- if t_disc > 0 -%}
                              <s class="vf-pdp__kit-compare" data-compare>{{ t_total | money }}</s>
                            {%- endif -%}
                          </div>

                          {%- if t_disc > 0 -%}
                            <span class="vf-pdp__kit-discount">{{ t_disc }}% OFF · você economiza <span data-save>{{ t_disc_amt | money }}</span></span>
                          {%- endif -%}
                        </div>
                      </div>

                      {%- if section.settings[msg_key] != blank -%}
                        <div class="vf-pdp__kit-message">{{ section.settings[msg_key] }}</div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

          {%- comment -%}
            COMPLEMENTO ÓLEO DE ALHO — o Óleo não é vendido sozinho no site.
            Ele entra aqui, marcado pela pessoa, junto com o protocolo.
            O desconto "Order Bump · Óleo 15%" aplica sozinho no checkout
            quando há protocolo no carrinho (1 por pedido).
          {%- endcomment -%}
          {%- assign vf_oleo = all_products['oleo-de-alho-desodorizado-500mg'] -%}
          {%- if section.settings.oleo_addon_enabled and vf_oleo != blank and vf_oleo.available and product.handle != vf_oleo.handle -%}
            {%- assign vf_oleo_var = vf_oleo.selected_or_first_available_variant -%}
            {%- assign vf_oleo_off = vf_oleo_var.price | times: 85 | divided_by: 100 -%}
            <label class="vf-pdp__addon" for="vf-addon-oleo">
              <input type="checkbox" id="vf-addon-oleo" class="vf-pdp__addon-check" data-variant-id="{{ vf_oleo_var.id }}">
              <span class="vf-pdp__addon-box" aria-hidden="true"></span>
              {%- if vf_oleo.featured_image != blank -%}
                <img class="vf-pdp__addon-img" src="{{ vf_oleo.featured_image | image_url: width: 160 }}" alt="Óleo de Alho VermeFree" width="56" height="56" loading="lazy">
              {%- endif -%}
              <span class="vf-pdp__addon-copy">
                <strong>{{ section.settings.oleo_addon_title }}</strong>
                <small>{{ section.settings.oleo_addon_text }}</small>
                <span class="vf-pdp__addon-price"><s>{{ vf_oleo_var.price | money }}</s> {{ vf_oleo_off | money }} <em>com o protocolo</em></span>
              </span>
            </label>
            <script>
              (function () {
                var form = document.currentScript.closest('form');
                var cb = document.getElementById('vf-addon-oleo');
                if (!form || !cb) return;
                form.addEventListener('submit', function (e) {
                  if (!cb.checked) return;
                  e.preventDefault();
                  var id = parseInt(form.querySelector('[name="id"]').value, 10);
                  var qty = parseInt((form.querySelector('[name="quantity"]') || {}).value || '1', 10);
                  fetch('{{ routes.cart_add_url }}.js', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    body: JSON.stringify({ items: [
                      { id: id, quantity: qty },
                      { id: parseInt(cb.getAttribute('data-variant-id'), 10), quantity: 1 }
                    ] })
                  }).then(function (r) {
                    if (!r.ok) throw new Error('add');
                    window.location.href = '{{ routes.cart_url }}';
                  }).catch(function () {
                    cb.checked = false;
                    form.submit();
                  });
                });
              })();
            </script>
          {%- endif -%}

          {%- comment -%} 25/10: bloco de compra novo (parcela em destaque) nos protocolos; o botão antigo (p3) fica escondido {%- endcomment -%}
          {%- if kit_is_protocol -%}{% include 'vf-pdp-buy-c' %}{%- endif -%}
