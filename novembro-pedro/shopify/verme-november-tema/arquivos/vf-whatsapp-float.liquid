{%- comment -%}
  vf-whatsapp-float.liquid — Botão flutuante de WhatsApp (permanente, site-wide)
  Renderizado no layout/theme.liquid. Abre conversa com o atendimento com uma
  mensagem pré-preenchida. Copy ANVISA-safe (sem claim de cura/parasita).
  Formato "pílula": ícone + "Dúvidas? / Fale com a farmacêutica".
  - Aparece depois que a pessoa rola um pouco (não cobre o preço do topo).
  - Sobe sozinho acima de barras fixas de compra (barra do produto, montador, barras .ve-stick do Eclipse e .vn-stick da Verme November/Week).
  CONFIG: edite as 2 linhas abaixo (telefone com DDI+DDD, e mensagem).
{%- endcomment -%}
{%- assign WA_PHONE = '553131573845' -%}
{%- assign WA_MSG = 'Olá! Tenho uma dúvida sobre o protocolo VermeFree 🌿' -%}

<a class="vf-wafloat"
   href="https://wa.me/{{ WA_PHONE }}?text={{ WA_MSG | url_encode }}"
   target="_blank" rel="noopener"
   aria-label="Dúvidas? Fale com a farmacêutica no WhatsApp">
  <span class="vf-wafloat__ico" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35zM12.04 21.5h-.01a9.45 9.45 0 0 1-4.82-1.32l-.35-.21-3.58.94.96-3.49-.23-.36a9.43 9.43 0 0 1-1.45-5.03c0-5.22 4.25-9.47 9.48-9.47 2.53 0 4.91.99 6.7 2.78a9.42 9.42 0 0 1 2.77 6.7c0 5.23-4.25 9.46-9.47 9.46zm8.06-17.53A11.3 11.3 0 0 0 12.04.63C5.76.63.66 5.73.66 12c0 2 .52 3.96 1.52 5.69L.57 23.5l5.95-1.56a11.37 11.37 0 0 0 5.52 1.4h.01c6.27 0 11.38-5.1 11.38-11.37 0-3.04-1.18-5.9-3.33-8.05z"/></svg>
  </span>
  <span class="vf-wafloat__txt"><b>Dúvidas?</b><small>Fale com a farmacêutica</small></span>
</a>

<script>
  (function () {
    var el = document.querySelector('.vf-wafloat');
    if (!el) return;
    var ticking = false;
    function lift() {
      /* Altura da barra fixa de compra que estiver encostada no rodapé da tela. */
      var h = 0, vh = window.innerHeight, vw = window.innerWidth;
      document.querySelectorAll('[id*="sticky"],[class*="sticky"],[class*="bar"],[class*="Bar"],.ve-stick,.vn-stick').forEach(function (b) {
        if (b === el || el.contains(b)) return;
        var s = getComputedStyle(b);
        if (s.position !== 'fixed' || s.display === 'none' || s.visibility === 'hidden' || +s.opacity === 0) return;
        var r = b.getBoundingClientRect();
        if (r.width < vw * .8 || r.height < 30 || r.height > 220 || r.bottom < vh - 2 || r.top >= vh) return;
        h = Math.max(h, vh - r.top);
      });
      el.style.setProperty('--vf-wa-lift', h + 'px');
      el.classList.toggle('is-on', window.scrollY > 320);
      ticking = false;
    }
    function req() { if (!ticking) { ticking = true; requestAnimationFrame(lift); } }
    window.addEventListener('scroll', req, { passive: true });
    window.addEventListener('resize', req);
    setInterval(req, 1200);
    req();
  })();
</script>

{% stylesheet %}
  .vf-wafloat{ position:fixed; right:12px; bottom:calc(var(--vf-wa-lift, 0px) + 12px); z-index:9998; display:flex; align-items:center; gap:9px; padding:6px 14px 6px 6px; border-radius:999px; background:#fff; border:1px solid #E3EEDC; box-shadow:0 6px 20px rgba(0,30,10,.22); color:#1A1A1A; text-decoration:none; font-family:Inter, system-ui, sans-serif; opacity:0; transform:translateY(12px); pointer-events:none; transition:opacity .25s ease, transform .25s ease, bottom .2s ease; }
  .vf-wafloat.is-on{ opacity:1; transform:none; pointer-events:auto; }
  .vf-wafloat__ico{ position:relative; width:38px; height:38px; border-radius:50%; background:#25D366; color:#fff; display:flex; align-items:center; justify-content:center; flex:0 0 auto; }
  .vf-wafloat__ico::after{ content:""; position:absolute; inset:0; border-radius:50%; animation:vf-wa-pulse 2.4s infinite; }
  .vf-wafloat__txt{ display:flex; flex-direction:column; line-height:1.15; }
  .vf-wafloat__txt b{ font-size:13px; font-weight:800; color:#1B5E20; }
  .vf-wafloat__txt small{ font-size:11.5px; font-weight:500; color:#55655A; }
  .vf-wafloat:hover{ box-shadow:0 8px 24px rgba(0,30,10,.28); }
  .vf-wafloat:focus-visible{ outline:3px solid #128C7E; outline-offset:2px; }
  @keyframes vf-wa-pulse{ 0%{ box-shadow:0 0 0 0 rgba(37,211,102,.45) } 70%{ box-shadow:0 0 0 10px rgba(37,211,102,0) } 100%{ box-shadow:0 0 0 0 rgba(37,211,102,0) } }
  @media (min-width:990px){ .vf-wafloat{ right:22px; bottom:calc(var(--vf-wa-lift, 0px) + 22px); padding:7px 18px 7px 7px; } .vf-wafloat__ico{ width:42px; height:42px; } .vf-wafloat__txt b{ font-size:14px; } .vf-wafloat__txt small{ font-size:12.5px; } }
  @media (prefers-reduced-motion: reduce){ .vf-wafloat, .vf-wafloat__ico::after{ transition:none; animation:none; } }
{% endstylesheet %}
