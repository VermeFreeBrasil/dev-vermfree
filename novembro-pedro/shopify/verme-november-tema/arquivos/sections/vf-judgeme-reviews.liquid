{%- comment -%}
  vf-judgeme-reviews.liquid — Avaliações reais de clientes (Judge.me).
  Posição no PDP: depois de "Historias reais", antes do FAQ.
  Âncora de rolagem: #avaliacoes (estrelas do topo e barra sticky levam pra cá).

  Topo próprio da VermeFree: nota média, estrelas, distribuição 5★→1★
  e botão "Escreva uma avaliação".

  Fonte das avaliações (setting "source"):
  - Produto: dados do metafield judgeme.review_widget_data do produto e, abaixo,
    a lista do widget oficial do Judge.me (paginação, formulário, fotos) com o
    cabeçalho padrão dele escondido e o visual ajustado à marca.
  - Loja inteira: nota, total e distribuição de todas as avaliações publicadas
    (shop.metafields.judgeme.all_reviews_widget_v2025_data) e cards das mais
    recentes, cada um com o produto avaliado. É o que bate com o "Nota 4,9" da Home.
  - Automático (padrão): loja inteira na Home, produto nas outras páginas.
  Estilo em snippets/vf-judgeme-reviews-style.liquid.
  O widget de produto depende do app embed judgeme_core estar ativo no tema.
{%- endcomment -%}

{%- liquid
  if section.settings.product != blank
    assign product = section.settings.product
  endif

  assign fonte = section.settings.source | default: 'auto'
  if fonte == 'auto'
    if template.name == 'index'
      assign fonte = 'store'
    else
      assign fonte = 'product'
    endif
  endif
  if fonte == 'product' and product == blank
    assign fonte = 'store'
  endif

  if fonte == 'store'
    assign jdgm_data = shop.metafields.judgeme.all_reviews_widget_v2025_data.value
  else
    assign jdgm_data = product.metafields.judgeme.review_widget_data.value
  endif
  assign jdgm_count = 0
  assign jdgm_avg = 0
  if jdgm_data.number_of_reviews
    assign jdgm_count = jdgm_data.number_of_reviews | times: 1
    assign jdgm_avg = jdgm_data.average_rating | times: 1.0
  endif
  assign jdgm_avg_x10 = jdgm_avg | times: 10 | round
  assign jdgm_avg_int = jdgm_avg_x10 | divided_by: 10 | floor
  assign jdgm_avg_dec = jdgm_avg_x10 | modulo: 10
  assign jdgm_avg_display = jdgm_avg_int | append: ',' | append: jdgm_avg_dec
  if jdgm_count == 1
    assign jdgm_word = 'avaliação'
  else
    assign jdgm_word = 'avaliações'
  endif

  assign render_block = true
  if section.settings.hide_until_reviews and jdgm_count == 0
    assign render_block = false
  endif
-%}

{%- if render_block -%}
  <div
    class="vf-jdgm{% if section.settings.hide_jdgm_header %} vf-jdgm--custom-header{% endif %} vf-jdgm--{{ fonte }}{% if section.settings.compact %} vf-jdgm--compact{% endif %}"
    id="avaliacoes"
    data-vf-jdgm
  >
    <div class="vf-jdgm__inner">
      {%- if fonte == 'product' and section.settings.reward_banner != blank -%}
        <div class="vf-jdgm__banner" data-vf-jdgm-reward hidden>{{ section.settings.reward_banner }}</div>
      {%- endif -%}
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="vf-jdgm__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="vf-jdgm__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="vf-jdgm__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="vf-jdgm__sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
      {%- endif -%}

      {%- if section.settings.compact -%}
        {%- if jdgm_count > 0 -%}
          <p class="vf-jdgm__mini">
            <span class="visually-hidden">Nota média {{ jdgm_avg_display }} de 5.</span>
            <b aria-hidden="true">{{ jdgm_avg_display }}</b>
            {%- render 'vf-stars', rating: jdgm_avg, size: 17 -%}
          </p>
        {%- endif -%}
      {%- else -%}

      <div class="vf-jdgm__summary">
        {%- if jdgm_count > 0 -%}
          <div class="vf-jdgm__score">
            <span class="visually-hidden">Nota média {{ jdgm_avg_display }} de 5, com base em {{ jdgm_count }} {{ jdgm_word }}.</span>
            <span class="vf-jdgm__score-num" aria-hidden="true">{{ jdgm_avg_display }}</span>
            {%- render 'vf-stars', rating: jdgm_avg, size: 20 -%}
            <span class="vf-jdgm__score-count" aria-hidden="true">{{ jdgm_count }} {{ jdgm_word }}</span>
          </div>

          {%- if jdgm_data.histogram.size > 0 -%}
            <ul class="vf-jdgm__hist" aria-label="Distribuição das notas">
              {%- for row in jdgm_data.histogram -%}
                <li class="vf-jdgm__hist-row">
                  <span class="visually-hidden">{{ row.rating }} estrelas: {{ row.frequency }}</span>
                  <span class="vf-jdgm__hist-label" aria-hidden="true">
                    {{- row.rating -}}
                    <svg viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M12 2l3 7 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1z"/></svg>
                  </span>
                  <span class="vf-jdgm__hist-bar" aria-hidden="true">
                    <span style="width: {{ row.percentage }}%;"></span>
                  </span>
                  <span class="vf-jdgm__hist-count" aria-hidden="true">{{ row.frequency }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        {%- else -%}
          <div class="vf-jdgm__empty">
            {%- render 'vf-stars', rating: 0, size: 22 -%}
            <p>Ainda não há avaliações por aqui.</p>
          </div>
        {%- endif -%}

        {%- if section.settings.write_label != blank -%}
          <div class="vf-jdgm__cta">
            <p class="vf-jdgm__cta-title">Já fez o protocolo?</p>
            <p class="vf-jdgm__cta-text">Conta pra gente como foi. Sua avaliação ajuda outras famílias a decidir.</p>
            {%- if fonte == 'store' -%}
              <a class="vf-jdgm__write" href="{{ section.settings.write_url | default: '/products/protocolo-desparasitacao-adulto-vermefree#avaliacoes' }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                {{ section.settings.write_label | escape }}
              </a>
            {%- else -%}
              <button type="button" class="vf-jdgm__write" data-vf-jdgm-write>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                {{ section.settings.write_label | escape }}
              </button>
            {%- endif -%}
            {%- if section.settings.reward_text != blank -%}
              <p class="vf-jdgm__reward">{{ section.settings.reward_text }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
      {%- endif -%}

      {%- liquid
        if fonte == 'store'
          assign revs = jdgm_data.all_reviews
        else
          assign revs = jdgm_data.reviews
        endif

        comment
          Quais cards mostrar. Normal: todos. Compacto (Home): até "max_cards", na ordem em que
          vêm (mais recentes primeiro), priorizando avaliações de produto com texto de 60+ caracteres;
          completa com outras de 60+ caracteres e, se ainda faltar, com qualquer uma.
        endcomment
        assign sel = ','
        assign quem = '|'
        assign n_sel = 0
        if section.settings.compact
          assign max_cards = section.settings.max_cards
          for r in revs
            if n_sel >= max_cards
              break
            endif
            assign txt = r.body_html | strip_html | strip
            assign loja = false
            if r.is_shop_review == true or r.is_shop_review == 'True' or r.is_shop_review == 'true'
              assign loja = true
            endif
            assign nome = '|' | append: r.reviewer_name | append: '|'
            if loja == false and txt.size >= 60
              unless quem contains nome
                assign sel = sel | append: forloop.index0 | append: ','
                assign quem = quem | append: r.reviewer_name | append: '|'
                assign n_sel = n_sel | plus: 1
              endunless
            endif
          endfor
          for r in revs
            if n_sel >= max_cards
              break
            endif
            assign key = ',' | append: forloop.index0 | append: ','
            assign txt = r.body_html | strip_html | strip
            assign nome = '|' | append: r.reviewer_name | append: '|'
            unless sel contains key or quem contains nome
              if txt.size >= 60
                assign sel = sel | append: forloop.index0 | append: ','
                assign n_sel = n_sel | plus: 1
              endif
            endunless
          endfor
          for r in revs
            if n_sel >= max_cards
              break
            endif
            assign key = ',' | append: forloop.index0 | append: ','
            unless sel contains key
              assign sel = sel | append: forloop.index0 | append: ','
              assign n_sel = n_sel | plus: 1
            endunless
          endfor
        else
          for r in revs
            assign sel = sel | append: forloop.index0 | append: ','
          endfor
        endif
        assign idxs = sel | split: ','
      -%}
      {%- if revs.size > 0 -%}
        {%- if revs.size < jdgm_count and section.settings.compact == false -%}
          <p class="vf-jdgm__note">Mostrando as {{ revs.size }} avaliações mais recentes · {{ jdgm_count }} no total</p>
        {%- endif -%}
        <div class="vf-jdgm__revs">
          {%- for i in idxs -%}
            {%- if i == blank -%}{%- continue -%}{%- endif -%}
            {%- assign ii = i | plus: 0 -%}
            {%- assign r = revs[ii] -%}
            {%- assign r_rating = r.rating | times: 1 -%}
            <article class="vf-jdgm__rev">
              <header class="vf-jdgm__rev-top">
                <span class="vf-jdgm__rev-avatar" aria-hidden="true">{{ r.reviewer_initial | default: r.reviewer_name | slice: 0, 1 | upcase }}</span>
                <div class="vf-jdgm__rev-who">
                  <span class="vf-jdgm__rev-name">{{ r.reviewer_name | escape }}</span>
                  {%- if r.verified_buyer == true or r.verified_buyer == 'True' or r.verified_buyer == 'true' -%}
                    <span class="vf-jdgm__rev-badge">Compra verificada</span>
                  {%- endif -%}
                  <span class="vf-jdgm__rev-date">{{ r.created_at | date: '%d/%m/%Y' }}</span>
                </div>
              </header>
              {%- render 'vf-stars', rating: r_rating, size: 15 -%}
              <span class="visually-hidden">Nota {{ r_rating }} de 5</span>
              {%- if r.title != blank -%}<p class="vf-jdgm__rev-title">{{ r.title | escape }}</p>{%- endif -%}
              <div class="vf-jdgm__rev-body">{{ r.body_html }}</div>
              {%- render 'vf-jdgm-rev-media', r: r -%}
              {%- if fonte == 'store' -%}
                {%- if r.is_shop_review == true or r.is_shop_review == 'True' or r.is_shop_review == 'true' -%}
                  <span class="vf-jdgm__rev-product vf-jdgm__rev-product--shop">Avaliação da loja</span>
                {%- elsif r.product_title != blank and r.product_url != blank -%}
                  <a class="vf-jdgm__rev-product" href="{{ r.product_url }}">{{ r.product_title | split: '|' | last | strip | escape }}</a>
                {%- endif -%}
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if section.settings.compact and section.settings.all_label != blank -%}
        <p class="vf-jdgm__all"><a href="{{ section.settings.all_url | default: '/products/protocolo-desparasitacao-adulto-vermefree#judgeme_product_reviews' }}">{{ section.settings.all_label | escape }} <span aria-hidden="true">→</span></a></p>
      {%- endif -%}

      {%- comment -%}
        Chamada para avaliar (Home). O botão abre a escolha do protocolo e cada opção leva à página
        do produto com ?avaliar=1, que abre o formulário do Judge.me sozinho (script abaixo).
      {%- endcomment -%}
      {%- if section.settings.compact and section.settings.ask_heading != blank and section.settings.ask_products.count > 0 -%}
        <div class="vf-jdgm__ask" data-vf-jdgm-ask>
          <p class="vf-jdgm__ask-t">{{ section.settings.ask_heading }}</p>
          {%- if section.settings.ask_text != blank -%}<div class="vf-jdgm__ask-s">{{ section.settings.ask_text }}</div>{%- endif -%}
          <button type="button" class="vf-jdgm__ask-btn" data-vf-jdgm-ask-open aria-expanded="false">{{ section.settings.ask_button }}</button>
          <div class="vf-jdgm__ask-pick" data-vf-jdgm-ask-pick hidden>
            <p>{{ section.settings.ask_pick_label }}</p>
            {%- assign ask_labels = section.settings.ask_labels | default: '' | split: ',' -%}
            <ul>
              {%- for p in section.settings.ask_products -%}
                {%- assign lbl = ask_labels[forloop.index0] | strip -%}
                <li><a href="{{ p.url }}?avaliar=1#avaliacoes">
                  {%- if p.featured_image != blank -%}{{ p.featured_image | image_url: width: 120 | image_tag: alt: '', loading: 'lazy', width: 60, height: 60 }}{%- endif -%}
                  <span>{{ lbl | default: p.title }}</span>
                </a></li>
              {%- endfor -%}
            </ul>
          </div>
          {%- if section.settings.ask_note != blank -%}<p class="vf-jdgm__ask-n">{{ section.settings.ask_note }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if fonte == 'product' -%}
        {%- comment -%}
          Dados estruturados (estrelas no Google): a nota e as avaliações entram no
          Product único do snippet vf-structured-data (no <head>), com os mesmos
          dados desta seção. Por isso, em página de produto, o JSON-LD que o bloco
          de app do Judge.me gera (script.jdgm-server-jld, um segundo Product) é
          retirado da saída do bloco logo abaixo. O resto do bloco (formulário,
          lista, scripts) sai intacto.
        {%- endcomment -%}

        {%- comment -%}
          O campo antigo judgeme.widget hoje vem vazio; a lista acima sai de
          review_widget_data. O bloco de app "Review Widget" do Judge.me entra
          aqui só para o formulário: a lista dele fica escondida e o nosso
          botão "Escreva uma avaliação" abre o formulário dele.
        {%- endcomment -%}
        {%- if section.blocks.size > 0 -%}
          <div class="vf-jdgm__app">
            {%- for block in section.blocks -%}
              {%- capture vf_jdgm_out -%}{% render block %}{%- endcapture -%}
              {%- liquid
                assign vf_jld_open = '<script type="application/ld+json" class="jdgm-server-jld">'
                if template.name == 'product' and vf_jdgm_out contains vf_jld_open
                  assign vf_jld_body = vf_jdgm_out | split: vf_jld_open | last | split: '</script>' | first
                  assign vf_jld_full = vf_jld_open | append: vf_jld_body | append: '</script>'
                  assign vf_jdgm_out = vf_jdgm_out | remove_first: vf_jld_full
                endif
              -%}
              {{- vf_jdgm_out -}}
            {%- endfor -%}
          </div>
          <style>
            /* Lista e cabeçalho do Judge.me escondidos sem display:none, para o botão dele continuar clicável. */
            #avaliacoes .vf-jdgm__app .jm-review-widget, #avaliacoes .vf-jdgm__app .jdgm-rev-widg {
              position: absolute !important; width: 1px !important; height: 1px !important; overflow: hidden !important;
              clip: rect(0, 0, 0, 0) !important; white-space: nowrap !important; opacity: 0 !important; pointer-events: none !important;
            }
          </style>
        {%- endif -%}
        <div class="vf-jdgm__widget">
          <div
            id="judgeme_product_reviews"
            class="jdgm-widget jdgm-review-widget"
            data-product-title="{{ product.title | escape }}"
            data-id="{{ product.id }}"
          >
            {{ product.metafields.judgeme.widget }}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>

  <script>
    (function() {
      document.querySelectorAll('[data-vf-jdgm]').forEach(function(root) {
        if (root.dataset.vfBound) return;
        root.dataset.vfBound = '1';
        // Paginação: se, depois de carregar a nova página, a lista estiver fora da tela, rola até ela.
        root.addEventListener('click', function(e) {
          if (!e.target.closest || !e.target.closest('.jdgm-paginate__page')) return;
          var widget = root.querySelector('.vf-jdgm__widget');
          if (!widget) return;
          [600, 1400].forEach(function(ms) {
            setTimeout(function() {
              var top = widget.getBoundingClientRect().top;
              if (top < -20 || top > window.innerHeight * 0.6) {
                widget.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            }, ms);
          });
        });

        // Home: o botão da chamada abre a escolha do protocolo.
        var ask = root.querySelector('[data-vf-jdgm-ask-open]');
        if (ask) {
          ask.addEventListener('click', function() {
            var pick = root.querySelector('[data-vf-jdgm-ask-pick]');
            pick.hidden = !pick.hidden;
            ask.setAttribute('aria-expanded', pick.hidden ? 'false' : 'true');
          });
        }

        var btn = root.querySelector('[data-vf-jdgm-write]');
        if (!btn) return;

        // Botão que abre o formulário do Judge.me: o do bloco de app ou, no widget antigo, o link dele.
        function botaoJudgeme() {
          var app = [].slice.call(root.querySelectorAll('.vf-jdgm__app button')).filter(function(b) {
            return /avalia/i.test(b.textContent);
          })[0];
          return app || root.querySelector('.jdgm-write-rev-link');
        }
        function abrirForm() {
          var alvo = botaoJudgeme();
          if (alvo) alvo.click();
          setTimeout(function() {
            var form = root.querySelector('.jdgm-form-wrapper') || root.querySelector('.jdgm-form');
            var target = (form && form.offsetParent !== null) ? form : root.querySelector('.vf-jdgm__widget');
            if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }, 300);
        }
        btn.addEventListener('click', abrirForm);

        // Link de avaliação (WhatsApp pós-compra traz utm_campaign=avaliacao; Home e e-mails usam ?avaliar=1
        // ou #avaliar): mostra o aviso do cupom, tira a barra de compra da frente e abre o formulário
        // assim que o Judge.me terminar de carregar.
        var q = location.search;
        if (/[?&]avaliar=1/.test(q) || /[?&]utm_campaign=avaliacao/.test(q) || location.hash === '#avaliar') {
          document.body.classList.add('vf-avaliando');
          var aviso = root.querySelector('[data-vf-jdgm-reward]');
          if (aviso) aviso.hidden = false;
          root.scrollIntoView({ block: 'start' });
          var tentativas = 0;
          var espera = setInterval(function() {
            tentativas++;
            if (botaoJudgeme()) { clearInterval(espera); abrirForm(); }
            else if (tentativas > 40) clearInterval(espera);
          }, 300);
        }
      });
    })();
  </script>

  {% render 'vf-judgeme-reviews-style' %}
  {% render 'vf-jdgm-rev-media-assets' %}
  <style>
    /* Aviso do cupom (link de avaliação) e linha da recompensa embaixo do botão */
    #avaliacoes .vf-jdgm__banner { margin: 0 auto 18px; max-width: 640px; padding: 12px 16px; border-radius: 14px; background: #153C2C; color: #fff; font: 600 14.5px/1.45 Inter, system-ui, sans-serif; text-align: center; }
    #avaliacoes .vf-jdgm__banner[hidden] { display: none; }
    #avaliacoes .vf-jdgm__banner b, #avaliacoes .vf-jdgm__banner strong { color: #C0DE96; }
    #avaliacoes .vf-jdgm__reward { margin: 10px 0 0; font: 700 13px/1.4 Inter, system-ui, sans-serif; color: #2E6B22; text-align: center; }
    body.vf-avaliando .vf-pdp-sticky, body.vf-avaliando .vf-wafloat, body.vf-avaliando .vf-mt__bar { display: none !important; }
    /* Chamada para avaliar (Home) */
    #avaliacoes .vf-jdgm__ask { max-width: 640px; margin: 22px auto 0; padding: 20px 18px; border-radius: 20px; background: #153C2C; color: #fff; text-align: center; font-family: Inter, system-ui, sans-serif; }
    #avaliacoes .vf-jdgm__ask-t { margin: 0; font: 400 22px/1.15 Caprasimo, Georgia, serif; color: #fff; }
    #avaliacoes .vf-jdgm__ask-s p { margin: 0; }
    #avaliacoes .vf-jdgm__banner p { margin: 0; }
    #avaliacoes .vf-jdgm__ask-s { margin: 8px auto 0; max-width: 460px; font-size: 14px; line-height: 1.45; color: rgba(255, 255, 255, .86); }
    #avaliacoes .vf-jdgm__ask-s b, #avaliacoes .vf-jdgm__ask-s strong { color: #C0DE96; }
    #avaliacoes .vf-jdgm__ask-btn { display: flex; align-items: center; justify-content: center; width: 100%; max-width: 400px; min-height: 52px; margin: 14px auto 0; border: 0; border-radius: 999px; background: #5EBC43; color: #fff; font: 800 16px/1.2 Inter, system-ui, sans-serif; cursor: pointer; box-shadow: 0 10px 24px rgba(0, 0, 0, .22); }
    #avaliacoes .vf-jdgm__ask-btn[aria-expanded="true"] { background: rgba(255, 255, 255, .12); box-shadow: none; }
    #avaliacoes .vf-jdgm__ask-pick { margin: 14px auto 0; max-width: 460px; }
    #avaliacoes .vf-jdgm__ask-pick[hidden] { display: none; }
    #avaliacoes .vf-jdgm__ask-pick p { margin: 0 0 10px; font-size: 13px; font-weight: 700; color: #C0DE96; }
    #avaliacoes .vf-jdgm__ask-pick ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    #avaliacoes .vf-jdgm__ask-pick a { display: flex; align-items: center; gap: 8px; min-height: 56px; padding: 6px 10px 6px 6px; border-radius: 14px; background: #fff; color: #153C2C; text-decoration: none; font-size: 13.5px; font-weight: 800; text-align: left; }
    #avaliacoes .vf-jdgm__ask-pick img { flex: 0 0 auto; width: 44px; height: 44px; object-fit: contain; border-radius: 10px; background: #F3F8EC; }
    #avaliacoes .vf-jdgm__ask-n { margin: 10px 0 0; font-size: 12px; color: rgba(255, 255, 255, .7); }
    @media (min-width: 990px) { #avaliacoes .vf-jdgm__ask { margin-top: 32px; padding: 26px 28px; } #avaliacoes .vf-jdgm__ask-t { font-size: 26px; } #avaliacoes .vf-jdgm__ask-pick ul { grid-template-columns: repeat(4, minmax(0, 1fr)); } #avaliacoes .vf-jdgm__ask-pick a { flex-direction: column; text-align: center; padding: 10px 6px; } }
  </style>
  {%- if section.settings.compact -%}
    <style>
      /* Compacto (Home): continua a seção de prova social, mesmo fundo verde-claro */
      #avaliacoes.vf-jdgm--compact { background: #F3F8EC; padding: 22px 16px 48px; }
      #avaliacoes.vf-jdgm--compact .vf-jdgm__inner { max-width: 1160px; }
      #avaliacoes .vf-jdgm__mini { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 0 0 14px; font-size: 14px; color: #4F6357; }
      #avaliacoes .vf-jdgm__mini b { font-size: 20px; font-weight: 800; color: #153C2C; }
      #avaliacoes.vf-jdgm--compact .vf-jdgm__revs { gap: 10px; }
      #avaliacoes.vf-jdgm--compact .vf-jdgm__rev { gap: 5px; padding: 12px 14px; border-color: #E3EBDD; box-shadow: 0 6px 18px rgba(21, 60, 44, .06); }
      #avaliacoes.vf-jdgm--compact .vf-jdgm__rev-avatar { flex-basis: 32px; width: 32px; height: 32px; font-size: 14px; background: #F3F8EC; color: #3E8E2E; }
      #avaliacoes.vf-jdgm--compact .vf-jdgm__rev-name { font-size: 14px; color: #153C2C; }
      #avaliacoes.vf-jdgm--compact .vf-jdgm__rev-date { width: auto; font-size: 12px; }
      #avaliacoes.vf-jdgm--compact .vf-jdgm__rev-title { font-size: 14px; color: #153C2C; }
      #avaliacoes.vf-jdgm--compact .vf-jdgm__rev-body { font-size: 14px; line-height: 1.5; color: #33463B; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
      #avaliacoes.vf-jdgm--compact .vf-jdgm__rev-product { font-size: 12px; }
      #avaliacoes .vf-jdgm__all { margin: 16px 0 0; text-align: center; }
      #avaliacoes .vf-jdgm__all a { font-size: 15px; font-weight: 700; color: #3E8E2E; text-decoration: underline; text-underline-offset: 4px; }
      @media (min-width: 750px) { #avaliacoes.vf-jdgm--compact .vf-jdgm__revs { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
      @media (min-width: 990px) { #avaliacoes.vf-jdgm--compact { padding: 32px 16px 88px; } #avaliacoes .vf-jdgm__mini { margin-bottom: 22px; } }
    </style>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "VF Avaliações Judge.me",
  "tag": "section",
  "class": "vf-jdgm-section",
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Fonte das avaliações",
      "options": [
        { "value": "auto", "label": "Automático" },
        { "value": "store", "label": "Loja inteira (todas as avaliações)" },
        { "value": "product", "label": "Só deste produto" }
      ],
      "default": "auto",
      "info": "Automático: loja inteira na Home e o próprio produto nas páginas de produto."
    },
    { "type": "product", "id": "product", "label": "Produto das avaliações", "info": "Só vale quando a fonte é “Só deste produto”." },
    {
      "type": "text",
      "id": "write_url",
      "label": "Link do botão de avaliar (fonte Loja inteira)",
      "info": "Vazio leva às avaliações do Protocolo Adulto."
    },
    {
      "type": "paragraph",
      "content": "Avaliações reais coletadas pelo Judge.me. Requer o app embed Judge.me ativo no tema. As estrelas do topo da página levam até aqui (#avaliacoes)."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (opcional)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Avaliações de quem já usa"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Avaliações reais e verificadas de clientes VermeFree."
    },
    {
      "type": "text",
      "id": "write_label",
      "label": "Texto do botão de avaliar",
      "default": "Escreva uma avaliação"
    },
    {
      "type": "text",
      "id": "reward_text",
      "label": "Linha da recompensa embaixo do botão",
      "default": "📸 Com foto ou vídeo: 10% OFF na próxima compra",
      "info": "Só ponha o cupom se ele existir (AVALIEI10/AVALIEI5, enviados pelo WhatsApp). Vazio esconde."
    },
    {
      "type": "richtext",
      "id": "reward_banner",
      "label": "Aviso quando a pessoa chega pelo link de avaliação",
      "default": "<p>Que bom te ver aqui! Avalie com <strong>foto ou vídeo</strong> e ganhe <strong>10% OFF</strong> na próxima compra. Só texto: 5%. O cupom chega no seu WhatsApp.</p>",
      "info": "Aparece no topo das avaliações quando o link tem ?avaliar=1, #avaliar ou utm_campaign=avaliacao (WhatsApp pós-compra). O formulário abre sozinho."
    },
    {
      "type": "checkbox",
      "id": "hide_jdgm_header",
      "label": "Esconder o cabeçalho padrão do Judge.me",
