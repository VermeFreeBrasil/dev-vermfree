      "default": true
    },
    {
      "type": "header",
      "content": "Modo compacto (Home)"
    },
    {
      "type": "checkbox",
      "id": "compact",
      "label": "Compacto: nota em uma linha + poucos cards + link",
      "info": "Esconde a distribuição de notas e o botão de avaliar.",
      "default": false
    },
    { "type": "range", "id": "max_cards", "label": "Cards no modo compacto", "min": 1, "max": 6, "step": 1, "default": 3 },
    { "type": "text", "id": "all_label", "label": "Link para todas (modo compacto)", "default": "Ver todas as avaliações" },
    { "type": "text", "id": "all_url", "label": "Destino do link", "info": "Vazio leva às avaliações do Protocolo Adulto." },
    { "type": "header", "content": "Chamada para avaliar (modo compacto)" },
    { "type": "text", "id": "ask_heading", "label": "Título", "default": "Já fez o protocolo? Conta pra gente.", "info": "Vazio esconde a chamada." },
    { "type": "richtext", "id": "ask_text", "label": "Texto", "default": "<p>Sua avaliação ajuda outra família a decidir. Com foto ou vídeo, você ganha <strong>10% OFF</strong> na próxima compra (só texto: 5%).</p>" },
    { "type": "text", "id": "ask_button", "label": "Botão", "default": "📸 Avaliar e ganhar 10%" },
    { "type": "text", "id": "ask_pick_label", "label": "Pergunta ao abrir", "default": "Qual protocolo você usou?" },
    { "type": "product_list", "id": "ask_products", "label": "Protocolos para escolher", "limit": 6 },
    { "type": "text", "id": "ask_labels", "label": "Nomes curtos (mesma ordem, separados por vírgula)", "default": "Adulto,Kids 2 a 4,Kids 5 a 9,Kit Família" },
    { "type": "text", "id": "ask_note", "label": "Nota embaixo", "default": "Leva menos de 1 minuto · use o e-mail da compra" },
    {
      "type": "checkbox",
      "id": "hide_until_reviews",
      "label": "Esconder a seção enquanto não houver avaliação publicada",
      "default": false
    }
  ],
  "blocks": [
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "VF Avaliações Judge.me"
    }
  ]
}
{% endschema %}