{%- comment -%}
  footer.liquid — Footer VermeFree (reformulado 04/11, tarefa 6 Alliance).
  Desktop: Marca | Produtos | Institucional | Ajuda | Newsletter.
  Mobile: newsletter primeiro (aberta), menus em accordion e a coluna da marca
  (endereço, e-mail, Instagram, WhatsApp) sempre aberta no fim.
  Coluna "marca" = coluna com 'Mostrar endereço' ou 'Mostrar redes' marcado.
  Newsletter: form customer da Shopify (consentimento + tags) e, em paralelo,
  envio do e-mail ao n8n (ActiveCampaign, lista Newsletter rodapé).
  Faixa de confiança (Google Safe Browsing + Compra segura + Reclame Aqui) + bandeiras + linha legal.
{%- endcomment -%}

<footer
  class="vf-footer"
  style="--vf-footer-bg: {{ section.settings.bg_color }}; --vf-footer-text: {{ section.settings.text_color }};"
  role="contentinfo"
>
  {%- comment -%} Linha de selos {%- endcomment -%}
  {%- if section.settings.show_badges -%}
    <div class="vf-footer__badges">
      <div class="vf-container vf-footer__badges-inner">
        <span class="vf-footer__badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2Z"/><path d="M12 6c-3 4-3 8 0 12"/><path d="M6 12h12"/></svg>
          100% Vegetal
        </span>
        <span class="vf-footer__badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 2v6l-5 9a3 3 0 0 0 2.6 4.5h10.8A3 3 0 0 0 20 17l-5-9V2"/><path d="M7 2h10"/></svg>
          Sem metais pesados
        </span>
        <span class="vf-footer__badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15 15 0 0 1 0 20"/><path d="M12 2a15 15 0 0 0 0 20"/></svg>
          Fabricado no Brasil
        </span>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} Colunas {%- endcomment -%}
  <div class="vf-footer__main">
    <div class="vf-container vf-footer__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'column' -%}
          {%- assign vf_brand = false -%}
          {%- if block.settings.show_address or block.settings.show_social -%}
            {%- assign vf_brand = true -%}
          {%- endif -%}
          <div class="vf-footer__col{% if vf_brand %} vf-footer__col--brand{% endif %}" {{ block.shopify_attributes }}>
            {%- if vf_brand -%}
              <p class="vf-footer__col-title vf-footer__col-title--static">{{ block.settings.title | escape }}</p>
              <div class="vf-footer__col-content vf-footer__col-content--open">
            {%- else -%}
              <button
                type="button"
                class="vf-footer__col-title"
                aria-expanded="false"
                data-vf-footer-toggle
              >
                {{ block.settings.title | escape }}
                <svg class="vf-footer__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6"/>
                </svg>
              </button>
              <div class="vf-footer__col-content">
            {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="vf-footer__text">{{ block.settings.text }}</div>
              {%- endif -%}

              {%- if block.settings.show_address and section.settings.address != blank -%}
                <address class="vf-footer__address">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  <span>{{ section.settings.address | newline_to_br }}</span>
                </address>
              {%- endif -%}

              {%- if vf_brand -%}
                <ul class="vf-footer__contact">
                  {%- if section.settings.email != blank -%}
                    <li>
                      <a href="mailto:{{ section.settings.email }}">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
                        <span>{{ section.settings.email }}</span>
                      </a>
                    </li>
                  {%- endif -%}
                  {%- if section.settings.whatsapp_url != blank -%}
                    <li>
                      <a href="{{ section.settings.whatsapp_url }}" target="_blank" rel="noopener">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-1.3 4.5L21 21l-5.2-1.4A8.4 8.4 0 1 1 21 11.5z"/></svg>
                        <span>WhatsApp {{ section.settings.whatsapp_label }}</span>
                      </a>
                    </li>
                  {%- endif -%}
                </ul>
              {%- endif -%}

              {%- if block.settings.menu != blank -%}
                <ul class="vf-footer__list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}" class="vf-footer__link">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              {%- if block.settings.show_social -%}
                <ul class="vf-footer__social">
                  {%- if section.settings.instagram_url != blank -%}
                    <li>
                      <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.4A4 4 0 1 1 12.6 8 4 4 0 0 1 16 11.4Z"/><line x1="17.5" y1="6.5" x2="17.5" y2="6.5"/></svg>
                      </a>
                    </li>
                  {%- endif -%}
                  {%- if section.settings.tiktok_url != blank -%}
                    <li>
                      <a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.5 6.5a5.5 5.5 0 0 1-4-1.6V15a5.5 5.5 0 1 1-5.5-5.5v3a2.5 2.5 0 1 0 2.5 2.5V2h3a5.5 5.5 0 0 0 4 4.5z"/></svg>
                      </a>
                    </li>
                  {%- endif -%}
                  {%- if section.settings.facebook_url != blank -%}
                    <li>
                      <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H8v4h2v8h4v-8h3l1-4h-4V8.5a.5.5 0 0 1 .5-.5z"/></svg>
                      </a>
                    </li>
                  {%- endif -%}
                  {%- if section.settings.youtube_url != blank -%}
                    <li>
                      <a href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8zM9.8 15.1V8.9l5.4 3.1-5.4 3.1z"/></svg>
                      </a>
                    </li>
                  {%- endif -%}
                  {%- if section.settings.whatsapp_url != blank -%}
                    <li>
                      <a href="{{ section.settings.whatsapp_url }}" target="_blank" rel="noopener" aria-label="WhatsApp">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-1.3 4.5L21 21l-5.2-1.4A8.4 8.4 0 1 1 21 11.5z"/></svg>
                      </a>
                    </li>
                  {%- endif -%}
                </ul>
              {%- endif -%}
            </div>
          </div>
        {%- elsif block.type == 'newsletter' -%}
          <div class="vf-footer__col vf-footer__col--newsletter" {{ block.shopify_attributes }}>
            <p class="vf-footer__col-title vf-footer__col-title--static">{{ block.settings.title | escape }}</p>
            <div class="vf-footer__col-content vf-footer__col-content--open">
              {%- if block.settings.text != blank -%}
                <div class="vf-footer__text">{{ block.settings.text }}</div>
              {%- endif -%}
              <div class="vf-footer__newsletter-wrap" data-vf-nl-hook="{{ block.settings.webhook_url | escape }}">
              {%- form 'customer', id: 'vf-footer-newsletter', class: 'vf-footer__newsletter' -%}
                <input type="hidden" name="contact[tags]" value="newsletter, rodape">
                {%- if form.posted_successfully? -%}
                  <p class="vf-footer__newsletter-ok" role="status">{{ block.settings.success_text | escape }}</p>
                {%- else -%}
                  <label class="visually-hidden" for="vf-footer-newsletter-email">E-mail</label>
                  <div class="vf-footer__newsletter-row">
                    <input
                      id="vf-footer-newsletter-email"
                      type="email"
                      name="contact[email]"
                      class="vf-footer__newsletter-input"
                      placeholder="Seu melhor e-mail"
                      autocomplete="email"
                      required
                    >
                    <button type="submit" class="vf-footer__newsletter-btn">{{ block.settings.button_label | escape }}</button>
                  </div>
                  {%- if form.errors -%}
                    <p class="vf-footer__newsletter-error" role="alert">Confira o e-mail e tente de novo.</p>
                  {%- endif -%}
                {%- endif -%}
              {%- endform -%}
              </div>
              {%- if block.settings.privacy_text != blank -%}
                <p class="vf-footer__newsletter-lgpd">{{ block.settings.privacy_text | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} Faixa de confiança {%- endcomment -%}
  {%- if section.settings.show_google_badge or section.settings.show_secure_badge or section.settings.reclameaqui_url != blank -%}
    <div class="vf-footer__trust">
      <div class="vf-container vf-footer__trust-inner">
        {%- if section.settings.show_google_badge -%}
          <a
            class="vf-footer__trust-badge"
            href="https://transparencyreport.google.com/safe-browsing/search?url={{ shop.domain }}&hl=pt_BR"
            target="_blank"
            rel="noopener"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
            <span><strong>Sem alertas no Google Safe Browsing</strong><small>Ver o relatório do Google</small></span>
          </a>
        {%- endif -%}
        {%- if section.settings.show_secure_badge -%}
          <span class="vf-footer__trust-badge">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <span><strong>Compra segura</strong><small>Pagamento protegido com SSL</small></span>
          </span>
        {%- endif -%}
        {%- if section.settings.reclameaqui_url != blank -%}
          <a
            class="vf-footer__trust-badge"
            href="{{ section.settings.reclameaqui_url }}"
            target="_blank"
            rel="noopener"
          >
            {%- if section.settings.reclameaqui_image != blank -%}
              <img src="{{ section.settings.reclameaqui_image | image_url: width: 240 }}" alt="Reclame Aqui" width="120" height="40" loading="lazy">
            {%- else -%}
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              <span><strong>Reclame Aqui</strong><small>Veja nossa reputação</small></span>
            {%- endif -%}
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} Bandeiras de pagamento {%- endcomment -%}
  <div class="vf-footer__payment">
    <div class="vf-container vf-footer__payment-inner">
      <ul class="vf-footer__payment-list">
        <li class="vf-footer__payment-item" aria-label="Visa">
          <svg viewBox="0 0 48 32" width="48" height="32" aria-hidden="true"><rect width="48" height="32" rx="4" fill="#fff"/><text x="24" y="20" text-anchor="middle" font-family="Arial,sans-serif" font-weight="700" font-size="11" fill="#1A1F71">VISA</text></svg>
        </li>
        <li class="vf-footer__payment-item" aria-label="Mastercard">
          <svg viewBox="0 0 48 32" width="48" height="32" aria-hidden="true"><rect width="48" height="32" rx="4" fill="#fff"/><circle cx="20" cy="16" r="7" fill="#EB001B"/><circle cx="28" cy="16" r="7" fill="#F79E1B" opacity=".9"/></svg>
        </li>
        <li class="vf-footer__payment-item" aria-label="Pix">
          <svg viewBox="0 0 48 32" width="48" height="32" aria-hidden="true"><rect width="48" height="32" rx="4" fill="#fff"/><path d="M15 9l7 7-7 7-7-7z" fill="#32BCAD"/><path d="M15 12.5l3.5 3.5-3.5 3.5-3.5-3.5z" fill="#fff"/><text x="32" y="20.5" text-anchor="middle" font-family="Arial,sans-serif" font-weight="700" font-size="11" fill="#0B7E73">pix</text></svg>
        </li>
        <li class="vf-footer__payment-item" aria-label="Boleto">
          <svg viewBox="0 0 48 32" width="48" height="32" aria-hidden="true"><rect width="48" height="32" rx="4" fill="#fff"/><g fill="#1A1A1A"><rect x="9" y="6" width="2" height="12"/><rect x="13" y="6" width="1" height="12"/><rect x="16" y="6" width="3" height="12"/><rect x="21" y="6" width="1" height="12"/><rect x="24" y="6" width="2" height="12"/><rect x="28" y="6" width="3" height="12"/><rect x="33" y="6" width="1" height="12"/><rect x="36" y="6" width="2" height="12"/></g><text x="24" y="27" text-anchor="middle" font-family="Arial,sans-serif" font-weight="700" font-size="7" fill="#1A1A1A">BOLETO</text></svg>
        </li>
        <li class="vf-footer__payment-item" aria-label="American Express">
          <svg viewBox="0 0 48 32" width="48" height="32" aria-hidden="true"><rect width="48" height="32" rx="4" fill="#006FCF"/><text x="24" y="20" text-anchor="middle" font-family="Arial,sans-serif" font-weight="700" font-size="9" fill="#fff">AMEX</text></svg>
        </li>
      </ul>
    </div>
  </div>

  {%- comment -%} Copyright {%- endcomment -%}
  <div class="vf-footer__bottom">
    <div class="vf-container vf-footer__bottom-inner">
      {%- if section.settings.cnpj != blank -%}
        <p class="vf-footer__legal">
          {{ section.settings.cnpj | escape }}
          {%- if section.settings.email != blank %} · <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>{%- endif -%}
        </p>
      {%- endif -%}
      <p>&copy; {{ 'now' | date: '%Y' }} VermeFree. Todos os direitos reservados.</p>
    </div>
  </div>
</footer>

<script>
  (function () {
    /* Newsletter do rodapé: o envio nativo da Shopify (com o CAPTCHA dela) segue normal;
       em paralelo o e-mail vai para o n8n -> ActiveCampaign (lista Newsletter rodapé).
       Corpo form-urlencoded + keepalive: sem preflight e sobrevive à troca de página. */
    var wrap = document.querySelector('[data-vf-nl-hook]');
    if (!wrap) return;
    var form = wrap.querySelector('form');
    var hook = wrap.getAttribute('data-vf-nl-hook');
    if (!form || !hook) return;
    var RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
    var UK = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
    form.addEventListener('submit', function () {
      if (form.getAttribute('data-vf-sent') === '1') return;
      var input = form.querySelector('input[type="email"]');
      var email = ((input && input.value) || '').trim();
      if (!RE.test(email)) return;
      form.setAttribute('data-vf-sent', '1');
      var body = new URLSearchParams();
      body.append('email', email);
      body.append('origem', 'rodape');
      body.append('pagina', location.pathname);
      try {
        var q = new URLSearchParams(location.search);
        UK.forEach(function (k) { var v = q.get(k); if (v) body.append(k, v); });
      } catch (x) {}
      try {
        fetch(hook, { method: 'POST', keepalive: true, mode: 'cors', body: body });
      } catch (x) {}
    });
  })();
</script>

{% stylesheet %}
.vf-footer {
  background: var(--vf-footer-bg, #1A1A1A);
  color: var(--vf-footer-text, #FFFFFF);
  font-family: var(--font-body);
}

.vf-footer__badges {
  background: rgba(255,255,255,.04);
  border-bottom: 1px solid rgba(255,255,255,.08);
  padding: 16px 0;
}

.vf-footer__badges-inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 16px 28px;
}

.vf-footer__badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 500;
  opacity: .9;
}

.vf-footer__badge svg {
  color: var(--vf-green-light);
}

.vf-footer__main {
  padding: 48px 0 24px;
}

.vf-footer__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 8px;
}

.vf-footer__col {
  border-bottom: 1px solid rgba(255,255,255,.1);
}

.vf-footer__col-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  background: none;
  border: 0;
  color: inherit;
  padding: 16px 0;
  font-family: var(--font-heading);
  font-size: 17px;
  font-weight: 400;
  text-align: left;
  cursor: pointer;
}

.vf-footer__chevron {
  transition: transform .2s ease;
}

.vf-footer__col-title[aria-expanded="true"] .vf-footer__chevron {
  transform: rotate(180deg);
}

.vf-footer__col-content {
  display: none;
  padding-bottom: 16px;
}

.vf-footer__col-title[aria-expanded="true"] + .vf-footer__col-content {
  display: block;
}

.vf-footer__text {
  font-size: 14px;
  line-height: 1.6;
  opacity: .8;
}

.vf-footer__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.vf-footer__link {
  color: inherit;
  text-decoration: none;
  font-size: 14px;
  opacity: .8;
  transition: opacity .2s ease, color .2s ease;
}

.vf-footer__link:hover {
  opacity: 1;
  color: var(--vf-green-light);
}

.vf-footer__social {
  list-style: none;
  display: flex;
  gap: 12px;
  margin: 12px 0 0;
  padding: 0;
}

.vf-footer__social a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 999px;
  color: inherit;
  transition: background .2s ease, border-color .2s ease;
}

.vf-footer__social a:hover {
  background: var(--vf-green);
  border-color: var(--vf-green);
}

.vf-footer__payment {
  border-top: 1px solid rgba(255,255,255,.1);
  padding: 20px 0;
}

.vf-footer__payment-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
}

.vf-footer__payment-item {
  display: inline-flex;
}

.vf-footer__bottom {
  border-top: 1px solid rgba(255,255,255,.08);
  padding: 16px 0;
}

.vf-footer__bottom-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  text-align: center;
  font-size: 12px;
  opacity: .7;
}

.vf-footer__bottom-inner p {
  margin: 0;
}

.vf-footer__address {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin-top: 16px;
  font-size: 13px;
  font-style: normal;
  line-height: 1.5;
  opacity: .8;
}

.vf-footer__address svg {
  flex: 0 0 auto;
  margin-top: 2px;
  color: var(--vf-green-light);
}

.vf-footer__col-title--static {
  margin: 0;
  cursor: default;
}

.vf-footer__col-content--open {
  display: block;
}

.vf-footer__newsletter {
  margin-top: 12px;
}

.vf-footer__newsletter-row {
  display: flex;
  gap: 8px;
}

.vf-footer__newsletter-input {
  flex: 1 1 auto;
  min-width: 0;
  padding: 12px 14px;
  border: 1px solid rgba(255,255,255,.25);
  border-radius: var(--button-radius, 10px);
  background: rgba(255,255,255,.06);
  color: inherit;
  font-size: 14px;
}

.vf-footer__newsletter-input::placeholder {
  color: inherit;
  opacity: .6;
}

.vf-footer__newsletter-btn {
  flex: 0 0 auto;
  padding: 12px 16px;
  border: 0;
  border-radius: var(--button-radius, 10px);
  background: var(--vf-green);
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
}

.vf-footer__newsletter-btn:hover {
  background: var(--vf-green-dark);
}

.vf-footer__newsletter-ok,
.vf-footer__newsletter-error {
  margin: 8px 0 0;
  font-size: 13px;
}

.vf-footer__newsletter-ok {
  color: var(--vf-green-light);
}

.vf-footer__trust {
  border-top: 1px solid rgba(255,255,255,.1);
  padding: 20px 0;
}

.vf-footer__trust-inner {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px 24px;
}

.vf-footer__trust-badge {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 8px 14px;
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 12px;
  color: inherit;
  text-decoration: none;
}

.vf-footer__trust-badge svg {
  color: var(--vf-green-light);
}

.vf-footer__trust-badge span {
  display: flex;
  flex-direction: column;
  line-height: 1.25;
  font-size: 13px;
}

.vf-footer__trust-badge small {
  font-size: 11px;
  opacity: .7;
}

/* Mobile: newsletter primeiro, marca (endereço/contato/redes) sempre aberta no fim */
.vf-footer__col--newsletter {
  order: -1;
  padding-bottom: 20px;
}

.vf-footer__col--brand {
  order: 10;
  border-bottom: 0;
  padding-top: 8px;
}

.vf-footer__col--brand .vf-footer__col-title--static {
  padding: 16px 0 8px;
}

.vf-footer__contact {
  list-style: none;
  margin: 12px 0 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.vf-footer__contact a {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: inherit;
  text-decoration: none;
  font-size: 13px;
  opacity: .85;
  word-break: break-all;
}

.vf-footer__contact a:hover {
  opacity: 1;
  color: var(--vf-green-light);
}

.vf-footer__contact svg {
  flex: 0 0 auto;
  color: var(--vf-green-light);
}

.vf-footer__newsletter-lgpd {
  margin: 8px 0 0;
  font-size: 11px;
  line-height: 1.5;
  opacity: .6;
}

.vf-footer__payment-item svg {
  display: block;
  border-radius: 4px;
  box-shadow: 0 0 0 1px rgba(255,255,255,.2);
}

.vf-footer__legal {
  line-height: 1.6;
}

.vf-footer__legal a {
  color: inherit;
}

/* Espaço para o botão flutuante do WhatsApp (e a barra fixa de compra, quando houver) não cobrirem bandeiras e copyright */
.vf-footer__bottom {
  padding-bottom: calc(160px + env(safe-area-inset-bottom, 0px));
}

.vf-footer__legal {
  max-width: 820px;
  margin-left: auto !important;
  margin-right: auto !important;
  text-wrap: balance;
}

@media (min-width: 750px) {
  .vf-footer__grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 24px 32px;
  }

  .vf-footer__bottom-inner {
    gap: 6px;
  }
}

@media (min-width: 990px) {
  .vf-footer__main {
    padding: 64px 0 32px;
  }

  /* 990-1199 px: 3 colunas por linha; a partir de 1200 px: marca, 3 menus e newsletter na mesma linha (regra no fim) */
  .vf-footer__grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .vf-footer__col {
    border-bottom: 0;
  }

  .vf-footer__col--newsletter,
  .vf-footer__col--brand {
    order: 0;
    padding: 0;
  }

  .vf-footer__col--brand .vf-footer__col-title--static {
    padding: 0 0 16px;
  }

  .vf-footer__bottom {
    padding-bottom: 150px;
  }

  .vf-footer__col-title {
    pointer-events: none;
    padding: 0 0 16px;
  }

  .vf-footer__chevron {
    display: none;
  }

  .vf-footer__col-content {
    display: block !important;
    padding-bottom: 0;
  }
}

@media (min-width: 1200px) {
  .vf-footer__grid {
    grid-template-columns: 1.4fr repeat(3, 1fr) 1.7fr;
    gap: 32px;
  }
}
{% endstylesheet %}

