{%- comment -%}
  vf-pdp-main — PDP principal estilo DTC premium
  Layout: galeria (sticky) à esquerda + buy box (sticky) à direita
  Mobile: galeria em cima, buy box embaixo
  Inclui: stars, preço com parcelado em destaque, lista de componentes, CTAs, selos
{%- endcomment -%}

<section class="vf-pdp" aria-label="Detalhes do produto">
  <div class="vf-pdp__container">

    {%- comment -%}
      GALERIA
      Prioridade 1: product.images (cadastradas no admin Shopify)
      Prioridade 2: fallback estático com fotos reais V2 (asset_url)
                    usado em preview antes do produto estar cadastrado
    {%- endcomment -%}
    <div class="vf-pdp__gallery">
      {%- if product.images.size > 0 -%}
        {%- assign main_img = product.featured_image -%}
        <div class="vf-pdp__main-image">
          <img
            src="{{ main_img | image_url: width: 1000 }}"
            alt="{{ main_img.alt | default: product.title | escape }}"
            width="1000"
            height="1000"
            loading="eager"
            class="vf-pdp__img"
            id="vf-pdp-main-img"
          >
        </div>

        {%- if product.images.size > 1 -%}
          <div class="vf-pdp__thumbs">
            {%- for image in product.images limit: 12 -%}
              <button
                type="button"
                class="vf-pdp__thumb {% if forloop.first %}is-active{% endif %}"
                data-src="{{ image | image_url: width: 1000 }}"
                aria-label="Ver imagem {{ forloop.index }}"
              >
                <img
                  src="{{ image | image_url: width: 200 }}"
                  alt=""
                  width="200"
                  height="200"
                  loading="lazy"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

      {%- else -%}
        {%- comment -%} Fallback: fotos reais V2 do produto Adulto {%- endcomment -%}
        {%- assign fallback_main = 'pdp-adulto-01-oregano-frontal.jpg' | asset_url -%}
        <div class="vf-pdp__main-image">
          <img
            src="{{ fallback_main }}"
            alt="Protocolo Adulto VermeFree — Óleo Essencial de Orégano"
            width="1000"
            height="1000"
            loading="eager"
            class="vf-pdp__img"
            id="vf-pdp-main-img"
          >
        </div>
        <div class="vf-pdp__thumbs">
          {%- assign fallback_thumbs = 'pdp-adulto-01-oregano-frontal.jpg,pdp-adulto-02-oregano-flatlay.jpg,pdp-adulto-03-oregano-deitado-capsulas.jpg,pdp-adulto-05-tintura-gota.jpg,pdp-adulto-06-ornitina.jpg,pdp-adulto-07-silimarina.jpg,kit-familia-01-todos-frascos.jpg' | split: ',' -%}
          {%- for filename in fallback_thumbs -%}
            <button
              type="button"
              class="vf-pdp__thumb {% if forloop.first %}is-active{% endif %}"
              data-src="{{ filename | asset_url }}"
              aria-label="Ver imagem {{ forloop.index }}"
            >
              <img
                src="{{ filename | asset_url }}"
                alt=""
                width="200"
                height="200"
                loading="lazy"
              >
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} BUY BOX {%- endcomment -%}
    <div class="vf-pdp__buy">
      <div class="vf-pdp__buy-inner">

        {%- if product.vendor != blank and section.settings.show_vendor -%}
          <p class="vf-pdp__vendor">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 class="vf-pdp__title">{{ product.title | default: section.settings.fallback_title }}</h1>

        {%- if section.settings.show_age_badge -%}
          <span class="vf-pdp__age-badge" aria-label="Indicação de idade">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            {{ section.settings.age_badge_text }}
          </span>
        {%- endif -%}

        <a class="vf-pdp__protocol-link" href="#como-tomar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="9" y1="14" x2="15" y2="14"/>
            <line x1="9" y1="18" x2="15" y2="18"/>
          </svg>
          Ver o protocolo completo
          <span aria-hidden="true">&rarr;</span>
        </a>

        {%- if section.settings.show_rating -%}
          <div class="vf-pdp__rating" aria-label="Avaliação {{ section.settings.rating_score }} de 5 estrelas">
            <span class="vf-pdp__stars" aria-hidden="true">
              {% for i in (1..5) %}
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3 7 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1z"/></svg>
              {% endfor %}
            </span>
            <span class="vf-pdp__rating-text">
              <strong>{{ section.settings.rating_score }}</strong>
              ({{ section.settings.rating_count }} avaliações)
            </span>
          </div>
        {%- endif -%}

        {%- if product.description != blank -%}
          <p class="vf-pdp__short">{{ product.description | strip_html | truncatewords: 30 }}</p>
        {%- elsif section.settings.short_desc != blank -%}
          <p class="vf-pdp__short">{{ section.settings.short_desc }}</p>
        {%- endif -%}

        {%- comment -%}
          PREÇO — 10x destaque
          Parcela 10x fixa por produto (via section setting "installment_10x_value" em centavos).
          Cai em fallback calculado se setting estiver vazio.
        {%- endcomment -%}
        {%- assign installment_10x_cents = section.settings.installment_10x_value | default: 0 -%}
        {%- assign unit_price_cents = 34700 -%}
        {%- if product != blank and product.selected_or_first_available_variant != blank -%}
          {%- assign unit_price_cents = product.selected_or_first_available_variant.price -%}
        {%- endif -%}
        {%- assign installment_ratio = 0.11796 -%}
        {%- if installment_10x_cents > 0 and unit_price_cents > 0 -%}
          {%- assign installment_ratio = installment_10x_cents | times: 1.0 | divided_by: unit_price_cents -%}
        {%- endif -%}
        {%- comment -%}
          PROMO TEMPORARIA — frete gratis sem minimo, so quinta 30/07 e
          sexta 31/07/2026 (mesma janela do desconto agendado no Shopify).
          Data pega do fuso da loja ('now'), entao liga/desliga sozinho.
        {%- endcomment -%}
        {%- assign pdp_today = 'now' | date: '%Y-%m-%d' -%}
        {%- assign pdp_frete_promo = false -%}
        {%- if pdp_today == '2026-07-30' or pdp_today == '2026-07-31' or section.settings.preview_frete_promo -%}
          {%- assign pdp_frete_promo = true -%}
        {%- endif -%}
        <div class="vf-pdp__price-box{% if pdp_frete_promo %} vf-pdp__price-box--promo{% endif %}"
             data-unit-price="{{ unit_price_cents }}"
             data-installment-10x="{{ installment_10x_cents }}"
             data-frete-promo="{{ pdp_frete_promo }}">
          {%- if product != blank and product.selected_or_first_available_variant != blank -%}
            {%- assign current_variant = product.selected_or_first_available_variant -%}
            {%- assign price = current_variant.price -%}
            {%- assign compare = current_variant.compare_at_price -%}
            {%- if compare > price -%}
              <span class="vf-pdp__compare" id="vf-pdp-compare">de {{ compare | money }}</span>
            {%- endif -%}
            {%- if installment_10x_cents > 0 -%}
              <p class="vf-pdp__installment" id="vf-pdp-installment">
                10x de {{ installment_10x_cents | money }}
              </p>
            {%- else -%}
              <p class="vf-pdp__installment" id="vf-pdp-installment">
                3x de {{ price | divided_by: 3 | money }} sem juros
              </p>
            {%- endif -%}
            <p class="vf-pdp__price-cash" id="vf-pdp-cash">
              ou {{ price | money }} à vista
            </p>
          {%- else -%}
            <p class="vf-pdp__installment" id="vf-pdp-installment">10x de R$ 40,93</p>
            <p class="vf-pdp__price-cash" id="vf-pdp-cash">ou R$ 347 à vista</p>
          {%- endif -%}

          <div class="vf-pdp__volume-badge" id="vf-pdp-volume-badge" hidden>
            <span class="vf-pdp__volume-badge-icon">🎁</span>
            <span class="vf-pdp__volume-badge-text" id="vf-pdp-volume-badge-text"></span>
          </div>
        </div>

        {%- comment -%} COMPONENTES DO PROTOCOLO {%- endcomment -%}
        {%- assign has_component = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'component' -%}
            {%- assign has_component = true -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if has_component -%}
          <div class="vf-pdp__components">
            <p class="vf-pdp__components-label">O que vem no protocolo:</p>
            <ul class="vf-pdp__components-list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'component' -%}
                  <li class="vf-pdp__component" {{ block.shopify_attributes }}>
                    <span class="vf-pdp__component-check" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-11"/></svg>
                    </span>
                    <span class="vf-pdp__component-text">
                      <strong>{{ block.settings.name }}</strong>
                      {%- if block.settings.spec != blank -%}
                        <span class="vf-pdp__component-spec">{{ block.settings.spec }}</span>
                      {%- endif -%}
                    </span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- comment -%} VARIANTS / QUANTITY / CTA {%- endcomment -%}
        <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="vf-pdp__form">
          {%- if product.has_only_default_variant == false -%}
            <div class="vf-pdp__variants">
              {%- for option in product.options_with_values -%}
                <label class="vf-pdp__variant-label">{{ option.name }}</label>
                <div class="vf-pdp__variant-options">
                  {%- for value in option.values -%}
                    <label class="vf-pdp__pill">
                      <input type="radio" name="options[{{ option.name }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                      <span>{{ value }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" id="vf-pdp-qty" name="quantity" value="1">

          {%- comment -%}
            SELETOR DE KITS (estilo Botanika)
            Cards clicaveis que definem a quantidade. Tiers configuraveis
            via section settings, com os mesmos descontos que ja existiam
            no stepper (3=10%, 5=15%, 8=20%).
          {%- endcomment -%}
          {%- if section.settings.kits_enabled -%}
            <div class="vf-pdp__kits" role="radiogroup" aria-label="Escolha a quantidade de kits">
              {%- if section.settings.kits_socialproof_enabled -%}
                <div class="vf-pdp__kits-social">
                  <span class="vf-pdp__kits-stars" aria-hidden="true">★★★★★</span>
                  {%- if section.settings.kits_socialproof_text != blank -%}
                    <span class="vf-pdp__kits-social-text">{{ section.settings.kits_socialproof_text }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if section.settings.kits_legend != blank -%}
                <p class="vf-pdp__kits-legend">{{ section.settings.kits_legend }} <strong id="vf-pdp-kits-legend-value">{{ section.settings.tier1_title }}</strong></p>
              {%- endif -%}

              {%- comment -%} Selecao invertida (3/2/1) so nos protocolos {%- endcomment -%}
              {%- assign kit_is_protocol = false -%}
              {%- assign kit_proto_handles = 'protocolo-desparasitacao-adulto-vermefree,antiparasitario-infantil-natural-vermefree-kids-2-a-4-anos,antiparasitario-infantil-natural-vermefree-kids-5-a-9-anos' | split: ',' -%}
              {%- if kit_proto_handles contains product.handle -%}{%- assign kit_is_protocol = true -%}{%- endif -%}

              {%- if kit_is_protocol -%}
                <div class="vf-pdp__kitbar" id="vf-pdp-kitbar">
                  <div class="vf-pdp__kitbar-track"><div class="vf-pdp__kitbar-fill" id="vf-pdp-kitbar-fill"></div></div>
                  <p class="vf-pdp__kitbar-msg" id="vf-pdp-kitbar-msg"></p>
                </div>
              {%- endif -%}

              <div class="vf-pdp__kits-grid" id="vf-pdp-kits-grid">
                {%- if kit_is_protocol -%}
                  {%- assign kit_proto_qtys = '3,2,1' | split: ',' -%}
                  {%- comment -%} Adulto: 2 kits com 5% OFF (desconto automatico "5% OFF · 2 Protocolos Adulto", por produto, min 2). Kids seguem sem o 5% ate a acao ser estendida. {%- endcomment -%}
                  {%- if product.handle == 'protocolo-desparasitacao-adulto-vermefree' -%}
                    {%- assign kit_proto_discs = '10,5,0' | split: ',' -%}
                  {%- else -%}
                    {%- assign kit_proto_discs = '10,0,0' | split: ',' -%}
                  {%- endif -%}
                  {%- assign kit_proto_titles = '3 Kits,2 Kits,1 Kit' | split: ',' -%}
                  {%- for idx in (0..2) -%}
                    {%- assign t_qty = kit_proto_qtys[idx] | plus: 0 -%}
                    {%- assign t_disc = kit_proto_discs[idx] | plus: 0 -%}
                    {%- assign t_title = kit_proto_titles[idx] -%}
                    {%- assign t_total = unit_price_cents | times: t_qty -%}
                    {%- assign t_disc_amt = t_total | times: t_disc | divided_by: 100 -%}
                    {%- assign t_price = t_total | minus: t_disc_amt -%}
                    {%- assign t_installment = t_price | times: installment_ratio | round -%}
                    {%- assign t_badge1 = '' -%}
                    {%- assign t_badge2 = '' -%}
                    {%- assign t_msg = '' -%}
                    {%- if t_qty == 3 -%}
                      {%- assign t_badge1 = 'Mais vantajoso' -%}
                      {%- assign t_badge2 = 'Frete grátis' -%}
                      {%- assign t_msg = 'Seu ano de desparasitação natural, garantido 🌙' -%}
                    {%- elsif t_qty == 2 -%}
                      {%- assign t_badge2 = 'Frete grátis' -%}
                    {%- endif -%}
                    <div class="vf-pdp__kit-card{% if forloop.first %} is-active{% endif %}" data-qty="{{ t_qty }}" data-discount="{{ t_disc }}" role="radio" aria-checked="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="0">
                      {%- if t_badge1 != blank or t_badge2 != blank -%}
                        <div class="vf-pdp__kit-badges">
                          {%- if t_badge1 != blank -%}<span class="vf-pdp__kit-badge vf-pdp__kit-badge--1">{{ t_badge1 }}</span>{%- endif -%}
                          {%- if t_badge2 != blank -%}<span class="vf-pdp__kit-badge vf-pdp__kit-badge--2">{{ t_badge2 }}</span>{%- endif -%}
                        </div>
                      {%- endif -%}
                      <div class="vf-pdp__kit-row">
                        <span class="vf-pdp__kit-radio" aria-hidden="true"></span>
                        <div class="vf-pdp__kit-image">
                          {%- if product.featured_image != blank -%}<img src="{{ product.featured_image | image_url: width: 200 }}" alt="{{ t_title | escape }}" loading="lazy">{%- else -%}<div class="vf-pdp__kit-image-ph"></div>{%- endif -%}
                        </div>
                        <div class="vf-pdp__kit-info">
                          <span class="vf-pdp__kit-title">{{ t_title }}</span>
                          <div class="vf-pdp__kit-pricing">
                            <span class="vf-pdp__kit-installments-label">10x de</span>
                            <span class="vf-pdp__kit-installment-value" data-installment>{{ t_installment | money }}</span>
                          </div>
                          <div class="vf-pdp__kit-cash">
                            <span class="vf-pdp__kit-cash-or">ou</span>
                            <span class="vf-pdp__kit-cash-value" data-total>{{ t_price | money }}</span>
                            <span class="vf-pdp__kit-cash-label">à vista</span>
                            {%- if t_disc > 0 -%}<s class="vf-pdp__kit-compare" data-compare>{{ t_total | money }}</s>{%- endif -%}
                          </div>
                          {%- if t_disc > 0 -%}<span class="vf-pdp__kit-discount">{{ t_disc }}% OFF · você economiza <span data-save>{{ t_disc_amt | money }}</span></span>{%- endif -%}
                        </div>
                      </div>
                      {%- if t_msg != blank -%}<div class="vf-pdp__kit-message">{{ t_msg }}</div>{%- endif -%}
                    </div>
                  {%- endfor -%}
                {%- else -%}
                {%- for i in (1..4) -%}
                  {%- assign tier_key = i | prepend: 'tier' -%}
                  {%- assign enabled_key = tier_key | append: '_enabled' -%}
                  {%- if section.settings[enabled_key] -%}
                    {%- assign qty_key = tier_key | append: '_quantity' -%}
                    {%- assign disc_key = tier_key | append: '_discount' -%}
                    {%- assign title_key = tier_key | append: '_title' -%}
                    {%- assign image_key = tier_key | append: '_image' -%}
                    {%- assign badge1_key = tier_key | append: '_badge1' -%}
                    {%- assign badge2_key = tier_key | append: '_badge2' -%}
                    {%- assign msg_key = tier_key | append: '_message' -%}

                    {%- assign t_qty = section.settings[qty_key] -%}
                    {%- assign t_disc = section.settings[disc_key] -%}
                    {%- assign t_image = section.settings[image_key] -%}
                    {%- assign t_total = unit_price_cents | times: t_qty -%}
                    {%- assign t_disc_amt = t_total | times: t_disc | divided_by: 100 -%}
                    {%- assign t_price = t_total | minus: t_disc_amt -%}
                    {%- assign t_installment = t_price | times: installment_ratio | round -%}
                    {%- assign t_badge2 = section.settings[badge2_key] -%}
                    {%- if pdp_frete_promo -%}
                      {%- assign t_badge2 = 'Frete grátis' -%}
                    {%- endif -%}
                    {%- assign has_badges = false -%}
                    {%- if section.settings[badge1_key] != blank or t_badge2 != blank -%}
                      {%- assign has_badges = true -%}
                    {%- endif -%}

                    <div
                      class="vf-pdp__kit-card{% if forloop.first %} is-active{% endif %}{% if pdp_frete_promo %} vf-pdp__kit-card--promo{% endif %}"
                      data-qty="{{ t_qty }}"
                      data-discount="{{ t_disc }}"
                      role="radio"
                      aria-checked="{% if forloop.first %}true{% else %}false{% endif %}"
                      tabindex="0"
                    >
                      {%- if pdp_frete_promo -%}
                        <span class="vf-pdp__kit-promo-ribbon">🚚 FRETE GRÁTIS HOJE</span>
                      {%- endif -%}
                      {%- if has_badges -%}
                        <div class="vf-pdp__kit-badges">
                          {%- if section.settings[badge1_key] != blank -%}
                            <span class="vf-pdp__kit-badge vf-pdp__kit-badge--1">{{ section.settings[badge1_key] }}</span>
                          {%- endif -%}
                          {%- if t_badge2 != blank -%}
                            <span class="vf-pdp__kit-badge vf-pdp__kit-badge--2">{{ t_badge2 }}</span>
                          {%- endif -%}
                        </div>
                      {%- endif -%}

                      <div class="vf-pdp__kit-row">
                        <span class="vf-pdp__kit-radio" aria-hidden="true"></span>

                        <div class="vf-pdp__kit-image">
                          {%- if t_image != blank -%}
                            <img src="{{ t_image | image_url: width: 200 }}" alt="{{ section.settings[title_key] | escape }}" loading="lazy">
                          {%- elsif product.featured_image != blank -%}
                            <img src="{{ product.featured_image | image_url: width: 200 }}" alt="{{ section.settings[title_key] | escape }}" loading="lazy">
                          {%- else -%}
                            <div class="vf-pdp__kit-image-ph"></div>
                          {%- endif -%}
                        </div>

                        <div class="vf-pdp__kit-info">
                          <span class="vf-pdp__kit-title">{{ section.settings[title_key] }}</span>

                          <div class="vf-pdp__kit-pricing">
                            <span class="vf-pdp__kit-installments-label">10x de</span>
                            <span class="vf-pdp__kit-installment-value" data-installment>{{ t_installment | money }}</span>
                          </div>
                          <div class="vf-pdp__kit-cash">
                            <span class="vf-pdp__kit-cash-or">ou</span>
                            <span class="vf-pdp__kit-cash-value" data-total>{{ t_price | money }}</span>
                            <span class="vf-pdp__kit-cash-label">à vista</span>
                            {%- if t_disc > 0 -%}
                              <s class="vf-pdp__kit-compare" data-compare>{{ t_total | money }}</s>
                            {%- endif -%}
                          </div>

                          {%- if t_disc > 0 -%}
                            <span class="vf-pdp__kit-discount">{{ t_disc }}% OFF · você economiza <span data-save>{{ t_disc_amt | money }}</span></span>
                          {%- endif -%}
                        </div>
                      </div>

                      {%- if section.settings[msg_key] != blank -%}
                        <div class="vf-pdp__kit-message">{{ section.settings[msg_key] }}</div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

          {%- comment -%} FAIXA CUPOM 5OFF (discreta, elegante) {%- endcomment -%}
          <div class="vf-pdp__cupom-badge">
            <span class="vf-pdp__cupom-badge-icon">🎟️</span>
            <span class="vf-pdp__cupom-badge-text">
              Use o cupom <strong>5OFF</strong> no checkout e ganhe <strong>5% de desconto</strong>
            </span>
          </div>

          <button type="submit" class="vf-pdp__cta vf-pdp__cta--primary{% if pdp_frete_promo %} vf-pdp__cta--promo{% endif %}" {% if product.available == false %}disabled{% endif %}>
            {% if product.available == false %}Esgotado{% elsif pdp_frete_promo %}🚚 Garantir com frete grátis{% else %}Adicionar ao carrinho{% endif %}
            <span aria-hidden="true">&rarr;</span>
          </button>

          <button type="submit" name="checkout" class="vf-pdp__cta vf-pdp__cta--secondary{% if pdp_frete_promo %} vf-pdp__cta--promo-outline{% endif %}" {% if product.available == false %}disabled{% endif %}>
            {% if pdp_frete_promo %}🚚 Comprar com frete grátis{% else %}Comprar agora{% endif %}
          </button>
        </form>

        {%- comment -%}
          CHAMADA DE FRETE GRÁTIS (promo 30-31/07) — logo acima dos depoimentos.
        {%- endcomment -%}
        {%- if pdp_frete_promo -%}
          <div class="vf-pdp__frete-promo">
            <span class="vf-pdp__frete-promo-icon" aria-hidden="true">🚚</span>
            <div class="vf-pdp__frete-promo-copy">
              <strong>FRETE GRÁTIS SEM MÍNIMO</strong>
              <span>Só hoje e amanhã, pra todo o Brasil. Acaba em <strong class="vf-ann-countdown" data-countdown="2026-08-01T00:00:00-03:00">--:--:--</strong></span>
            </div>
          </div>
        {%- endif -%}

        {%- comment -%}
          DEPOIMENTOS (carrossel de fotos) — estilo Botanika
          Carrossel horizontal com fotos de clientes, logo abaixo do CTA.
          Prioridade 1: blocos "Depoimento (foto)" cadastrados no editor.
          Prioridade 2: fallback com reposts reais de clientes (asset_url),
                        usado enquanto os blocos não tiverem foto.
        {%- endcomment -%}
        {%- assign has_depoimento = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'depoimento' and block.settings.photo != blank -%}
            {%- assign has_depoimento = true -%}
          {%- endif -%}
        {%- endfor -%}
        {%- assign fallback_reposts = 'vf-depoimento-01.jpg,vf-depoimento-02.jpg,vf-depoimento-03.jpg,vf-depoimento-04.jpg,vf-depoimento-05.jpg,vf-depoimento-06.jpg,vf-depoimento-07.jpg,vf-depoimento-08.jpg,vf-depoimento-09.jpg,vf-depoimento-10.jpg' | split: ',' -%}
        {%- if has_depoimento or fallback_reposts.size > 0 or request.design_mode -%}
          <div class="vf-pdp__dep">
            {%- if section.settings.depoimentos_heading != blank -%}
              <h3 class="vf-pdp__dep-title">{{ section.settings.depoimentos_heading }}</h3>
            {%- endif -%}
            {%- if section.settings.depoimentos_subheading != blank -%}
              <p class="vf-pdp__dep-sub">{{ section.settings.depoimentos_subheading }}</p>
            {%- endif -%}
            <div class="vf-pdp__dep-row">
              {%- if has_depoimento -%}
                {%- for block in section.blocks -%}
                  {%- if block.type == 'depoimento' -%}
                    {%- if block.settings.photo != blank -%}
                      <div class="vf-pdp__dep-card" {{ block.shopify_attributes }}>
                        <div class="vf-pdp__dep-media">
                          <img
                            src="{{ block.settings.photo | image_url: width: 640 }}"
                            alt="{{ block.settings.name | default: 'Depoimento VermeFree' | escape }}"
                            loading="lazy"
                            class="vf-pdp__dep-img"
                          >
                        </div>
                        {%- if block.settings.quote != blank or block.settings.name != blank -%}
                          <div class="vf-pdp__dep-info">
                            <span class="vf-pdp__dep-stars" aria-hidden="true">★★★★★</span>
                            {%- if block.settings.quote != blank -%}
                              <span class="vf-pdp__dep-quote">{{ block.settings.quote }}</span>
                            {%- endif -%}
                            {%- if block.settings.name != blank -%}
                              <span class="vf-pdp__dep-name">{{ block.settings.name }}</span>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                      </div>
                    {%- elsif request.design_mode -%}
                      <div class="vf-pdp__dep-card vf-pdp__dep-card--placeholder" {{ block.shopify_attributes }}>
                        <div class="vf-pdp__dep-media"><div class="vf-pdp__dep-ph"></div></div>
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                {%- comment -%} Fallback: reposts reais de clientes (screenshots de Stories) {%- endcomment -%}
                {%- for filename in fallback_reposts -%}
                  <div class="vf-pdp__dep-card vf-pdp__dep-card--repost">
                    <div class="vf-pdp__dep-media vf-pdp__dep-media--repost">
                      <img
                        src="{{ filename | asset_url }}"
                        alt="Cliente VermeFree compartilhando o protocolo"
                        loading="lazy"
                        class="vf-pdp__dep-img"
                      >
                    </div>
                  </div>
                {%- endfor -%}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} BADGES DE CONFIANÇA {%- endcomment -%}
        <ul class="vf-pdp__badges">
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19C5 10 11 5 20 5c0 9-6 14-15 14z"/></svg>
            <span>Vegetal 100%</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3 8-8 9-5-1-8-4-8-9V6z"/></svg>
            <span>Metais Free</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h18l-2 12H5L3 8z"/><path d="M8 8V5a4 4 0 0 1 8 0v3"/></svg>
            <span>Frete 5-9 dias</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <span>Compra segura</span>
          </li>
        </ul>

        {%- if pdp_frete_promo -%}
          <div class="vf-pdp__frete-mini">
            <span class="vf-pdp__frete-mini-icon" aria-hidden="true">🚚</span>
            <span class="vf-pdp__frete-mini-text"><strong>Frete grátis sem mínimo</strong> nesse pedido — válido só hoje e amanhã.</span>
          </div>
        {%- endif -%}

        {%- comment -%}
          STORIES (destaques em vídeo) — blocos do tipo "stories".
          Cada bloco é uma régua. O filtro por handle dentro do bloco
          decide em qual produto ela aparece, então o template padrão
          pode carregar uma régua genérica e uma por produto sem
          precisar de template novo.
        {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'stories' -%}
            {% render 'vf-stories-rail', block: block, product: product, mode: 'pdp' %}
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%} ACCORDIONS de info extra {%- endcomment -%}
        <div class="vf-pdp__accordions">
          {%- if section.settings.how_to_take != blank -%}
            <details class="vf-pdp__accordion">
              <summary>Como tomar<span class="vf-pdp__acc-icon" aria-hidden="true"></span></summary>
              <div class="vf-pdp__acc-content">{{ section.settings.how_to_take }}</div>
            </details>
          {%- endif -%}
          {%- if section.settings.composition != blank -%}
            <details class="vf-pdp__accordion">
              <summary>Composição completa<span class="vf-pdp__acc-icon" aria-hidden="true"></span></summary>
              <div class="vf-pdp__acc-content">{{ section.settings.composition }}</div>
            </details>
          {%- endif -%}
          {%- if section.settings.benefits != blank -%}
            <details class="vf-pdp__accordion">
              <summary>Benefícios do VermeFree<span class="vf-pdp__acc-icon" aria-hidden="true"></span></summary>
              <div class="vf-pdp__acc-content">{{ section.settings.benefits }}</div>
            </details>
          {%- endif -%}
        </div>

      </div>
    </div>

  </div>
</section>

{%- if section.settings.show_sticky_cta -%}
  {%- comment -%} STICKY CTA BAR — aparece após scroll {%- endcomment -%}
  <div class="vf-pdp-sticky" id="vf-pdp-sticky" data-trigger-px="800" aria-hidden="true">
    <div class="vf-pdp-sticky__inner">
      <div class="vf-pdp-sticky__product">
        {%- if product.featured_image -%}
          <img
            src="{{ product.featured_image | image_url: width: 120 }}"
            alt=""
            class="vf-pdp-sticky__thumb"
            width="60"
            height="60"
            loading="lazy">
        {%- endif -%}
        <div class="vf-pdp-sticky__info">
          <span class="vf-pdp-sticky__name">{{ product.title | default: section.settings.fallback_title | truncate: 38 }}</span>
          <span class="vf-pdp-sticky__price" id="vf-pdp-sticky-price">
            {%- if product != blank and product.selected_or_first_available_variant != blank -%}
              {%- assign sticky_price = product.selected_or_first_available_variant.price -%}
              {%- if installment_10x_cents > 0 -%}
                <strong>10x {{ installment_10x_cents | money }}</strong>
              {%- else -%}
                <strong>3x {{ sticky_price | divided_by: 3 | money }}</strong>
              {%- endif -%}
              <span>ou {{ sticky_price | money }} à vista</span>
            {%- else -%}
              <strong>10x R$ 40,93</strong>
              <span>ou R$ 347 à vista</span>
            {%- endif -%}
          </span>
        </div>
      </div>

      <div class="vf-pdp-sticky__actions">
        <div class="vf-pdp-sticky__qty">
          <button type="button" class="vf-pdp-sticky__qty-btn" data-action="minus" aria-label="Diminuir quantidade">−</button>
          <input
            type="number"
            id="vf-pdp-sticky-qty"
            value="1"
            min="1"
            class="vf-pdp-sticky__qty-input"
            aria-label="Quantidade">
          <button type="button" class="vf-pdp-sticky__qty-btn" data-action="plus" aria-label="Aumentar quantidade">+</button>
        </div>
        <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="vf-pdp-sticky__form">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" id="vf-pdp-sticky-qty-hidden" value="1">
          <button
            type="submit"
            class="vf-pdp-sticky__cta{% if pdp_frete_promo %} vf-pdp-sticky__cta--promo{% endif %}"
            {% if product.available == false %}disabled{% endif %}>
            {% if product.available == false %}Esgotado{% elsif pdp_frete_promo %}🚚 Garantir frete grátis{% else %}Adicionar ao carrinho{% endif %}
            <span aria-hidden="true">&rarr;</span>
          </button>
        </form>
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .vf-pdp {
    background: #FFFFFF;
    padding: 32px 0 64px;
    font-family: 'Inter', system-ui, sans-serif;
  }
  .vf-pdp__container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .vf-pdp__gallery { display: flex; flex-direction: column; gap: 12px; }
  .vf-pdp__main-image {
    aspect-ratio: 1 / 1;
    background: #F5EDE0;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .vf-pdp__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vf-pdp__img--placeholder { color: #5EBC43; opacity: 0.4; padding: 60px; }
  .vf-pdp__img--placeholder svg { width: 100%; height: 100%; }

  .vf-pdp__thumbs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .vf-pdp__thumb {
    aspect-ratio: 1 / 1;
    border-radius: 10px;
    overflow: hidden;
    border: 2px solid transparent;
    background: #F5EDE0;
    cursor: pointer;
    padding: 0;
    transition: border-color 0.2s ease;
  }
  .vf-pdp__thumb:hover { border-color: #C0DE96; }
  .vf-pdp__thumb.is-active { border-color: var(--vf-green-dark, #1B5E20); }
  .vf-pdp__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vf-pdp__thumb--placeholder { background: #F5EDE0; }

  .vf-pdp__buy-inner { display: flex; flex-direction: column; gap: 16px; }

  .vf-pdp__vendor {
    font-size: 12px;
    color: #777;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin: 0;
    font-weight: 600;
  }

  .vf-pdp__title {
    font-family: 'Caprasimo', Georgia, serif;
    font-size: clamp(28px, 3.6vw, 40px);
    line-height: 1.15;
    margin: 0;
    color: var(--vf-green-dark, #1B5E20);
    letter-spacing: -0.01em;
    font-weight: 400;
  }
  .vf-pdp__age-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
    color: #1B5E20;
    background: #E8F3DA;
    padding: 5px 12px;
    border-radius: 999px;
    letter-spacing: 0.4px;
    margin-top: 4px;
  }
  .vf-pdp__age-badge svg { width: 14px; height: 14px; }
  .vf-pdp__protocol-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
    padding: 10px 16px;
    background: #E8F3DA;
    border: 1px solid rgba(27, 94, 32, 0.2);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    color: #1B5E20;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
    align-self: flex-start;
    max-width: 100%;
    flex-wrap: wrap;
    line-height: 1.3;
  }
  .vf-pdp__protocol-link:hover {
    background: #1B5E20;
    color: #fff;
    transform: translateY(-1px);
  }
  .vf-pdp__protocol-link svg { width: 16px; height: 16px; flex-shrink: 0; }
  .vf-pdp__protocol-link span { transition: transform 0.2s ease; }
  .vf-pdp__protocol-link:hover span { transform: translateX(3px); }

  .vf-pdp__rating { display: flex; align-items: center; gap: 8px; }
  .vf-pdp__stars { display: inline-flex; color: #FBBF24; }
  .vf-pdp__stars svg { width: 16px; height: 16px; }
  .vf-pdp__rating-text { font-size: 13px; color: #555; }
  .vf-pdp__rating-text strong { color: #1A1A1A; margin-right: 2px; }

  .vf-pdp__short {
    font-size: 16px;
    line-height: 1.55;
    color: #1A1A1A;
    margin: 0;
    font-weight: 500;
  }

  .vf-pdp__price-box {
    background: #F0FDF4;
    border: 1px solid #DCFCE7;
    border-radius: 14px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .vf-pdp__compare {
    font-size: 13px;
    color: #777;
    text-decoration: line-through;
  }
  .vf-pdp__installment {
    font-family: 'Caprasimo', Georgia, serif;
    font-size: clamp(22px, 2.8vw, 28px);
    color: var(--vf-green-dark, #1B5E20);
    line-height: 1.15;
    margin: 0;
    font-weight: 400;
    letter-spacing: -0.005em;
  }
  .vf-pdp__price-cash { font-size: 14px; color: #555; margin: 0; font-weight: 500; }

  /* Promo frete grátis — preço em vermelho, igual campanhas anteriores */
  .vf-pdp__price-box--promo {
    background: #FFF1F1;
    border-color: #FFD4D4;
    animation: vf-pdp-price-pulse 1.8s ease-in-out infinite;
  }
  .vf-pdp__price-box--promo .vf-pdp__installment { color: #E11D2E; }
  .vf-pdp__price-box--promo .vf-pdp__price-cash { color: #C11524; font-weight: 700; }
  @keyframes vf-pdp-price-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(225, 29, 46, 0.18); }
    50% { box-shadow: 0 0 0 6px rgba(225, 29, 46, 0); }
  }
  .vf-pdp__pix {
    font-size: 13px;
    color: #1A1A1A;
    margin: 6px 0 0;
    padding-top: 8px;
    border-top: 1px dashed #DCFCE7;
  }
  .vf-pdp__pix strong { color: var(--vf-green-dark, #1B5E20); }

  .vf-pdp__volume-badge {
    margin-top: 10px;
    padding: 10px 14px;
    background: linear-gradient(135deg, #FCD34D 0%, #FBBF24 100%);
    color: #1B5E20;
    border-radius: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.3;
    box-shadow: 0 4px 12px rgba(252, 211, 77, 0.25);
  }
  .vf-pdp__volume-badge[hidden] { display: none; }
  .vf-pdp__volume-badge-icon { font-size: 16px; flex-shrink: 0; }
  .vf-pdp__volume-badge-text { flex: 1; }

  .vf-pdp__components {
    border: 1px solid #EFEFEF;
    border-radius: 14px;
    padding: 16px 18px;
    background: #FAFAFA;
  }
  .vf-pdp__components-label {
    font-family: 'Caprasimo', Georgia, serif;
    font-size: 15px;
    color: var(--vf-green-dark, #1B5E20);
    margin: 0 0 12px;
    font-weight: 400;
  }
  .vf-pdp__components-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .vf-pdp__component {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14px;
    line-height: 1.4;
    color: #1A1A1A;
  }
  .vf-pdp__component-check {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--vf-green, #5EBC43);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }
  .vf-pdp__component-check svg { width: 12px; height: 12px; }
  .vf-pdp__component-text { display: flex; flex-direction: column; }
  .vf-pdp__component-text strong { font-weight: 600; }
  .vf-pdp__component-spec { font-size: 12px; color: #777; margin-top: 2px; }

  .vf-pdp__form { display: flex; flex-direction: column; gap: 12px; margin-top: 4px; }

  .vf-pdp__variants { display: flex; flex-direction: column; gap: 8px; }
  .vf-pdp__variant-label { font-size: 13px; font-weight: 600; color: #1A1A1A; }
  .vf-pdp__variant-options { display: flex; gap: 8px; flex-wrap: wrap; }
  .vf-pdp__pill {
    cursor: pointer;
    padding: 8px 16px;
    border: 1px solid #E8E8E8;
    border-radius: 999px;
    font-size: 13px;
    color: #1A1A1A;
    transition: all 0.2s ease;
  }
  .vf-pdp__pill input { position: absolute; opacity: 0; }
  .vf-pdp__pill:has(input:checked) {
    background: var(--vf-green-dark, #1B5E20);
    color: #fff;
    border-color: var(--vf-green-dark, #1B5E20);
  }

  /* ==================== SELETOR DE KITS (estilo Botanika) ==================== */
  .vf-pdp__kits { border: 0; padding: 0; margin: 4px 0 0; }

  .vf-pdp__kits-social {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 10px;
    font-size: 13px;
    color: #555;
  }
  .vf-pdp__kits-stars { color: #FBBF24; letter-spacing: 1px; font-size: 14px; line-height: 1; }
  .vf-pdp__kits-social-text { font-weight: 600; color: #1A1A1A; }

  .vf-pdp__kits-legend {
    font-size: 13px;
    font-weight: 600;
    color: #1A1A1A;
    margin: 0 0 10px;
    padding: 0;
  }
  .vf-pdp__kits-legend #vf-pdp-kits-legend-value { color: var(--vf-green-dark, #1B5E20); font-weight: 700; }

  .vf-pdp__kits-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .vf-pdp__kit-card {
    position: relative;
    background: #fff;
    border: 2px solid #E8E8E8;
    border-radius: 16px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .vf-pdp__kit-card:hover { border-color: #C0DE96; }
  .vf-pdp__kit-card.is-active {
    border-color: var(--vf-green, #5EBC43);
    box-shadow: 0 0 0 1px var(--vf-green, #5EBC43), 0 8px 20px rgba(94, 188, 67, 0.12);
  }

  .vf-pdp__kit-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .vf-pdp__kit-badge {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 6px;
    color: #fff;
    white-space: nowrap;
  }
  .vf-pdp__kit-badge--1 { background: var(--vf-green-dark, #1B5E20); }
  .vf-pdp__kit-badge--2 { background: #FBBF24; color: #1A1A1A; }

  .vf-pdp__kit-row {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .vf-pdp__kit-radio {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border: 2px solid #cacaca;
    border-radius: 50%;
    position: relative;
    transition: border-color 0.2s ease;
  }
  .vf-pdp__kit-radio::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: transparent;
    transition: background 0.2s ease;
  }
  .vf-pdp__kit-card.is-active .vf-pdp__kit-radio { border-color: var(--vf-green, #5EBC43); }
  .vf-pdp__kit-card.is-active .vf-pdp__kit-radio::after { background: var(--vf-green, #5EBC43); }

  .vf-pdp__kit-image {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 10px;
    background: #F5EDE0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .vf-pdp__kit-image img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .vf-pdp__kit-image-ph { width: 70%; height: 70%; border-radius: 8px; background: linear-gradient(135deg, #C0DE96, #5ebc43); }

  .vf-pdp__kit-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

