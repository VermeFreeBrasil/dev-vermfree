{%- comment -%}
  vf-judgeme-reviews.liquid — Avaliações reais de clientes (Judge.me).
  Posição no PDP: depois de "Historias reais", antes do FAQ.
  Âncora de rolagem: #avaliacoes (estrelas do topo e barra sticky levam pra cá).

  Topo próprio da VermeFree: nota média, estrelas, distribuição 5★→1★
  e botão "Escreva uma avaliação", com dados do metafield
  judgeme.review_widget_data. Abaixo, a lista do widget oficial do
  Judge.me (paginação, formulário, fotos) com o cabeçalho padrão dele
  escondido e o visual ajustado à marca.
  Depende do app embed judgeme_core estar ativo no tema.
{%- endcomment -%}

{%- liquid
  assign jdgm_data = product.metafields.judgeme.review_widget_data.value
  assign jdgm_count = 0
  assign jdgm_avg = 0
  if jdgm_data.number_of_reviews
    assign jdgm_count = jdgm_data.number_of_reviews | times: 1
    assign jdgm_avg = jdgm_data.average_rating | times: 1.0
  endif
  assign jdgm_avg_x10 = jdgm_avg | times: 10 | round
  assign jdgm_avg_int = jdgm_avg_x10 | divided_by: 10 | floor
  assign jdgm_avg_dec = jdgm_avg_x10 | modulo: 10
  assign jdgm_avg_display = jdgm_avg_int | append: ',' | append: jdgm_avg_dec
  if jdgm_count == 1
    assign jdgm_word = 'avaliação'
  else
    assign jdgm_word = 'avaliações'
  endif

  assign render_block = true
  if section.settings.hide_until_reviews and jdgm_count == 0
    assign render_block = false
  endif
-%}

{%- if render_block -%}
  <div
    class="vf-jdgm{% if section.settings.hide_jdgm_header %} vf-jdgm--custom-header{% endif %}"
    id="avaliacoes"
    data-vf-jdgm
  >
    <div class="vf-jdgm__inner">
      <div class="vf-jdgm__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="vf-jdgm__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="vf-jdgm__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="vf-jdgm__sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>

      <div class="vf-jdgm__summary">
        {%- if jdgm_count > 0 -%}
          <div class="vf-jdgm__score">
            <span class="visually-hidden">Nota média {{ jdgm_avg_display }} de 5, com base em {{ jdgm_count }} {{ jdgm_word }}.</span>
            <span class="vf-jdgm__score-num" aria-hidden="true">{{ jdgm_avg_display }}</span>
            {%- render 'vf-stars', rating: jdgm_avg, size: 20 -%}
            <span class="vf-jdgm__score-count" aria-hidden="true">{{ jdgm_count }} {{ jdgm_word }}</span>
          </div>

          {%- if jdgm_data.histogram.size > 0 -%}
            <ul class="vf-jdgm__hist" aria-label="Distribuição das notas">
              {%- for row in jdgm_data.histogram -%}
                <li class="vf-jdgm__hist-row">
                  <span class="visually-hidden">{{ row.rating }} estrelas: {{ row.frequency }}</span>
                  <span class="vf-jdgm__hist-label" aria-hidden="true">
                    {{- row.rating -}}
                    <svg viewBox="0 0 24 24" fill="currentColor" focusable="false"><path d="M12 2l3 7 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1z"/></svg>
                  </span>
                  <span class="vf-jdgm__hist-bar" aria-hidden="true">
                    <span style="width: {{ row.percentage }}%;"></span>
                  </span>
                  <span class="vf-jdgm__hist-count" aria-hidden="true">{{ row.frequency }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        {%- else -%}
          <div class="vf-jdgm__empty">
            {%- render 'vf-stars', rating: 0, size: 22 -%}
            <p>Ainda não há avaliações por aqui.</p>
          </div>
        {%- endif -%}

        {%- if section.settings.write_label != blank -%}
          <div class="vf-jdgm__cta">
            <p class="vf-jdgm__cta-title">Já fez o protocolo?</p>
            <p class="vf-jdgm__cta-text">Conta pra gente como foi. Sua avaliação ajuda outras famílias a decidir.</p>
            <button type="button" class="vf-jdgm__write" data-vf-jdgm-write>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
              {{ section.settings.write_label | escape }}
            </button>
          </div>
        {%- endif -%}
      </div>

      {%- if jdgm_count > 0 -%}
        <p class="vf-jdgm__note">Mostrando as avaliações mais recentes · {{ jdgm_count }} no total</p>
      {%- endif -%}

      {%- comment -%}
        Dados estruturados (estrelas no Google). Antes vinham do bloco do app
        Judge.me; o tema não gera JSON-LD de produto em outro lugar.
      {%- endcomment -%}
      {%- if jdgm_count > 0 and product.metafields.judgeme.review_widget_json_ld != blank -%}
        <script type="application/ld+json">{{ product.metafields.judgeme.review_widget_json_ld.value | json }}</script>
      {%- endif -%}

      <div class="vf-jdgm__widget">
        <div
          id="judgeme_product_reviews"
          class="jdgm-widget jdgm-review-widget"
          data-product-title="{{ product.title | escape }}"
          data-id="{{ product.id }}"
        >
          {{ product.metafields.judgeme.widget }}
        </div>
      </div>
    </div>
  </div>

  <script>
    (function() {
      document.querySelectorAll('[data-vf-jdgm]').forEach(function(root) {
        var btn = root.querySelector('[data-vf-jdgm-write]');
        if (!btn || btn.dataset.vfBound) return;
        btn.dataset.vfBound = '1';
        btn.addEventListener('click', function() {
          var widget = root.querySelector('.vf-jdgm__widget');
          var link = root.querySelector('.jdgm-write-rev-link');
          if (link) link.click();
          setTimeout(function() {
            var form = root.querySelector('.jdgm-form-wrapper') || root.querySelector('.jdgm-form');
            var target = (form && form.offsetParent !== null) ? form : widget;
            if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }, 200);
        });
      });
    })();
  </script>

  <style>
    /* Escopo: #avaliacoes (id único da seção na página) */
    #avaliacoes.vf-jdgm {
      --vf-jdgm-gold: #F5B301;
      --vf-jdgm-line: #ECECE6;
      background: var(--vf-bg, #FAFAFA);
      padding: clamp(56px, 7vw, 88px) 16px;
      color: var(--vf-text, #1A1A1A);
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      --jdgm-primary-color: var(--vf-green, #5EBC43);
      --jdgm-star-color: var(--vf-jdgm-gold);
      --jdgm-paginate-color: var(--vf-green-dark, #1B5E20);
    }
    #avaliacoes .vf-jdgm__inner { max-width: 1040px; margin: 0 auto; }
    #avaliacoes .visually-hidden { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

    /* ---------- Título ---------- */
    #avaliacoes .vf-jdgm__head { text-align: center; max-width: 640px; margin: 0 auto 32px; }
    #avaliacoes .vf-jdgm__eyebrow {
      display: inline-block; margin: 0 0 12px; padding: 6px 14px; border-radius: 999px;
      background: #E7F6E1; color: var(--vf-green-dark, #1B5E20);
      font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    }
    #avaliacoes .vf-jdgm__heading {
      margin: 0 0 10px; font-family: 'Caprasimo', Georgia, serif; font-weight: 400;
      font-size: clamp(30px, 4vw, 44px); line-height: 1.12; letter-spacing: -.01em;
      color: var(--vf-green-dark, #1B5E20);
    }
    #avaliacoes .vf-jdgm__sub { margin: 0; font-size: 16px; line-height: 1.55; color: #5B5B5B; }

    /* ---------- Card de resumo ---------- */
    #avaliacoes .vf-jdgm__summary {
      display: grid; grid-template-columns: 1fr; gap: 24px; align-items: center;
      padding: 28px 22px; background: #FFFFFF; border: 1px solid var(--vf-jdgm-line);
      border-radius: 20px; box-shadow: 0 10px 30px rgba(27, 94, 32, .06);
      margin-bottom: 20px;
    }
    #avaliacoes .vf-jdgm__score { display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; }
    #avaliacoes .vf-jdgm__score-num {
      font-family: 'Caprasimo', Georgia, serif; font-size: 64px; line-height: .95; color: var(--vf-text, #1A1A1A);
    }
    #avaliacoes .vf-jdgm__score .vf-stars__fill { color: var(--vf-jdgm-gold); }
    #avaliacoes .vf-jdgm__score-count { font-size: 14px; font-weight: 500; color: #6B6B6B; }

    #avaliacoes .vf-jdgm__hist { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 9px; width: 100%; }
    #avaliacoes .vf-jdgm__hist-row {
      display: grid; grid-template-columns: 30px 1fr 24px; align-items: center; gap: 12px;
      font-size: 13px; font-weight: 600; color: var(--vf-text, #1A1A1A);
    }
    #avaliacoes .vf-jdgm__hist-label { display: inline-flex; align-items: center; gap: 4px; }
    #avaliacoes .vf-jdgm__hist-label svg { display: block; width: 13px; height: 13px; max-width: none; color: var(--vf-jdgm-gold); flex-shrink: 0; }
    #avaliacoes .vf-jdgm__hist-bar { position: relative; height: 10px; border-radius: 999px; background: #F1F1EC; overflow: hidden; }
    #avaliacoes .vf-jdgm__hist-bar > span {
      position: absolute; top: 0; left: 0; bottom: 0; border-radius: 999px;
      background: linear-gradient(90deg, #F5B301, #FBCB45);
    }
    #avaliacoes .vf-jdgm__hist-count { text-align: right; font-weight: 500; color: #8A8A8A; }

    #avaliacoes .vf-jdgm__empty { display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; color: #5B5B5B; }
    #avaliacoes .vf-jdgm__empty p { margin: 0; font-size: 15px; }

    #avaliacoes .vf-jdgm__cta {
      display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center;
      padding-top: 22px; border-top: 1px solid var(--vf-jdgm-line);
    }
    #avaliacoes .vf-jdgm__cta-title { margin: 0; font-family: 'Caprasimo', Georgia, serif; font-size: 20px; line-height: 1.2; color: var(--vf-text, #1A1A1A); }
    #avaliacoes .vf-jdgm__cta-text { margin: 0 0 8px; font-size: 14px; line-height: 1.5; color: #6B6B6B; max-width: 30ch; }
    #avaliacoes .vf-jdgm__write {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      width: 100%; min-height: 50px; padding: 0 22px; border: 0; border-radius: 999px;
      background: var(--vf-green, #5EBC43); color: #FFFFFF;
      font-family: 'Inter', system-ui, sans-serif; font-size: 15px; font-weight: 700; white-space: nowrap; cursor: pointer;
      box-shadow: 0 6px 18px rgba(94, 188, 67, .30); transition: background .2s ease, transform .2s ease;
    }
    #avaliacoes .vf-jdgm__write svg { display: block; width: 17px; height: 17px; flex-shrink: 0; }
    #avaliacoes .vf-jdgm__write:hover { background: var(--vf-green-dark, #1B5E20); transform: translateY(-1px); }

    #avaliacoes .vf-jdgm__note { margin: 8px 0 14px; font-size: 13px; font-weight: 500; color: #8A8A8A; }

    @media (min-width: 750px) {
      #avaliacoes .vf-jdgm__summary {
        grid-template-columns: 170px minmax(0, 1fr) 310px; gap: 0; padding: 32px 8px;
      }
      #avaliacoes .vf-jdgm__summary > * { padding: 0 32px; }
      #avaliacoes .vf-jdgm__summary > * + * { border-left: 1px solid var(--vf-jdgm-line); }
      #avaliacoes .vf-jdgm__summary:has(.vf-jdgm__empty) { grid-template-columns: minmax(0, 1fr) 310px; }
      #avaliacoes .vf-jdgm__cta { padding-top: 0; border-top: 0; }
      #avaliacoes .vf-jdgm__score-num { font-size: 72px; }
    }

    /* ---------- Lista do Judge.me (cards) ---------- */
    #avaliacoes.vf-jdgm--custom-header .jdgm-rev-widg__header > *:not(.jdgm-form-wrapper) { display: none !important; }
    #avaliacoes.vf-jdgm--custom-header .jdgm-rev-widg__header { margin: 0 !important; padding: 0 !important; border: 0 !important; min-height: 0 !important; }
    #avaliacoes .jdgm-rev-widg { padding: 0 !important; margin: 0 !important; border: 0 !important; background: transparent !important; }
    #avaliacoes .jdgm-rev-widg__body { border: 0 !important; margin: 0 !important; padding: 0 !important; }
    #avaliacoes .jdgm-rev-widg__sort-wrapper { display: flex; justify-content: flex-end; margin: 0 0 12px; border: 0 !important; }
    #avaliacoes .jdgm-rev-widg__reviews { display: grid; grid-template-columns: 1fr; gap: 14px; }
    #avaliacoes .jdgm-rev {
      position: relative; margin: 0 !important; padding: 22px 22px 20px !important;
      background: #FFFFFF; border: 1px solid var(--vf-jdgm-line) !important; border-radius: 18px;
      box-shadow: 0 2px 10px rgba(0, 0, 0, .03);
    }
    #avaliacoes .jdgm-rev:first-child { border-top: 1px solid var(--vf-jdgm-line) !important; }
    #avaliacoes .jdgm-star, #avaliacoes .jdgm-star:before { color: var(--vf-jdgm-gold) !important; }
    #avaliacoes .jdgm-rev__rating { font-size: 15px; }
    #avaliacoes .jdgm-rev__icon {
      width: 40px !important; height: 40px !important; line-height: 40px !important;
      border-radius: 50% !important; background: #E7F6E1 !important; color: var(--vf-green-dark, #1B5E20) !important;
      font-weight: 700; font-size: 16px; text-align: center; overflow: visible;
    }
    #avaliacoes .jdgm-rev__icon:after { border-radius: 50%; }
    #avaliacoes .jdgm-rev__author, #avaliacoes .jdgm-rev__body, #avaliacoes .jdgm-rev__title, #avaliacoes .jdgm-rev__timestamp {
      font-family: 'Inter', system-ui, sans-serif !important;
    }
    #avaliacoes .jdgm-rev__author { font-size: 15px; font-weight: 700; color: var(--vf-text, #1A1A1A); }
    #avaliacoes .jdgm-rev__timestamp { font-size: 12.5px; color: #8A8A8A; }
    #avaliacoes .jdgm-rev__buyer-badge {
      display: inline-flex !important; align-items: center; margin-left: 6px;
      padding: 3px 10px !important; border: 0 !important; border-radius: 999px !important;
      background: #E7F6E1 !important; color: #1B5E20 !important;
      font-size: 11px !important; font-weight: 700 !important; line-height: 1.3 !important; vertical-align: middle;
    }
    #avaliacoes .jdgm-rev__content { margin-top: 12px; }
    #avaliacoes .jdgm-rev__title { font-size: 15px; font-weight: 700; margin-bottom: 4px; }
    #avaliacoes .jdgm-rev__body { font-size: 15px; line-height: 1.6; color: #333333; }
    #avaliacoes .jdgm-rev__body p { margin: 0; }
    #avaliacoes .jdgm-rev__pic-img { border-radius: 12px; }
    #avaliacoes .jdgm-rev__actions { margin-top: 10px; }

    #avaliacoes .jdgm-paginate { display: flex; justify-content: center; align-items: center; gap: 6px; margin-top: 24px; }
    #avaliacoes .jdgm-paginate__page {
      display: inline-flex; align-items: center; justify-content: center; min-width: 38px; height: 38px; padding: 0 10px;
      border-radius: 999px; border: 1px solid var(--vf-jdgm-line); background: #FFFFFF;
      color: var(--vf-text, #1A1A1A) !important; font-weight: 600; text-decoration: none;
    }
    #avaliacoes .jdgm-paginate__page.jdgm-curt { background: var(--vf-green, #5EBC43); border-color: var(--vf-green, #5EBC43); color: #FFFFFF !important; }

    #avaliacoes .jdgm-form-wrapper {
      margin: 0 0 24px; padding: 24px; background: #FFFFFF;
      border: 1px solid var(--vf-jdgm-line); border-radius: 20px;
    }
    #avaliacoes .jdgm-submit-rev {
      background: var(--vf-green, #5EBC43) !important; color: #FFFFFF !important; border: 0 !important;
      border-radius: 999px !important; font-weight: 700 !important; padding: 12px 24px !important;
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "VF Avaliações Judge.me",
  "tag": "section",
  "class": "vf-jdgm-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Avaliações reais coletadas pelo Judge.me. Requer o app embed Judge.me ativo no tema. As estrelas do topo da página levam até aqui (#avaliacoes)."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (opcional)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Avaliações de quem já usa"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Avaliações reais e verificadas de clientes VermeFree."
    },
    {
      "type": "text",
      "id": "write_label",
      "label": "Texto do botão de avaliar",
      "default": "Escreva uma avaliação"
    },
    {
      "type": "checkbox",
      "id": "hide_jdgm_header",
      "label": "Esconder o cabeçalho padrão do Judge.me",
      "info": "Evita repetir nota e botão, já que o topo desta seção mostra os dois.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_until_reviews",
      "label": "Esconder a seção enquanto não houver avaliação publicada",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "VF Avaliações Judge.me"
    }
  ]
}
{% endschema %}
