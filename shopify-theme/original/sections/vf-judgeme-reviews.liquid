{%- comment -%}
  vf-judgeme-reviews.liquid — Avaliações reais de clientes (Judge.me).
  Posição no PDP: depois da ficha técnica, antes do FAQ.
  Âncora de rolagem: #avaliacoes
  Depende do app embed judgeme_core estar ativo no tema.
{%- endcomment -%}

{%- liquid
  assign jdgm_count = product.metafields.judgeme.reviews_count | times: 1
  assign render_block = true
  if section.settings.hide_until_reviews and jdgm_count == 0
    assign render_block = false
  endif
-%}

{%- if render_block -%}
  <section class="vf-jdgm" id="avaliacoes">
    <div class="vf-jdgm__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="vf-jdgm__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="vf-jdgm__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="vf-jdgm__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      <div
        id="judgeme_product_reviews"
        class="jdgm-widget jdgm-review-widget"
        data-product-title="{{ product.title | escape }}"
        data-id="{{ product.id }}"
      >
        {{ product.metafields.judgeme.widget }}
      </div>
    </div>
  </section>

  <style>
    #shopify-section-{{ section.id }} .vf-jdgm {
      background: var(--vf-bg, #FAFAFA);
      padding: var(--section-padding, 80px 16px);
      color: var(--vf-text, #1A1A1A);
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      --jdgm-primary-color: var(--vf-green, #5EBC43);
      --jdgm-secondary-color: rgba(94, 188, 67, .10);
      --jdgm-star-color: var(--vf-green, #5EBC43);
      --jdgm-write-review-bg-color: var(--vf-green-dark, #1B5E20);
      --jdgm-write-review-text-color: #FFFFFF;
      --jdgm-paginate-color: var(--vf-green-dark, #1B5E20);
      --jdgm-reviewer-name-color: var(--vf-text, #1A1A1A);
      --jdgm-border-radius: var(--card-radius, 16px);
    }
    #shopify-section-{{ section.id }} .vf-jdgm__inner {
      max-width: var(--container, 1280px);
      margin: 0 auto;
    }
    #shopify-section-{{ section.id }} .vf-jdgm__eyebrow {
      margin: 0 0 10px;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--vf-green-dark, #1B5E20);
    }
    #shopify-section-{{ section.id }} .vf-jdgm__heading {
      margin: 0 0 12px;
      font-family: 'Caprasimo', Georgia, serif;
      font-weight: 400;
      font-size: clamp(28px, 4vw, 40px);
      line-height: 1.15;
      color: var(--vf-text, #1A1A1A);
    }
    #shopify-section-{{ section.id }} .vf-jdgm__sub {
      margin: 0 0 32px;
      max-width: 62ch;
      font-size: 16px;
      line-height: 1.6;
      color: #5B5B5B;
    }
    #shopify-section-{{ section.id }} .jdgm-histogram__bar-content {
      background-color: var(--vf-green, #5EBC43) !important;
    }
    #shopify-section-{{ section.id }} .jdgm-rev__buyer-badge,
    #shopify-section-{{ section.id }} .jdgm-rev[data-verified-buyer='true'] .jdgm-rev__icon:after {
      background-color: var(--vf-green-dark, #1B5E20) !important;
      color: #FFFFFF !important;
    }
    #shopify-section-{{ section.id }} .jdgm-write-rev-link {
      background-color: var(--vf-green-dark, #1B5E20) !important;
      color: #FFFFFF !important;
      border: 0 !important;
      border-radius: var(--button-radius, 10px) !important;
      padding: 12px 22px !important;
      font-family: 'Inter', system-ui, sans-serif !important;
      font-weight: 600 !important;
    }
    #shopify-section-{{ section.id }} .jdgm-write-rev-link:hover {
      background-color: var(--vf-green, #5EBC43) !important;
    }
    #shopify-section-{{ section.id }} .jdgm-rev__body,
    #shopify-section-{{ section.id }} .jdgm-rev__title,
    #shopify-section-{{ section.id }} .jdgm-rev__author,
    #shopify-section-{{ section.id }} .jdgm-rev__timestamp {
      font-family: 'Inter', system-ui, sans-serif;
    }
    #shopify-section-{{ section.id }} .jdgm-rev,
    #shopify-section-{{ section.id }} .jdgm-rev__pic-img {
      border-radius: var(--card-radius, 16px);
    }
    @media (max-width: 749px) {
      #shopify-section-{{ section.id }} .vf-jdgm {
        padding: 48px 16px;
      }
      #shopify-section-{{ section.id }} .vf-jdgm__sub {
        margin-bottom: 24px;
      }
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "VF Avaliações Judge.me",
  "tag": "section",
  "class": "vf-jdgm-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Avaliações reais coletadas pelo Judge.me. Requer o app embed Judge.me ativo no tema."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "QUEM JÁ FEZ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "O que as clientes contaram depois dos 30 dias."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Avaliações de quem comprou e terminou o protocolo. Toda avaliação passa por aprovação antes de aparecer aqui."
    },
    {
      "type": "checkbox",
      "id": "hide_until_reviews",
      "label": "Esconder a seção enquanto não houver avaliação publicada",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "VF Avaliações Judge.me"
    }
  ]
}
{% endschema %}
